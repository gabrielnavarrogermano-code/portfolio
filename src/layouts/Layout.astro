---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | Análise de Dados`, description = site.description } = Astro.props;
// Prévia do link no LinkedIn, WhatsApp etc.: a imagem fica em public/og.png
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="pt-BR" class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, Análise de Dados & BI`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fontes servidas pelo próprio site (configuradas em astro.config.mjs). As da capa vêm com preload,
         para o nome e a frase já aparecerem na fonte certa. -->
    <Font cssVariable="--ff-tektur" preload />
    <Font cssVariable="--ff-serif" preload />
    <Font cssVariable="--ff-geist" preload />
    <Font cssVariable="--ff-geist-mono" />
    <title>{title}</title>
    <ClientRouter />
    <!-- Web Analytics da Vercel: conta visitas sem cookies; só funciona no site publicado, com o Analytics ativado no painel -->
    <Analytics />
  </head>
  <body class="min-h-screen font-sans text-fg antialiased">
    <slot />

    <script>
      import '../lib/smooth-scroll';
      import { initScrollEffects } from '../lib/reveal';
      import { iniciarFio } from '../lib/fio';

      document.addEventListener('astro:page-load', () => {
        initScrollEffects();
        iniciarFio(); // o fio que liga as seções e as abre conforme a rolagem

        // Desenha uma seção adiada por vez quando o navegador está ocioso, para não travar ao chegar nela rolando
        const later = [...document.querySelectorAll('.render-later')];
        const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
        const next = () => {
          later.shift()?.classList.remove('render-later');
          if (later.length) idle(next);
        };
        idle(next);
      });
    </script>
  </body>
</html>
