---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NotebookSheet from '../../components/NotebookSheet.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
const sections = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.ceil((p.body ?? '').split(/\s+/).length / 200));
---

<Layout title={`${p.data.title} | ${site.name}`} description={p.data.summary}>
  <div id="progress" class="fixed top-0 left-0 z-[60] h-0.5 w-full origin-left scale-x-0 bg-accent"></div>
  <Nav />

  <main class="relative overflow-hidden pt-36">

    <header class="mx-auto max-w-5xl px-6 xl:max-w-6xl">
      <a href="/#projetos" class="group inline-flex items-center gap-2 text-sm text-muted transition hover:text-heading">
        <span class="transition-transform group-hover:-translate-x-1">←</span> Voltar aos projetos
      </a>

      <p class="mt-8 text-sm text-accent">
        {p.data.kind} <span class="text-muted">· {minutes} min de leitura</span>
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-heading sm:text-5xl">
        {p.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{p.data.summary}</p>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="text-sm text-muted">{p.data.tools.join(' · ')}</span>
        {
          p.data.dashboard && (
            <a href={p.data.dashboard} target="_blank" rel="noopener" class="ml-2 text-sm text-link hover:underline">
              Ver dashboard ↗
            </a>
          )
        }
        {
          p.data.repo && (
            <a href={p.data.repo} target="_blank" rel="noopener" class="ml-2 text-sm text-link hover:underline">
              Código ↗
            </a>
          )
        }
      </div>
    </header>

    {
      p.data.demo === 'notebooks' && (
        <div class="mx-auto mt-12 max-w-5xl px-6 xl:max-w-6xl">
          <NotebookSheet />
        </div>
      )
    }

    <div class="mx-auto mt-14 grid max-w-5xl gap-12 border-t border-line px-6 pt-4 pb-24 lg:grid-cols-[200px_1fr] xl:max-w-6xl">
      <aside class="hidden lg:block">
        <nav class="sticky top-28 pt-10">
          <p class="text-sm text-muted">Neste estudo</p>
          <ul class="mt-4 space-y-2 border-l border-line">
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.slug}`} data-toc={s.slug} class="-ml-px block border-l border-transparent pl-4 text-sm text-muted transition hover:text-heading">
                    {s.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <article class="prose-case max-w-2xl lg:max-w-none">
        <Content />
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const bar = document.getElementById('progress');
    if (!bar) return;

    // Barra de progresso de leitura (no máximo uma atualização por quadro)
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', onScroll, { passive: true });
    // Com o ClientRouter a página não recarrega: sem isso, cada visita somaria mais um listener
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', onScroll), { once: true });
    update();

    // Destaca no índice a seção que está sendo lida
    const links = document.querySelectorAll<HTMLElement>('[data-toc]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => {
            const active = l.dataset.toc === entry.target.id;
            l.classList.toggle('text-heading', active);
            l.classList.toggle('border-accent', active);
          });
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    document.querySelectorAll('.prose-case h2[id]').forEach((h) => io.observe(h));
  });
</script>
