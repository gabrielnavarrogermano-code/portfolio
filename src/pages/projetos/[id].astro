---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NotebookSheet from '../../components/NotebookSheet.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
const sections = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.ceil((p.body ?? '').split(/\s+/).length / 200));
const num = String(p.data.order).padStart(2, '0');

// Ficha do cabeçalho: só entra o que o projeto tiver preenchido
const ficha = [
  { label: 'Ferramentas', value: p.data.tools.join(' · ') },
  p.data.context && { label: 'Onde', value: p.data.context },
  p.data.deliverable && { label: 'Entrega', value: p.data.deliverable },
].filter(Boolean) as { label: string; value: string }[];

// Fechamento: as mesmas linhas grandes do contato da home
const proximos = [
  { icon: '←', label: 'Voltar aos projetos', href: '/#projetos' },
  { icon: '→', label: 'Vamos conversar', href: '/#contato' },
];
---

<Layout title={`${p.data.title} | ${site.name}`} description={p.data.summary}>
  <Nav />

  <main class="relative overflow-hidden pt-32 sm:pt-36">
    <!-- Cabeçalho: rótulos em mono, título grande em Tektur estreita, resumo em serifa e a ficha do projeto -->
    <header class="mx-auto max-w-5xl px-6 xl:max-w-6xl">
      <a href="/#projetos" class="group inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.15em] text-muted uppercase transition hover:text-heading">
        <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        Voltar aos projetos
      </a>

      <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
        <span class="text-heading">( {num} )</span>
        <span>{p.data.kind}</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min de leitura</span>
      </p>
      <h1 class="pj-title mt-4 max-w-5xl font-display leading-[0.9] font-black text-balance text-heading uppercase">
        {p.data.title}
      </h1>
      <p class="mt-6 max-w-3xl font-serif text-2xl leading-snug text-balance text-fg/90 sm:text-[2rem]">{p.data.summary}</p>

      <dl class="mt-10 grid border-t border-line sm:grid-cols-3">
        {
          ficha.map((f) => (
            <div class="border-b border-line py-4 sm:border-r sm:border-b-0 sm:px-5 sm:first:pl-0 sm:last:border-r-0">
              <dt class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase">( {f.label} )</dt>
              <dd class="mt-2 text-heading">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        (p.data.dashboard || p.data.repo) && (
          <div class="mt-6 flex flex-wrap gap-5 font-mono text-[11px] tracking-[0.15em] uppercase">
            {p.data.dashboard && (
              <a href={p.data.dashboard} target="_blank" rel="noopener" class="text-link hover:text-heading">
                Ver dashboard ↗
              </a>
            )}
            {p.data.repo && (
              <a href={p.data.repo} target="_blank" rel="noopener" class="text-link hover:text-heading">
                Código ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      p.data.demo === 'notebooks' && (
        <div class="mx-auto mt-14 max-w-5xl px-6 xl:max-w-6xl">
          <p class="mb-4 flex items-center gap-4 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
            ( Simulação interativa · dados fictícios ) <span class="h-px flex-1 bg-line" aria-hidden="true" />
          </p>
          <NotebookSheet />
        </div>
      )
    }

    <!-- Números em destaque: tirados do próprio texto do estudo -->
    {
      p.data.stats && (
        <div class="mx-auto mt-14 max-w-5xl px-6 xl:max-w-6xl">
          <dl class="grid grid-cols-2 border-t border-line md:grid-cols-4">
            {p.data.stats.map((s) => (
              <div class="flex flex-col-reverse justify-end border-b border-line py-6 pr-4 md:border-b-0">
                <dt class="mt-3 font-mono text-[11px] tracking-[0.15em] text-muted uppercase">{s.label}</dt>
                <dd data-count class="pj-stat font-display tabular-nums leading-[0.85] font-black text-heading">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="mx-auto mt-10 grid max-w-5xl gap-12 border-t border-line px-6 pt-4 pb-24 lg:grid-cols-[220px_1fr] xl:max-w-6xl">
      <aside class="hidden lg:block">
        <nav class="sticky top-28 pt-10" aria-label="Neste estudo">
          <p class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase">( Neste estudo )</p>
          <ol class="mt-4 space-y-1 border-l border-line">
            {
              sections.map((s, i) => (
                <li>
                  <a
                    href={`#${s.slug}`}
                    data-toc={s.slug}
                    class="toc-link -ml-px flex gap-3 border-l border-transparent py-1 pl-4 text-sm text-muted transition hover:text-heading"
                  >
                    <span class="toc-num font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
                    {s.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="prose-case max-w-2xl lg:max-w-none">
        <Content />
      </article>
    </div>

    <!-- Fechamento: o que fazer depois de ler -->
    <section class="mx-auto max-w-5xl px-6 pb-20 xl:max-w-6xl" aria-labelledby="pj-next">
      <p id="pj-next" class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">( Gostou do projeto? )</p>
      <ol class="mt-5 border-t border-line">
        {
          proximos.map((n) => (
            <li class="nx-row group relative flex items-center gap-4 border-b border-line py-6 sm:gap-8 sm:py-8">
              <a href={n.href} class="nx-link flex-1 font-display leading-none font-black text-heading uppercase transition-colors">
                {n.label}
              </a>
              <span class="nx-icon pointer-events-none grid size-12 flex-none place-items-center rounded-full border border-line text-lg text-heading transition" aria-hidden="true">
                {n.icon}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pj-title {
    font-size: clamp(2.75rem, 7.5vw, 6.5rem);
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  .pj-stat {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  /* Índice: a seção que está sendo lida fica lima (o script liga a classe is-current) */
  .toc-num {
    color: color-mix(in oklab, var(--color-muted) 70%, transparent);
    transition: color 0.3s ease;
  }

  .toc-link.is-current {
    border-color: var(--color-accent);
    color: var(--color-heading);
  }

  .toc-link.is-current .toc-num {
    color: var(--color-accent);
  }

  /* Fechamento: linhas grandes, a linha inteira é clicável e acende em azul */
  .nx-link {
    font-size: clamp(2rem, 6vw, 4.25rem);
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  .nx-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .nx-row {
    transition: background-color 0.3s ease;
  }

  .nx-row:hover,
  .nx-row:focus-within {
    background-color: rgb(255 255 255 / 0.025);
  }

  .nx-row:hover .nx-link,
  .nx-row:focus-within .nx-link {
    color: var(--color-link);
  }

  .nx-row:hover .nx-icon,
  .nx-row:focus-within .nx-icon {
    border-color: var(--color-heading);
    background-color: var(--color-heading);
    color: var(--color-ink);
  }

  .nx-link:focus-visible {
    outline: none;
  }

  .nx-row:has(.nx-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Destaca no índice a seção que está sendo lida
    const links = document.querySelectorAll<HTMLElement>('[data-toc]');
    if (!links.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.classList.toggle('is-current', l.dataset.toc === entry.target.id));
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    document.querySelectorAll('.prose-case h2[id]').forEach((h) => io.observe(h));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
