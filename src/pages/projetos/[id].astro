---
import { getCollection } from 'astro:content';
import EstudoDeCaso from '../../components/EstudoDeCaso.astro';

// Estudos de caso em português (/projetos/<id>/). A versão em inglês fica em pages/en/projects.
export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
---

<EstudoDeCaso p={p} />
