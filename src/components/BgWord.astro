---
// Palavra gigante no fundo de uma seção: Tektur só com o contorno, quase transparente, da largura da tela.
// Todas as palavras do site têm o mesmo enquadramento:
// - mesmo tamanho (calculado pela palavra mais longa, para todas caberem na tela);
// - o espaço acima do título é proporcional ao tamanho da palavra (um espaçador invisível, logo depois dela),
//   então o título sempre cai a 56% da altura da palavra, no computador e no celular;
// - `lead`: altura (px) do que vem antes do título dentro da seção (ex.: a etiqueta do projeto), descontada do
//   espaçador para o título ficar na mesma posição.
// Fica presa dentro da própria seção: começa no topo dela e, depois que a seção passa do topo da tela, anda mais
// devagar que o conteúdo (parallax). É cenário: escondida de leitores de tela e sem cliques.
// A seção que a usa precisa de `relative isolate` e não deve ter padding em cima (o espaçador cuida disso).
interface Props {
  word: string;
  lead?: number;
}

const { word, lead = 0 } = Astro.props;
---

<div class="bg-word pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 select-none" aria-hidden="true">
  <span data-bg-word class="block text-center font-display leading-[0.85] font-bold whitespace-nowrap">{word}</span>
</div>
<div class="bg-word-space" style={`--lead: ${lead}px`} aria-hidden="true"></div>

<style>
  /* Tamanho único: a palavra mais longa (PROJETOS, 8 letras) ocupa a largura da tela */
  .bg-word,
  .bg-word-space {
    --bw-size: min(16rem, 18.75vw);
    --bw-pad: 1.5rem;
  }

  @media (min-width: 40rem) {
    .bg-word,
    .bg-word-space {
      --bw-pad: 2rem;
    }
  }

  /* A caixa ocupa a seção inteira e corta o que sair dela: a palavra nunca invade outra seção */
  .bg-word {
    overflow: clip;
  }

  .bg-word span {
    padding-top: var(--bw-pad);
    font-size: var(--bw-size);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--bg-word-stroke, rgb(255 255 255 / 0.075));
    will-change: transform;
  }

  /* Espaço até o título: margem de cima + 56% da altura da palavra (0,56 × 0,85 da fonte) - o que vem antes */
  .bg-word-space {
    height: calc(var(--bw-pad) + 0.476 * var(--bw-size) - var(--lead));
  }
</style>

<script>
  // Quanto a palavra "atrasa" em relação ao conteúdo (0 = acompanha, 1 = parada na tela)
  const LAG = 0.3;
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const words = [...document.querySelectorAll<HTMLElement>('[data-bg-word]')];
    if (!words.length) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const el of words) {
        const top = el.parentElement!.getBoundingClientRect().top;
        if (top > vh || top < -vh * 2) continue; // longe da tela: não mexe
        // Só anda depois que o topo da seção passa do topo da tela; antes disso, fica parada no topo da seção
        el.style.transform = `translate3d(0, ${(Math.max(0, -top) * LAG).toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
    cleanup = () => window.removeEventListener('scroll', onScroll);
  });
</script>
