---
import { getCollection } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projetos" class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
  <SectionTitle
    title="Dados que viram decisão"
    subtitle="Estudos de caso curtos: o problema, como os dados foram tratados e o resultado."
  />

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {
      projetos.map((p, i) => (
        <div data-reveal style={`--delay: ${i * 100}ms`} class:list={[i === 0 && projetos.length % 2 === 1 && 'md:col-span-2']}>
          <a
            href={`/projetos/${p.id}/`}
            class="group flex h-full flex-col rounded-2xl border border-line bg-bg p-6 transition-colors hover:border-accent/40 sm:p-8"
          >
            <div class="flex justify-end gap-2 text-xs text-muted">
              <span class="rounded-full border border-line px-2 py-0.5">{p.data.kind}</span>
            </div>

            <h3 class="mt-8 text-xl font-semibold text-heading transition-colors group-hover:text-accent sm:text-2xl">
              {p.data.title}
            </h3>
            <p class="mt-2 max-w-xl leading-relaxed text-muted">{p.data.summary}</p>

            <p class="mt-6 text-sm text-muted">{p.data.tools.join(' · ')}</p>

            <span class="mt-auto inline-flex items-center gap-1 pt-8 text-sm font-medium text-accent">
              Ler estudo de caso
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        </div>
      ))
    }
  </div>
</section>
