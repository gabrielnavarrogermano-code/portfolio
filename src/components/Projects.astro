---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Secao from './Secao.astro';

// ( 02 ) Projetos: uma seção por projeto, no molde de todas.
// À esquerda, o resumo e o antes → depois (a linha do "depois" se desenha em vermelho); no painel, o print do
// dashboard (no hover, troca para a outra página dele) e a ficha: contexto, etapa e ferramentas.
// Os números do projeto ficam no estudo de caso, para não repetir aqui.
const projetos = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
---

<div id="projetos">
  {
    projetos.map((p, i) => (
      <Secao
        num={String(i + 2).padStart(2, '0')}
        rotulo="Projetos"
        rotuloDir={projetos.length > 1 ? `Na prática · ${i + 1} de ${projetos.length}` : 'Na prática'}
        titulo={p.data.title}
        tituloLongo={p.data.title.length > 24}
      >
        <Fragment slot="negocio">
          <p class="serif-grande">{p.data.summary}</p>
          {p.data.before && p.data.after && (
            <div class="pj-ba">
              <div>
                <small>Antes</small>
                <p>{p.data.before}</p>
              </div>
              <div class="pj-depois">
                <small>Depois</small>
                <p>{p.data.after}</p>
              </div>
            </div>
          )}
          <p class="mt-7">
            <a href={`/projetos/${p.id}/`} class="btn btn-cheio">
              Ler estudo de caso <span class="seta" aria-hidden="true">→</span>
            </a>
          </p>
        </Fragment>

        <a slot="dados" href={`/projetos/${p.id}/`} data-active class="pj-print group" aria-label={`Abrir o estudo de caso: ${p.data.title}`}>
          {p.data.cover && (
            <Image src={p.data.cover} alt="" widths={[640, 1024]} sizes="(min-width: 896px) 34rem, 100vw" format="webp" class="pj-img" />
          )}
          {p.data.coverHover && (
            <Image src={p.data.coverHover} alt="" widths={[640, 1024]} sizes="(min-width: 896px) 34rem, 100vw" format="webp" class="pj-img pj-img-hover" />
          )}
          {p.data.coverHover && <span class="pj-dica" aria-hidden="true">Passe o mouse: outra página do dashboard</span>}
        </a>

        <dl slot="dados" class="pj-ficha">
          {p.data.context && (
            <>
              <dt>Contexto</dt>
              <dd>{p.data.context}</dd>
            </>
          )}
          <dt>Etapa</dt>
          <dd>{p.data.kind}</dd>
          <dt>Ferramentas</dt>
          <dd>{p.data.tools.join(' · ')}</dd>
        </dl>
      </Secao>
    ))
  }
</div>

<style>
  /* Antes → depois: o "depois" ganha uma linha vermelha que se desenha quando os lados aparecem */
  .pj-ba {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .pj-ba > div {
    position: relative;
    padding-left: 1.1rem;
  }

  .pj-ba > div::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-line);
  }

  .pj-ba .pj-depois::before {
    background: var(--color-accent);
    transform-origin: top;
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.2, 1) 0.6s;
  }

  :global(html.fio-js .secao:not(.aberto-lados)) .pj-depois::before {
    transform: scaleY(0);
  }

  .pj-ba small {
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pj-ba .pj-depois small {
    color: var(--color-accent);
  }

  .pj-ba p {
    margin-top: 0.25rem;
    line-height: 1.5;
  }

  /* O print: o trabalho em si, em cores; no hover troca para a outra página do dashboard */
  .pj-print {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9.4;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .pj-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition:
      opacity 0.6s ease,
      transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .pj-img-hover {
    opacity: 0;
  }

  .pj-print:hover .pj-img,
  .pj-print.is-active .pj-img {
    transform: scale(1.03);
  }

  .pj-print:hover .pj-img-hover,
  .pj-print.is-active .pj-img-hover {
    opacity: 1;
  }

  .pj-dica {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
    background: rgb(20 25 55 / 0.85);
    color: var(--color-sunset);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .pj-print:hover .pj-dica {
    opacity: 0;
  }

  @media (hover: none) {
    .pj-dica {
      display: none;
    }
  }

  /* A ficha: rótulo em mono e o valor ao lado */
  .pj-ficha {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem 1.1rem;
    margin-top: 1.2rem;
    font-size: 0.875rem;
  }

  .pj-ficha dt {
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-img {
      transition-duration: 0.01ms;
    }
  }
</style>
