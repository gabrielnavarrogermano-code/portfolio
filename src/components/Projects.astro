---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Secao from './Secao.astro';
import { idiomaDe, caminho, textos } from '../i18n';

// Projetos: uma seção por projeto. O título e o resumo, o print largo (no hover troca para a outra página do
// dashboard) e, embaixo, o fio deita e vira a seta que vai do "antes" ao "depois"; o fio da seção termina nela.
// No fim, o contexto numa frase e o botão do estudo de caso. Os números ficam no estudo de caso.
const idioma = idiomaDe(Astro.url);
const tx = textos[idioma].projetos;
// Os projetos no idioma da página (o inglês fica em src/content/projetos-en)
const projetos = (await getCollection(idioma === 'en' ? 'projetosEn' : 'projetos')).sort((a, b) => a.data.order - b.data.order);
---

<div id="projetos">
  {
    projetos.map((p) => (
      <Secao titulo={p.data.title} sub={p.data.summary}>
        <a href={caminho(idioma, `projeto:${p.id}`)} data-active data-abre class="pj-prancha" aria-label={tx.abrir(p.data.title)}>
          {p.data.cover && (
            <Image src={p.data.cover} alt="" widths={[768, 1280, 1920]} sizes="(min-width: 72rem) 67rem, 100vw" format="webp" class="pj-img" />
          )}
          {p.data.coverHover && (
            <Image src={p.data.coverHover} alt="" widths={[768, 1280, 1920]} sizes="(min-width: 72rem) 67rem, 100vw" format="webp" class="pj-img pj-img-hover" />
          )}
          {p.data.coverHover && <span class="pj-dica" aria-hidden="true">{tx.dica}</span>}
        </a>

        {p.data.before && p.data.after && (
          <div class="pj-seta" data-abre data-fio-fim>
            <div class="pj-antes">
              <h3>{tx.antes}</h3>
              <p>{p.data.before}</p>
            </div>
            <div class="pj-depois">
              <h3>{tx.depois}</h3>
              <p>{p.data.after}</p>
            </div>
          </div>
        )}

        <div class="pj-rodape">
          <p>{tx.ficha(p.data.context, p.data.kind, p.data.tools)}</p>
          <a href={caminho(idioma, `projeto:${p.id}`)} class="btn btn-cheio">{tx.ler}</a>
        </div>
      </Secao>
    ))
  }
</div>

<style>
  /* O print: o trabalho em si, em cores, na largura toda; aparece crescendo um pouco */
  .pj-prancha {
    position: relative;
    z-index: 2;
    display: block;
    aspect-ratio: 16 / 9;
    margin-top: 3.2rem;
    overflow: hidden;
    border: 1.5px solid var(--color-line);
    border-radius: 0.9rem;
    background: #fff;
  }

  :global(html.fio-js) .pj-prancha:not(:global(.aberto)) {
    transform: scale(0.96);
  }

  .pj-prancha {
    transition:
      opacity 0.8s ease,
      transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .pj-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: opacity 0.6s ease;
  }

  .pj-img-hover {
    opacity: 0;
  }

  .pj-prancha:hover .pj-img-hover,
  .pj-prancha:global(.is-active) .pj-img-hover {
    opacity: 1;
  }

  .pj-dica {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    background: var(--color-navy);
    font-size: 0.875rem;
    color: var(--color-sunset);
    transition: opacity 0.3s ease;
  }

  .pj-prancha:hover .pj-dica {
    opacity: 0;
  }

  @media (hover: none) {
    .pj-dica {
      display: none;
    }
  }

  /* A seta: uma linha que se desenha da esquerda para a direita, com a ponta no fim, ligando antes → depois */
  .pj-seta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 3rem;
    padding-top: 2.2rem;
  }

  .pj-seta::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--color-fio);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.2, 1);
  }

  .pj-seta::after {
    content: '';
    position: absolute;
    top: -5px;
    right: -1px;
    width: 11px;
    height: 11px;
    border-top: 1.5px solid var(--color-fio);
    border-right: 1.5px solid var(--color-fio);
    transform: rotate(45deg);
    transition: opacity 0.3s ease 1s;
  }

  :global(html.fio-js) .pj-seta:not(:global(.aberto))::before {
    transform: scaleX(0);
  }

  :global(html.fio-js) .pj-seta:not(:global(.aberto))::after {
    opacity: 0;
  }

  /* A seta aparece com a linha, não subindo: tira o deslocamento padrão do [data-abre] */
  :global(html.fio-js) .pj-seta:not(:global(.aberto)) {
    opacity: 1;
    transform: none;
  }

  .pj-seta > div {
    transition: opacity 0.6s ease;
  }

  .pj-antes {
    transition-delay: 0.2s !important;
  }

  .pj-depois {
    text-align: right;
    transition-delay: 0.9s !important;
  }

  :global(html.fio-js) .pj-seta:not(:global(.aberto)) > div {
    opacity: 0;
  }

  .pj-seta h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .pj-depois h3 {
    color: var(--color-accent);
  }

  .pj-seta p {
    margin-top: 0.35rem;
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .pj-antes p {
    color: var(--color-muted);
  }

  /* O contexto numa frase e o botão */
  .pj-rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-line);
  }

  .pj-rodape p {
    max-width: 40rem;
    font-size: 1rem;
    color: var(--color-muted);
  }

  @media (max-width: 47.99rem) {
    .pj-prancha {
      margin-top: 2.2rem;
    }

    .pj-seta {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .pj-depois {
      text-align: left;
    }

    .pj-seta p {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-img {
      transition-duration: 0.01ms;
    }
  }
</style>
