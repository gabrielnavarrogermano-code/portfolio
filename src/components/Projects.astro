---
import { getCollection } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projetos" class="render-later mx-auto max-w-5xl px-6 py-16 [contain-intrinsic-size:auto_640px] sm:py-24">
  <SectionTitle
    title="Dados que viram decisão"
    subtitle="Na empresa onde estou, o volume de dados ainda é pequeno. Achei que era a hora certa de organizar as informações, antes que isso virasse um problema."
  />

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {
      projetos.map((p, i) => (
        <div class:list={['flex flex-col', i === 0 && projetos.length % 2 === 1 && 'md:col-span-2']}>
          <h3 class="text-xl font-semibold text-heading">O problema</h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-fg/85">{p.data.problem}</p>

          <!-- Recuo: o card é a resposta ao problema acima -->
          <div class="mt-5 ml-4 flex flex-1 sm:ml-8">
            <a
              href={`/projetos/${p.id}/`}
              class="group flex w-full max-w-3xl flex-col rounded-2xl border border-line bg-bg p-5 transition-colors hover:border-accent/40 sm:p-6"
            >
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <h4 class="text-lg font-semibold text-heading transition-colors group-hover:text-accent sm:text-xl">
                  {p.data.title}
                </h4>
                <span class="flex-none rounded-full border border-line px-2 py-0.5 text-xs text-muted">{p.data.kind}</span>
              </div>

              <p class="mt-2 leading-relaxed text-muted">{p.data.summary}</p>

              <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-4 text-sm">
                <p class="text-muted">{p.data.tools.join(' · ')}</p>
                <span class="inline-flex items-center gap-1 font-medium text-accent">
                  Ler estudo de caso
                  <span class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
