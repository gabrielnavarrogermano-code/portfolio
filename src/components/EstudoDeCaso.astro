---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import NotebookSheet from './NotebookSheet.astro';
import { site } from '../data/site';
import { idiomaDe, caminho, textos } from '../i18n';

// A página de um estudo de caso, nos dois idiomas (as páginas em pages/projetos e pages/en/projects só escolhem o
// projeto). A simulação do relatório continua em português nas duas: é o relatório como ele foi entregue.
interface Props {
  p: CollectionEntry<'projetos'> | CollectionEntry<'projetosEn'>;
}

const idioma = idiomaDe(Astro.url);
const tx = textos[idioma].caso;
const { p } = Astro.props;
const { Content, headings } = await render(p);
const sections = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.ceil((p.body ?? '').split(/\s+/).length / 200));

// Ficha do cabeçalho: só entra o que o projeto tiver preenchido
const ficha = [
  { label: tx.ferramentas, value: p.data.tools.join(', ') },
  p.data.context && { label: tx.onde, value: p.data.context },
  p.data.deliverable && { label: tx.entrega, value: p.data.deliverable },
].filter(Boolean) as { label: string; value: string }[];

// Fechamento: as mesmas linhas grandes do contato da home
const proximos = [
  { icon: '←', label: tx.voltar, href: caminho(idioma, '#projetos') },
  { icon: '→', label: tx.conversar, href: caminho(idioma, '#contato') },
];
---

<Layout title={`${p.data.title} | ${site.name}`} description={p.data.summary}>
  <Nav />

  <main class="relative overflow-hidden pt-32 sm:pt-36">
    <!-- Cabeçalho: rótulos em mono, título grande em Tektur estreita, resumo em serifa e a ficha do projeto -->
    <header class="mx-auto max-w-5xl px-6 xl:max-w-6xl">
      <a href={caminho(idioma, '#projetos')} class="group inline-flex items-center gap-2 text-[0.9375rem] text-muted transition hover:text-heading">
        <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        {tx.voltar}
      </a>

      <p class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.9375rem] text-muted">
        <span>{p.data.kind}</span>
        <span>{tx.leitura(minutes)}</span>
      </p>
      <h1 class="pj-title mt-4 max-w-5xl font-display font-extrabold text-balance text-heading">
        {p.data.title}
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-snug text-balance text-muted sm:text-2xl">{p.data.summary}</p>

      <dl class:list={['mt-10 grid border-t border-line', ficha.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
        {
          ficha.map((f) => (
            <div class="border-b border-line py-4 sm:border-r sm:border-b-0 sm:px-5 sm:first:pl-0 sm:last:border-r-0">
              <dt class="text-[0.9375rem] text-muted">{f.label}</dt>
              <dd class="mt-2 text-heading">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        (p.data.dashboard || p.data.repo) && (
          <div class="mt-6 flex flex-wrap gap-5 text-[0.9375rem] font-semibold">
            {p.data.dashboard && (
              <a href={p.data.dashboard} target="_blank" rel="noopener" class="text-link hover:text-heading">
                {tx.verDashboard}
              </a>
            )}
            {p.data.repo && (
              <a href={p.data.repo} target="_blank" rel="noopener" class="text-link hover:text-heading">
                {tx.codigo}
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      p.data.demo === 'notebooks' && (
        <div class="mx-auto mt-14 max-w-5xl px-6 xl:max-w-6xl">
          <p class="mb-4 flex items-center gap-4 text-[0.9375rem] text-muted">
            {tx.simulacao} <span class="h-px flex-1 bg-line" aria-hidden="true" />
          </p>
          {tx.avisoRelatorio && <p class="-mt-1 mb-4 text-sm text-muted">{tx.avisoRelatorio}</p>}
          <NotebookSheet />
        </div>
      )
    }

    <!-- Números em destaque: tirados do próprio texto do estudo -->
    {
      p.data.stats && (
        <div class="mx-auto mt-14 max-w-5xl px-6 xl:max-w-6xl">
          <dl class="grid grid-cols-2 border-t border-line md:grid-cols-4">
            {p.data.stats.map((s) => (
              <div class="flex flex-col-reverse justify-end border-b border-line py-6 pr-4 md:border-b-0">
                <dt class="mt-3 text-[0.9375rem] text-muted">{s.label}</dt>
                <dd data-count class="pj-stat font-display tabular-nums leading-[0.85] font-extrabold text-heading">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="mx-auto mt-10 grid max-w-5xl gap-12 border-t border-line px-6 pt-4 pb-24 lg:grid-cols-[220px_1fr] xl:max-w-6xl">
      <aside class="hidden lg:block">
        <nav class="sticky top-28 pt-10" aria-label={tx.nesteEstudo}>
          <p class="text-[0.9375rem] text-muted">{tx.nesteEstudo}</p>
          <ol class="mt-4 space-y-1 border-l border-line">
            {
              sections.map((s, i) => (
                <li>
                  <a
                    href={`#${s.slug}`}
                    data-toc={s.slug}
                    class="toc-link -ml-px flex gap-3 border-l border-transparent py-1 pl-4 text-sm text-muted transition hover:text-heading"
                  >
                    <span class="toc-num font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
                    {s.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <!-- min-w-0: sem ele, um bloco de código largo alarga a coluna da grade e empurra o texto para fora da tela -->
      <article class="prose-case min-w-0 max-w-2xl lg:max-w-none">
        <Content />
      </article>
    </div>

    <!-- Fechamento: o que fazer depois de ler -->
    <section class="mx-auto max-w-5xl px-6 pb-20 xl:max-w-6xl" aria-labelledby="pj-next">
      <p id="pj-next" class="text-[0.9375rem] text-muted">{tx.gostou}</p>
      <ol class="mt-5 border-t border-line">
        {
          proximos.map((n) => (
            <li class="nx-row group relative flex items-center gap-4 border-b border-line py-6 sm:gap-8 sm:py-8">
              <a href={n.href} class="nx-link flex-1 font-display leading-none font-extrabold text-heading transition-colors">
                {n.label}
              </a>
              <span class="nx-icon pointer-events-none grid size-12 flex-none place-items-center rounded-full border border-line text-lg text-heading transition" aria-hidden="true">
                {n.icon}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* line-height 1.2: a cedilha da Tektur é longa; o Ç e os acentos não encostam na linha vizinha */
  .pj-title {
    font-size: clamp(2.2rem, 5.2vw, 4.25rem);
    line-height: 1.2;
  }

  .pj-stat {
    font-size: clamp(3.5rem, 8vw, 6rem);
  }

  /* Índice: a seção que está sendo lida fica marcada (o script liga a classe is-current) */
  .toc-num {
    color: color-mix(in oklab, var(--color-muted) 70%, transparent);
    transition: color 0.3s ease;
  }

  .toc-link.is-current {
    border-color: var(--color-accent);
    color: var(--color-heading);
  }

  .toc-link.is-current .toc-num {
    color: var(--color-accent);
  }

  /* Fechamento: linhas grandes, a linha inteira é clicável e acende em azul */
  .nx-link {
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
  }

  .nx-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .nx-row {
    transition: background-color 0.3s ease;
  }

  .nx-row:hover,
  .nx-row:focus-within {
    background-color: rgb(255 255 255 / 0.025);
  }

  .nx-row:hover .nx-link,
  .nx-row:focus-within .nx-link {
    color: var(--color-link);
  }

  .nx-row:hover .nx-icon,
  .nx-row:focus-within .nx-icon {
    border-color: var(--color-heading);
    background-color: var(--color-heading);
    color: var(--color-ink);
  }

  .nx-link:focus-visible {
    outline: none;
  }

  .nx-row:has(.nx-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Destaca no índice a seção que está sendo lida
    const links = document.querySelectorAll<HTMLElement>('[data-toc]');
    if (!links.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.classList.toggle('is-current', l.dataset.toc === entry.target.id));
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    document.querySelectorAll('.prose-case h2[id]').forEach((h) => io.observe(h));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
