---
import SectionTitle from './SectionTitle.astro';

// Iceberg do BI: o dashboard é a ponta visível; as camadas de baixo sustentam tudo.
// top/bottom: largura (%) da camada no topo e na base, formando a silhueta.
const tip = {
  title: 'Dashboard',
  text: 'Dashboards interativos com KPIs e gráficos no Power BI. É a parte que todo mundo vê.',
  top: 26,
  bottom: 44,
};

const layers = [
  {
    title: 'Modelagem com SQL',
    text: 'Consultas SQL para organizar, relacionar e cruzar as informações.',
    top: 52,
    bottom: 72,
    fill: 'bg-heading/[0.16]',
  },
  {
    title: 'Limpeza e tratamento',
    text: 'Estruturação, limpeza e padronização: sem duplicados, nulos ou formatos misturados.',
    top: 76,
    bottom: 94,
    fill: 'bg-heading/[0.11]',
  },
  {
    title: 'Extração de dados',
    text: 'Coleta de dados onde eles estão: bancos, sistemas e planilhas.',
    top: 96,
    bottom: 74,
    fill: 'bg-heading/[0.07]',
  },
];

const trapezoid = (top: number, bottom: number) =>
  `clip-path: polygon(${50 - top / 2}% 0, ${50 + top / 2}% 0, ${50 + bottom / 2}% 100%, ${50 - bottom / 2}% 100%)`;

const goals = [
  {
    text: 'Construir soluções orientadas a dados',
    icon: 'M12 3 3 7.5 12 12l9-4.5L12 3ZM3 12l9 4.5 9-4.5M3 16.5 12 21l9-4.5',
  },
  { text: 'Otimizar processos e identificar tendências', icon: 'M3 17l6-6 4 4 8-8M15 7h6v6' },
  {
    text: 'Dar suporte estratégico e gerar valor para o negócio',
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 12h.01',
  },
];

const hint = 'Passe o mouse ou toque em uma camada para ver o que acontece nela.';
---

<section id="sobre" class="border-y border-line">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <SectionTitle title="Dados organizados, decisões melhores" />
        <p data-reveal style="--delay: 100ms" class="mt-6 text-lg leading-relaxed text-muted">
          Meu foco é a <span class="text-heading">base de todo BI</span>: dados bem extraídos, tratados e organizados.
        </p>

        <div data-reveal style="--delay: 200ms" class="mt-10">
          <p class="text-sm text-muted">Objetivo</p>
          <ul class="mt-4 space-y-4">
            {
              goals.map((g) => (
                <li class="flex items-center gap-4 text-fg/85">
                  <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full border border-line text-heading">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5" aria-hidden="true">
                      <path d={g.icon} stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {g.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal style="--delay: 150ms" data-iceberg>
        <button
          type="button"
          data-layer
          data-text={tip.text}
          class="block h-14 w-full cursor-pointer bg-heading text-sm font-semibold text-bg transition-opacity hover:opacity-90 data-active:opacity-90"
          style={trapezoid(tip.top, tip.bottom)}
        >
          {tip.title}
        </button>

        <div class="relative my-3 flex items-center gap-3 text-xs text-muted" aria-hidden="true">
          <span>↑ o que aparece</span>
          <span class="h-px flex-1 border-t border-dashed border-heading/40"></span>
          <span>↓ o que sustenta</span>
        </div>

        <div class="space-y-1.5 rounded-2xl bg-heading/[0.03] px-2 py-4">
          {
            layers.map((l) => (
              <button
                type="button"
                data-layer
                data-text={l.text}
                class:list={[
                  'block h-16 w-full cursor-pointer text-sm font-medium text-fg transition-colors hover:bg-heading/25 hover:text-heading data-active:bg-heading/25 data-active:text-heading',
                  l.fill,
                ]}
                style={trapezoid(l.top, l.bottom)}
              >
                {l.title}
              </button>
            ))
          }
        </div>

        <p
          id="iceberg-detail"
          aria-live="polite"
          class="mt-5 min-h-12 text-center text-sm leading-relaxed text-muted"
        >
          {hint}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Iceberg: ao passar o mouse, focar ou tocar numa camada, mostra o que acontece nela
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-iceberg]');
    const detail = document.getElementById('iceberg-detail');
    if (!root || !detail) return;
    const layers = [...root.querySelectorAll<HTMLButtonElement>('[data-layer]')];

    const show = (layer: HTMLButtonElement) => {
      layers.forEach((l) => l.toggleAttribute('data-active', l === layer));
      detail.textContent = layer.dataset.text ?? '';
      detail.classList.replace('text-muted', 'text-fg');
    };

    layers.forEach((layer) => {
      layer.addEventListener('pointerenter', () => show(layer));
      layer.addEventListener('focus', () => show(layer));
      layer.addEventListener('click', () => show(layer));
    });
  });
</script>
