---
import Letras from './Letras.astro';

// O molde de toda seção (estilos no global.css, "O molde das seções"): o título em Tektur centralizado no eixo do
// fio, a frase de apoio (opcional) e, no slot, a forma própria da seção. O fio da seção (lib/fio.ts) vai do topo
// dela até o elemento marcado com data-fio-fim (ou até o fim da seção, se não houver).
interface Props {
  id?: string;
  titulo: string;
  sub?: string;
}

const { id, titulo, sub } = Astro.props;
---

<section id={id} class="secao" data-secao>
  <span class="fio" data-fio aria-hidden="true"></span>
  <div class="secao-largura">
    <h2 class="secao-titulo"><Letras texto={titulo} /></h2>
    {sub && <p class="secao-sub">{sub}</p>}
    <slot />
  </div>
</section>
