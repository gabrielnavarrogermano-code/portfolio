---
// "Como eu trabalho": 4 princípios num baralho. Cada princípio é um cartão (título, frase e uma demonstração
// animada com dados do projeto de notebooks).
// Os cartões começam deitados uns sobre os outros em 3D (como uma pilha de roupas dobradas). Quando o baralho está
// bem visível, a pilha fica parada um instante, para a pessoa ver os cartões de lado, e então se levanta devagar até
// virar um baralho de frente: o 01 na frente e os outros levemente girados atrás.
// Na primeira vez, o baralho passa sozinho pelos 4 cartões e volta ao 01; qualquer clique ou toque interrompe.
// Clicar no cartão da frente (ou no botão "Próximo princípio") manda ele para o fundo e traz o próximo, que roda
// a sua demonstração. Depois do último cartão, o baralho se deita de volta na pilha e espera um novo clique. Sem JS ou com movimento reduzido, o baralho já aparece montado e as demonstrações no estado final.
// result: o resultado concreto de cada princípio no projeto (os mesmos números das demonstrações).
// tone: fundo do cartão, um grafite cada vez mais claro, do quase preto (01) ao cinza-chumbo (04); no baralho e na
// pilha deitada, as bordas formam uma escada de cinzas.
const principles = [
  {
    title: 'Começo pela pergunta, não pela planilha',
    text: 'É a decisão que o número vai apoiar que define quais dados entram na base.',
    result: '2 colunas novas na base',
    tone: 'linear-gradient(160deg, #0b0b0c 35%, #141416 100%)',
  },
  {
    title: 'Toda regra fica escrita',
    text: 'Duas pessoas olhando a mesma base precisam chegar no mesmo número.',
    result: '1 notebook, não 2',
    tone: 'linear-gradient(160deg, #0c0c0e 30%, #19191c 100%)',
  },
  {
    title: 'O dashboard mostra o que precisa de ação',
    text: 'Um total sozinho não diz se está bom ou ruim. Meta e status dizem.',
    result: '84,9% da meta, faltam 11',
    tone: 'linear-gradient(160deg, #0d0d0f 25%, #1f1f23 100%)',
  },
  {
    title: 'A IA acelera, eu decido',
    text: 'A IA cuida do repetitivo. A regra e o significado de cada número são comigo.',
    result: '3 setores padronizados, 1 regra definida por mim',
    tone: 'linear-gradient(160deg, #0e0e10 20%, #27272c 100%)',
  },
];

// Demonstração 1: colunas que a pergunta fez a base ganhar
const cols = [
  { name: 'Nome', isNew: false },
  { name: 'E-mail', isNew: false },
  { name: 'Nome PC', isNew: false },
  { name: 'LAPS', isNew: true },
  { name: 'Antivírus', isNew: true },
];

// Demonstração 2: as outras regras definidas no projeto
const otherRules = [
  'Windows Home conta como pendência de segurança',
  'Sem antivírus é crítico',
  'Toda conta sem notebook tem um motivo registrado',
];

// Demonstração 4: o que a IA padroniza e a regra que fica comigo
const fixes = [
  ['producao/cq', 'Produção/CQ'],
  ['eng. manutencao', 'Engenharia e Manutenção'],
  ['rh', 'RH'],
];
---

<div data-principles class="mx-auto mt-10 max-w-3xl">
  <div data-deck class="pr-deck grid pt-14">
  {
    principles.map((p, i) => (
      <article data-card={i} class="pr-card" style={`--k: ${i}`} aria-label={`Princípio ${i + 1} de ${principles.length}: ${p.title}`}>
        <div class="pr-card-inner on-black relative grid gap-6 rounded-3xl border border-white/10 p-6 sm:p-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10" style={`--card-bg: ${p.tone}`}>
          <!-- Número no canto: é a parte que aparece atrás no baralho, então mostra qual cartão vem a seguir -->
          <span class="pr-corner absolute top-3 right-4 font-mono text-[11px] text-heading/70" aria-hidden="true">0{i + 1}</span>
          <div class="flex flex-col">
            <p class="font-display text-5xl leading-none font-bold text-accent sm:text-6xl" aria-hidden="true">0{i + 1}</p>
            <h3 class="mt-6 text-2xl leading-tight font-bold text-heading sm:text-3xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-fg/80">{p.text}</p>
            <p class="mt-auto flex items-start gap-3 pt-6 font-display text-lg leading-snug font-bold text-heading">
              <span class="mt-1.5 h-4 w-1 flex-none rounded-full bg-accent" aria-hidden="true"></span>
              {p.result}
            </p>
          </div>

          <div class="pr-demo flex min-h-64 flex-col justify-center rounded-2xl border border-white/10 bg-black/40 p-4 sm:p-5" aria-hidden="true">
            {i === 0 && (
              <div>
                <p class="d-pop inline-block rounded-2xl rounded-bl-sm bg-heading px-4 py-2.5 text-sm font-medium text-bg">
                  Quais notebooks estão prontos para uso?
                </p>
                <p class="d-pop mt-5 text-xs text-muted" style="--d: 0.7s">Colunas da base de usuários</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {cols.map((c, ci) => (
                    <span
                      class:list={['d-pop rounded-md border px-2.5 py-1.5 text-xs', c.isNew ? 'd-new border-heading text-heading' : 'border-line text-fg/70']}
                      style={`--d: ${0.9 + ci * 0.25}s`}
                    >
                      {c.isNew && <span class="mr-1 text-good">+</span>}
                      {c.name}
                    </span>
                  ))}
                </div>
                <p class="d-pop mt-4 text-xs text-muted" style="--d: 2.6s">
                  <span class="text-good">+</span> LAPS e antivírus entraram na base por causa da pergunta
                </p>
              </div>
            )}

            {i === 1 && (
              <div>
                <div class="d-pop flex w-fit items-center gap-2 rounded-full border border-line px-3 py-1 text-xs text-fg/85">
                  <span class="text-muted">Regra</span> Notebook compartilhado conta uma vez só
                </div>
                <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-4">
                  <div class="space-y-1.5 font-mono text-xs">
                    <p class="flex justify-between gap-3 rounded-md border border-line px-3 py-2">
                      <span class="truncate text-fg/85">Ana Souza</span><span class="d-shared text-fg/85">NTB-007</span>
                    </p>
                    <p class="d-merge flex justify-between gap-3 rounded-md border border-line px-3 py-2">
                      <span class="truncate text-fg/85">Bruno Lima</span><span class="d-shared text-fg/85">NTB-007</span>
                    </p>
                  </div>
                  <div class="flex gap-8 sm:block sm:space-y-2 sm:text-right">
                    <div>
                      <p class="text-[11px] text-muted">Notebooks</p>
                      <p class="d-swap relative text-2xl font-semibold text-heading tabular-nums">
                        <span class="d-before">2</span><span class="d-after">1</span>
                      </p>
                    </div>
                    <div>
                      <p class="text-[11px] text-muted">Antivírus</p>
                      <p class="d-swap relative text-2xl font-semibold text-heading tabular-nums">
                        <span class="d-before">2</span><span class="d-after">1</span>
                      </p>
                    </div>
                  </div>
                </div>
                <ul class="mt-5 space-y-1 border-t border-line pt-3 text-xs text-muted">
                  {otherRules.map((r, ri) => (
                    <li class="d-pop flex gap-2" style={`--d: ${2.6 + ri * 0.3}s`}>
                      <span class="text-fg/50">–</span>
                      {r}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 2 && (
              <div class="mx-auto w-full max-w-sm">
                <div class="relative">
                  <p class="d-label text-xs text-muted">
                    <span class="d-before">Antes: só o total</span>
                    <span class="d-after">Depois: com meta e status</span>
                  </p>
                  <div class="d-kpi relative mt-2 overflow-hidden rounded-lg border border-line px-4 py-3.5">
                    <span class="d-stripe absolute inset-y-0 left-0 w-1 bg-crit" />
                    <div class="d-before">
                      <p class="text-xs text-muted">Notebooks com LAPS</p>
                      <p class="mt-2 text-3xl font-semibold text-heading tabular-nums">62</p>
                      <p class="mt-1 text-xs text-muted">Está bom ou ruim?</p>
                    </div>
                    <div class="d-after">
                      <div class="flex items-start justify-between gap-2">
                        <p class="text-xs text-muted">% LAPS · meta 100%</p>
                        <p class="text-[11px] font-medium"><span class="text-crit">✕</span> <span class="text-muted">Crítico</span></p>
                      </div>
                      <div class="mt-2 flex items-center gap-3">
                        <svg viewBox="0 0 36 36" class="size-14 flex-none -rotate-90">
                          <circle cx="18" cy="18" r="15" fill="none" stroke-width="4" class="stroke-white/10" />
                          <circle cx="18" cy="18" r="15" fill="none" stroke-width="4" stroke-linecap="round" pathLength="100" stroke-dasharray="84.9 100" class="d-ring stroke-crit" />
                        </svg>
                        <div>
                          <p class="text-3xl font-semibold text-heading tabular-nums">84,9%</p>
                          <p class="text-xs text-muted">faltam 11 notebooks</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {i === 3 && (
              <div class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-line p-3">
                  <p class="text-xs text-muted">IA · padroniza os textos</p>
                  <ul class="mt-2.5 space-y-1.5 font-mono text-xs">
                    {fixes.map(([raw, ok], fi) => (
                      <li class="d-fix relative h-6" style={`--d: ${0.6 + fi * 0.45}s`}>
                        <span class="d-before absolute inset-0 truncate rounded bg-crit/10 px-2 py-1 text-crit">{raw}</span>
                        <span class="d-after absolute inset-0 truncate rounded bg-good/10 px-2 py-1 text-good">{ok}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="d-pop flex flex-col rounded-lg border border-heading/40 p-3" style="--d: 2.2s">
                  <p class="text-xs text-muted">Eu · defino a regra</p>
                  <p class="mt-2.5 text-sm leading-snug text-heading">Notebook compartilhado conta uma vez só</p>
                  <p class="mt-auto pt-3 text-[11px] text-muted"><span class="text-good">✓</span> Decisão que a IA não toma</p>
                </div>
              </div>
            )}
          </div>
        </div>
      </article>
    ))
  }
  </div>

  <button
    type="button"
    data-open
    class="pr-open mx-auto mt-8 cursor-pointer items-center gap-2 rounded-full bg-heading px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-link-strong hover:text-white"
  >
    Clique na pilha para ver os princípios
  </button>

  <div class="pr-controls mt-8 flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-muted" aria-live="polite">
      <span data-count class="font-mono text-heading">1</span> de {principles.length}
      <span class="hidden sm:inline">· clique no cartão para ver o próximo</span>
    </p>
    <button
      type="button"
      data-next
      class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-heading px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-link-strong hover:text-white"
    >
      Próximo princípio
    </button>
  </div>
</div>

<style>
  /* ---------- Baralho ----------
     Todos os cartões ocupam a mesma célula do grid. --k é a posição no baralho (0 = na frente):
     quanto mais atrás, mais deslocado, girado e escuro. */
  .pr-deck {
    perspective: 1800px;
  }

  .pr-card {
    grid-area: 1 / 1;
    z-index: calc(10 - var(--k));
    transform-origin: 50% 100%;
    transform: translate(calc(var(--k) * 14px), calc(var(--k) * -11px)) rotate(calc(var(--k) * -1.6deg));
    filter: brightness(calc(1 - var(--k) * 0.2));
    transition:
      transform 1.1s cubic-bezier(0.45, 0, 0.25, 1),
      filter 1.1s ease,
      opacity 0.45s ease;
    transition-delay: var(--delay, 0s);
  }

  /* Pilha se levantando: mais lento, um cartão de cada vez (--delay vem do script) */
  .pr-deck.is-rising .pr-card {
    transition-duration: 1.6s, 1.2s, 0.45s;
  }

  .pr-card[data-front] {
    cursor: pointer;
  }

  .pr-corner {
    transition: opacity 0.4s ease;
  }

  .pr-card[data-front] .pr-corner {
    opacity: 0;
  }

  .pr-card-inner {
    height: 100%;
    background: var(--card-bg, #0e0f13);
    box-shadow: 0 28px 50px -24px rgb(0 0 0 / 0.55);
  }

  /* Começo: deitados uns sobre os outros em 3D, vistos de lado, como uma pilha de roupas dobradas (o 01 por cima) */
  .pr-deck.is-pile .pr-card {
    transform: translateY(calc(var(--k) * 26px - 200px)) rotateX(62deg) rotateZ(-24deg) scale(0.62);
    filter: brightness(calc(1 - var(--k) * 0.12));
  }

  /* Celular: cartões altos, então a pilha fica menor e menos girada para caber na tela */
  @media (max-width: 47.99rem) {
    .pr-deck.is-pile .pr-card {
      transform: translate(30px, calc(var(--k) * 20px - 260px)) rotateX(60deg) rotateZ(-14deg) scale(0.55);
    }
  }

  /* Descarte: o cartão da frente é jogado para o lado, girando, sem sumir; depois o script manda ele para o fundo
     e ele desliza de volta por baixo dos outros (a transição normal do .pr-card) */
  /* Vai longe o bastante para sair de cima do baralho: assim, quando passa para o fundo, nada some de repente */
  .pr-card.is-out {
    transform: translate(calc(100% + 40px), -24px) rotate(9deg);
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  /* Pilha deitada: aparece só o convite para abrir; contador e botão surgem depois que o baralho se monta */
  .pr-deck.is-pile .pr-card {
    cursor: pointer;
  }

  .pr-open {
    display: none;
  }

  .pr-deck.is-pile ~ .pr-open {
    display: flex;
  }

  .pr-deck.is-pile ~ .pr-controls {
    display: none;
  }

  .pr-controls {
    animation: pr-fade 0.6s ease 1.6s both;
  }

  @keyframes pr-fade {
    from {
      opacity: 0;
    }
  }

  /* ---------- Demonstrações ----------
     Sem a classe is-play, tudo fica no estado final (sem JS ou com movimento reduzido).
     Com is-play, cada peça roda a sua animação uma vez, com o atraso --d. */

  .d-before,
  .d-after {
    transition: none;
  }

  /* Peças que trocam: o "antes" some e o "depois" aparece no mesmo lugar (empilhados na mesma célula) */
  .d-swap,
  .d-label {
    display: grid;
  }

  .d-swap > span,
  .d-label > span {
    grid-area: 1 / 1;
  }

  .d-kpi .d-before {
    position: absolute;
    left: 0;
  }

  .d-kpi .d-before {
    inset: 0;
    padding: 0.875rem 1rem;
  }

  .d-before {
    opacity: 0;
  }

  /* Estado final da regra: a segunda linha some e o notebook compartilhado fica marcado */
  .d-merge {
    opacity: 0.35;
    text-decoration: line-through;
  }

  .d-shared {
    color: var(--color-heading);
    font-weight: 600;
  }

  .d-fix .d-before {
    opacity: 0;
  }

  .is-play .d-pop {
    animation: d-pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes d-pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .is-play .d-new {
    animation:
      d-pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      d-glow 1.2s ease 2.1s both;
    animation-delay: var(--d, 0s), 2.1s;
  }

  @keyframes d-glow {
    from {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.5);
    }
    to {
      box-shadow: 0 0 0 8px rgb(255 255 255 / 0);
    }
  }

  /* Regra: começa com duas linhas e conta 2; a regra aplica, a linha repetida some e o número cai para 1 */
  .is-play .d-merge {
    animation: d-merge 0.6s ease 1.6s both;
  }

  @keyframes d-merge {
    from {
      opacity: 1;
      text-decoration-color: transparent;
    }
  }

  .is-play .d-shared {
    animation: d-shared 0.4s ease 1s both;
  }

  @keyframes d-shared {
    from {
      color: color-mix(in oklab, var(--color-fg) 85%, transparent);
      font-weight: 400;
    }
  }

  .is-play .d-swap .d-before {
    animation: d-out 0.35s ease 1.9s both;
  }

  .is-play .d-swap .d-after {
    animation: d-in 0.35s ease 2.1s both;
  }

  /* KPI: o total vira % com meta, status e anel */
  .is-play .d-label .d-before,
  .is-play .d-kpi .d-before {
    animation: d-out 0.35s ease 1.8s both;
  }

  .is-play .d-label .d-after,
  .is-play .d-kpi .d-after {
    animation: d-in 0.4s ease 2s both;
  }

  .is-play .d-stripe {
    animation: d-in 0.4s ease 2s both;
  }

  .is-play .d-ring {
    animation: d-ring 1s cubic-bezier(0.2, 0.7, 0.2, 1) 2.2s both;
  }

  @keyframes d-ring {
    from {
      stroke-dasharray: 0 100;
    }
  }

  /* IA: o texto cru (vermelho) vira o padronizado (verde), um por vez */
  .is-play .d-fix .d-before {
    animation: d-fix-out 0.35s ease var(--d) both;
  }

  .is-play .d-fix .d-after {
    animation: d-in 0.35s ease calc(var(--d) + 0.2s) both;
  }

  @keyframes d-fix-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes d-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes d-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-card {
      transition: none;
    }
  }
</style>

<script>
  // Tempos da entrada e da passagem automática (ms)
  const PILE_HOLD_MS = 1200; // pilha parada de lado antes de se levantar
  const RISE_STAGGER_S = 0.18; // intervalo entre os cartões ao se levantarem
  const RISE_MS = 2300; // até o último cartão terminar de se levantar
  const OUT_MS = 600; // cartão sendo jogado para o lado antes de deslizar para o fundo
  const LAY_DOWN_WAIT_MS = 700; // depois do último cartão, espera o descarte assentar antes de deitar a pilha
  const AUTO_STEP_MS = 4800; // tempo em cada cartão na passagem automática (dá para ver a demonstração)
  // Interruptores (teste): a pilha só se levanta quando a pessoa clica nela, e sem passagem automática.
  // Para voltar ao comportamento anterior (levanta sozinha ao aparecer e passa pelos cartões), troque os dois.
  const START_ON_CLICK = true;
  const AUTO_PLAY = false;
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-principles]');
    const deck = root?.querySelector<HTMLElement>('[data-deck]');
    if (!root || !deck) return;

    const cards = [...deck.querySelectorAll<HTMLElement>('[data-card]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    // order[posição] = índice do cartão; posição 0 é a frente
    const order = cards.map((_, i) => i);

    // Reinicia a demonstração do cartão (tirar e pôr a classe faz as animações rodarem de novo)
    const play = (card: HTMLElement) => {
      if (reduced) return;
      card.classList.remove('is-play');
      void card.offsetWidth;
      card.classList.add('is-play');
    };

    const apply = () => {
      cards.forEach((card, i) => {
        const k = order.indexOf(i);
        card.style.setProperty('--k', String(k));
        card.toggleAttribute('data-front', k === 0);
        // Só o cartão da frente é lido por leitores de tela
        card.setAttribute('aria-hidden', String(k !== 0));
      });
      if (count) count.textContent = String(order[0] + 1);
      // No último cartão, o botão avisa que o próximo passo é guardar o baralho
      if (nextBtn) nextBtn.textContent = START_ON_CLICK && order[0] === cards.length - 1 ? 'Voltar à pilha' : 'Próximo princípio';
    };

    let busy = false;
    let started = false;
    let ready = false; // baralho já montado

    // Fim do baralho: depois do último cartão, os cartões se deitam de volta na pilha de lado (na ordem inversa
    // da subida: os de trás primeiro, o 01 por último) e a pilha volta a esperar um clique
    const layDown = () => {
      busy = true;
      ready = false;
      later(() => {
        cards.forEach((c, i) => c.style.setProperty('--delay', `${(cards.length - 1 - order.indexOf(i)) * RISE_STAGGER_S}s`));
        deck.classList.add('is-rising', 'is-pile');
        later(() => {
          cards.forEach((c) => c.style.removeProperty('--delay'));
          deck.classList.remove('is-rising');
          started = false;
          busy = false;
        }, RISE_MS);
      }, LAY_DOWN_WAIT_MS);
    };

    const next = () => {
      if (busy) return;
      busy = true;
      const wasLast = START_ON_CLICK && !reduced && order[0] === cards.length - 1;
      const front = cards[order[0]];
      front.classList.add('is-out');
      // A demonstração do próximo já começa enquanto o de cima é jogado, para ele não aparecer pronto e reiniciar
      if (!wasLast) play(cards[order[1]]);
      later(
        () => {
          order.push(order.shift()!);
          front.classList.remove('is-out');
          apply();
          busy = false;
          if (wasLast) layDown();
        },
        reduced ? 0 : OUT_MS,
      );
    };

    // Passagem automática: só na primeira vez, pausa fora da tela e para de vez em qualquer interação
    let auto = AUTO_PLAY && !reduced;
    let autoSteps = 0;
    let autoTimer = 0;
    let visible = false;
    const scheduleAuto = () => {
      clearTimeout(autoTimer);
      if (!auto || !visible || !ready) return;
      autoTimer = window.setTimeout(() => {
        next();
        autoSteps++;
        // Deu a volta e voltou ao 01: fim da passagem automática
        if (autoSteps >= cards.length) auto = false;
        scheduleAuto();
      }, AUTO_STEP_MS);
    };
    const stopAuto = () => {
      auto = false;
      clearTimeout(autoTimer);
    };

    cards.forEach((card) =>
      card.addEventListener('click', () => {
        if (deck.classList.contains('is-pile')) return rise(0);
        if (!card.hasAttribute('data-front')) return;
        stopAuto();
        next();
      }),
    );
    nextBtn?.addEventListener('click', () => {
      stopAuto();
      next();
    });
    deck.addEventListener('pointerdown', stopAuto, { passive: true });
    apply();

    // Entrada: começa deitado. Com START_ON_CLICK, só se levanta no clique; senão, sozinho quando está bem visível
    const below = deck.getBoundingClientRect().top > window.innerHeight * 0.6;
    if (!reduced && (START_ON_CLICK || below)) deck.classList.add('is-pile');

    const rise = (hold: number) => {
      if (started) return;
      started = true;
      if (!deck.classList.contains('is-pile')) {
        ready = true;
        play(cards[order[0]]);
        scheduleAuto();
        return;
      }
      later(() => {
        cards.forEach((c, i) => c.style.setProperty('--delay', `${order.indexOf(i) * RISE_STAGGER_S}s`));
        deck.classList.add('is-rising');
        deck.classList.remove('is-pile');
        later(() => {
          cards.forEach((c) => c.style.removeProperty('--delay'));
          deck.classList.remove('is-rising');
          ready = true;
          play(cards[order[0]]);
          scheduleAuto();
        }, RISE_MS);
      }, hold);
    };
    root.querySelector('[data-open]')?.addEventListener('click', () => rise(0));

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !started && !START_ON_CLICK) rise(PILE_HOLD_MS);
        else scheduleAuto();
      },
      { threshold: 0.6 },
    );
    io.observe(deck);

    cleanup = () => {
      io.disconnect();
      timers.forEach(clearTimeout);
      clearTimeout(autoTimer);
    };
  });
</script>
