---
// "Como eu trabalho": 4 princípios de negócio como etapas de um pipeline (Problema → Contexto → Linguagem → Prioridade).
// Em cima, a linha com os 4 nós; a linha enche até a etapa ativa, como dados passando pelo fluxo.
// Embaixo, o painel da etapa ativa: título, frase, onde já apliquei ("Na prática", quando há) e uma demonstração animada
// do raciocínio, feita com exemplos de negócio (marcados como exemplo). O projeto em si fica no card e no estudo de caso.
// - Na primeira vez que a seção aparece, o fluxo passa sozinho por 01 → 04 e volta ao 01 (para quando a pessoa interage).
// - Sem JS, todos os painéis aparecem um embaixo do outro. Com movimento reduzido, as demonstrações já aparecem no estado final.
const principles = [
  {
    short: 'Problema',
    title: 'Primeiro o problema, depois o dado',
    text: 'Um pedido de relatório quase sempre esconde uma decisão. Descobrir qual é define o que vale medir.',
    practice: 'A pergunta “quais notebooks estão prontos para uso?” trouxe LAPS e antivírus para a base.',
  },
  {
    short: 'Contexto',
    title: 'Número sozinho não decide nada',
    text: 'Um total só diz algo quando tem com o que ser comparado: o mês passado, a meta, o que é normal.',
    practice: 'O LAPS virou “84% da meta, faltam 12”, e não só “63 notebooks”.',
  },
  {
    short: 'Linguagem',
    title: 'Falo a língua de quem decide',
    text: 'Quem decide não precisa saber o que é churn. Precisa saber quantos clientes perdeu.',
    practice: 'A equipe consulta o dashboard sozinha, só filtrando.',
  },
  {
    short: 'Prioridade',
    title: 'Impacto e esforço definem a prioridade',
    text: 'Nem toda análise vale o tempo que leva. Começo pelo que mais ajuda a decisão com menos trabalho.',
  },
];

// Demonstração 1: o que medir, depois que a pergunta de negócio aparece
const measures = ['Último pedido', 'Frequência de compra', 'Ticket médio'];

// Demonstração 4: a matriz impacto × esforço. Linha de cima = alto impacto; coluna da esquerda = pouco esforço
const quadrants = [
  { task: 'Alerta de clientes inativos', tag: 'Faz primeiro', win: true },
  { task: 'Modelo de previsão de vendas', tag: 'Planeja' },
  { task: 'Trocar as cores do relatório', tag: 'Se sobrar tempo' },
  { task: 'Refazer todo o histórico', tag: 'Evita' },
];
---

<div data-principles class="mt-10 sm:mt-12">
  <!-- O pipeline: 4 nós ligados por uma linha que enche até a etapa ativa -->
  <div role="tablist" aria-label="Etapas" class="pp-flow relative grid grid-cols-4">
    <span class="pp-track" aria-hidden="true"><span class="pp-fill"></span></span>
    {
      principles.map((p, i) => (
        <button
          type="button"
          role="tab"
          data-tab
          id={`pp-tab-${i}`}
          aria-controls={`pp-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class:list={['pp-tab group relative flex cursor-pointer flex-col items-center text-center', i === 0 && 'is-active is-passed']}
        >
          <span class="pp-num h-4 font-mono text-[10px] leading-4 text-muted sm:text-[11px]">0{i + 1}</span>
          <span class="pp-node mt-2" aria-hidden="true"></span>
          <span class="pp-label mt-3 font-sans text-[13px] leading-tight font-semibold text-muted sm:text-base">{p.short}</span>
        </button>
      ))
    }
  </div>

  <!-- Painéis: com JS, empilhados no mesmo lugar (a altura não pula ao trocar) e só o ativo aparece -->
  <div class="pp-panels mt-8 border-t border-line pt-8 sm:mt-10 sm:pt-10">
    {
      principles.map((p, i) => (
        <div
          role="tabpanel"
          data-panel
          id={`pp-panel-${i}`}
          aria-labelledby={`pp-tab-${i}`}
          class:list={['pp-panel grid content-start gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10', i === 0 && 'is-active']}
        >
          <div class="flex flex-col">
            <!-- Título médio em Geist (o span vence a Tektur que o global.css dá a todo h3) -->
            <h3><span class="pp-title block font-sans leading-tight font-semibold text-heading">{p.title}</span></h3>
            <p class="mt-4 text-lg leading-relaxed text-fg/85">{p.text}</p>
            {p.practice && (
              <p class="mt-6 flex gap-3 md:mt-auto">
                <span class="mt-0.5 w-1 flex-none rounded-full bg-accent" aria-hidden="true"></span>
                <span>
                  <span class="block font-mono text-[11px] tracking-[0.15em] text-accent uppercase">Na prática</span>
                  <span class="mt-1 block leading-relaxed text-fg/80">{p.practice}</span>
                </span>
              </p>
            )}
          </div>

          <!-- Demonstração: bloco escuro, com as cores do resto do site -->
          <div class="pr-demo on-black rounded-2xl border border-white/10 bg-ink p-6 sm:p-7" aria-hidden="true">
            {i === 0 && (
              <div>
                <p class="d-tag">( O pedido · exemplo )</p>
                <p class="d-pop mt-3 font-serif text-2xl leading-[1.1] text-fg/50">
                  <span class="d-strike" style="--s: 0.9s">“Quero um dashboard de vendas.”</span>
                </p>
                <p class="d-pop d-tag mt-7 flex items-center gap-3" style="--d: 1.2s">
                  ( A pergunta de negócio ) <span class="h-px flex-1 bg-white/10" />
                </p>
                <p class="d-pop mt-3 font-serif text-[1.75rem] leading-[1.1] text-heading text-balance" style="--d: 1.4s">
                  Quais clientes estão <em class="text-accent">deixando de comprar</em>, e por quê?
                </p>
                <ul class="mt-6 flex flex-wrap gap-2 font-mono text-[11px]">
                  {measures.map((m, k) => (
                    <li class="d-pop rounded-full border border-white/15 px-2.5 py-1 text-fg/80" style={`--d: ${2.1 + k * 0.2}s`}>
                      {m}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 1 && (
              <div>
                <p class="d-tag">( Faturamento do mês · exemplo )</p>
                <p class="mt-3 font-display text-6xl leading-[0.85] font-black text-heading">
                  <span class="text-3xl">R$</span> 120 mil
                </p>
                <dl class="mt-6 border-t border-white/10 text-sm">
                  <div class="d-pop flex items-center justify-between gap-4 border-b border-white/10 py-3" style="--d: 0.6s">
                    <dt class="text-muted">vs. mês passado</dt>
                    <dd class="font-mono text-crit">▼ 8%</dd>
                  </div>
                  <div class="d-pop border-b border-white/10 py-3" style="--d: 1.1s">
                    <div class="flex items-center justify-between gap-4">
                      <dt class="text-muted">Meta do mês</dt>
                      <dd class="font-mono text-heading">92%</dd>
                    </div>
                    <dd class="relative mt-2.5 h-1.5 rounded-full bg-white/10">
                      <span class="d-fill absolute inset-y-0 left-0 w-[92%] rounded-full bg-warn" style="--d: 1.4s" />
                      <span class="absolute -top-1 right-0 h-3.5 w-px bg-heading" />
                    </dd>
                  </div>
                </dl>
                <p class="d-pop mt-4 text-sm" style="--d: 2.3s">
                  <span class="font-medium text-warn">▲ Atenção</span> <span class="text-muted">· faltam R$ 10 mil para a meta</span>
                </p>
              </div>
            )}

            {i === 2 && (
              <div>
                <p class="d-tag">( O relatório técnico · exemplo )</p>
                <p class="d-pop mt-3 font-mono text-lg text-fg/50">
                  <span class="d-strike" style="--s: 0.9s">churn_mensal = 0,042</span>
                </p>
                <p class="d-pop d-tag mt-7 flex items-center gap-3" style="--d: 1.2s">
                  ( Para quem decide ) <span class="h-px flex-1 bg-white/10" />
                </p>
                <p class="d-pop mt-3 font-serif text-[1.75rem] leading-[1.1] text-heading text-balance" style="--d: 1.4s">
                  <em class="text-accent">1 em cada 24</em> clientes saiu este mês.
                </p>
                <div class="mt-6 grid max-w-[17rem] grid-cols-12 gap-1.5">
                  {Array.from({ length: 24 }, (_, k) => (
                    <span
                      class:list={['d-pop aspect-square rounded-full', k === 23 ? 'd-hit bg-crit' : 'bg-white/15']}
                      style={`--d: ${1.9 + k * 0.025}s`}
                    />
                  ))}
                </div>
              </div>
            )}

            {i === 3 && (
              <div>
                <p class="d-tag">( Impacto × esforço · exemplo )</p>
                <p class="mt-4 font-mono text-[10px] tracking-[0.15em] text-muted uppercase">↑ Impacto</p>
                <div class="mt-2 grid grid-cols-2 border-b border-l border-white/25">
                  {quadrants.map((q, k) => (
                    <div
                      class:list={['d-pop m-1 rounded-lg border p-3', q.win ? 'd-win border-accent bg-accent/10' : 'border-white/10']}
                      style={`--d: ${0.4 + k * 0.3}s`}
                    >
                      <p class:list={['text-xs leading-snug sm:text-sm', q.win ? 'text-heading' : 'text-fg/70']}>{q.task}</p>
                      <p class:list={['mt-2 font-mono text-[10px] tracking-[0.1em] uppercase', q.win ? 'text-accent' : 'text-muted']}>{q.tag}</p>
                    </div>
                  ))}
                </div>
                <p class="mt-2 text-right font-mono text-[10px] tracking-[0.15em] text-muted uppercase">Esforço →</p>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* ---------- Pipeline ---------- */
  /* A linha vai do centro do primeiro nó ao centro do último (cada coluna tem 25%: 12,5% de cada lado).
     Altura do centro do nó: número (1rem) + espaço (0,5rem) + metade do nó (0,4375rem). */
  .pp-track {
    position: absolute;
    left: 12.5%;
    right: 12.5%;
    top: calc(1.5rem + 0.4375rem - 1px);
    height: 2px;
    background: var(--color-line);
  }

  /* --p: quanto da linha está cheia (0 a 1), ligado pelo script conforme a etapa ativa */
  .pp-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.2, 1);
  }

  .pp-node {
    position: relative;
    z-index: 1;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--color-line);
    border-radius: 9999px;
    background: var(--color-bg);
    transition:
      background-color 0.3s ease 0.2s,
      border-color 0.3s ease 0.2s,
      transform 0.3s ease;
  }

  /* Etapas por onde o fluxo já passou: o nó fica cheio */
  .pp-tab.is-passed .pp-node {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  /* A etapa ativa: o nó cresce e ganha um anel; o nome fica escuro */
  .pp-tab.is-active .pp-node {
    transform: scale(1.25);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-accent) 22%, transparent);
  }

  .pp-label,
  .pp-num {
    transition: color 0.3s ease;
  }

  .pp-tab.is-active .pp-label,
  .pp-tab:hover .pp-label {
    color: var(--color-heading);
  }

  .pp-tab.is-active .pp-num {
    color: var(--color-accent);
  }

  .pp-tab:focus-visible {
    outline-offset: 6px;
    border-radius: 0.5rem;
  }

  /* ---------- Painéis ---------- */
  .pp-title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    text-wrap: balance;
  }

  .pp-panels {
    display: grid;
    gap: 3rem;
  }

  [data-principles].is-js .pp-panels {
    gap: 0;
  }

  [data-principles].is-js .pp-panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s 0.35s;
  }

  [data-principles].is-js .pp-panel.is-active {
    visibility: visible;
    opacity: 1;
    transform: none;
    /* entra quando o anterior já quase sumiu, para os dois não se misturarem */
    transition:
      opacity 0.35s ease 0.25s,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s;
  }

  /* ---------- Demonstrações ----------
     Mesmo vocabulário do site: rótulos em mono, números em Tektur, frases em serifa, lima como destaque.
     Sem a classe is-play, tudo fica no estado final (sem JS ou com movimento reduzido).
     Com is-play, cada peça roda a sua animação uma vez, com o atraso --d. */
  .d-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pr-demo .font-display {
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  .is-play .d-pop {
    animation: d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes d-pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* 01 e 03: o pedido vago e o termo técnico são riscados depois de aparecer (atraso --s) */
  .d-strike {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .is-play .d-strike {
    animation: d-strike 0.5s ease var(--s, 0s) both;
  }

  @keyframes d-strike {
    from {
      color: color-mix(in oklab, var(--color-fg) 85%, transparent);
      text-decoration-color: transparent;
    }
  }

  /* 02: a barra da meta enche até o valor */
  .d-fill {
    transform-origin: left;
  }

  .is-play .d-fill {
    animation: d-fill 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes d-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* 03: o cliente que saiu acende em vermelho depois que a fileira aparece */
  .is-play .d-hit {
    animation:
      d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both,
      d-hit 0.6s ease 2.6s both;
  }

  @keyframes d-hit {
    from {
      background-color: rgb(255 255 255 / 0.15);
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
  }

  /* 04: o quadrante de mais impacto e menos esforço acende por último */
  .is-play .d-win {
    animation:
      d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both,
      d-win 0.6s ease 1.8s both;
  }

  @keyframes d-win {
    from {
      border-color: rgb(255 255 255 / 0.1);
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-fill,
    .pp-node {
      transition: none;
    }
  }
</style>

<script>
  // Pipeline: uma etapa ativa por vez. Clique, toque, teclado (setas, Home, End) ou mouse (computador) trocam a etapa.
  const HOVER_WAIT_MS = 120; // espera curta antes de trocar, para não piscar quando o mouse só atravessa o fluxo
  const AUTO_STEP_MS = 4000; // tempo em cada etapa na passagem automática (dá para ver a demonstração inteira)
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-principles]');
    if (!root) return;
    root.classList.add('is-js');

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const flow = root.querySelector<HTMLElement>('.pp-flow');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controller = new AbortController();
    const { signal } = controller;

    // Reinicia a demonstração (tirar e pôr a classe faz as animações rodarem de novo)
    const play = (el: HTMLElement) => {
      if (reduced) return;
      el.classList.remove('is-play');
      void el.offsetWidth;
      el.classList.add('is-play');
    };

    let active = -1;
    const setActive = (i: number, focus = false) => {
      if (i === active) return;
      active = i;
      tabs.forEach((t, k) => {
        t.classList.toggle('is-active', k === i);
        t.classList.toggle('is-passed', k <= i);
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
      flow?.style.setProperty('--p', String(i / (tabs.length - 1)));
      if (focus) tabs[i].focus();
      play(panels[i]);
    };
    setActive(0);

    // ----- Passagem automática (só na primeira vez que a seção aparece) -----
    // O fluxo passa sozinho por 01 → 02 → 03 → 04 e volta ao 01, onde para.
    // Para de vez quando a pessoa mexe o mouse sobre a seção, toca, clica ou usa o teclado; pausa fora da tela.
    let auto = !reduced;
    let autoTimer = 0;
    let visible = false;
    let started = false;

    const stopAuto = () => {
      auto = false;
      clearTimeout(autoTimer);
    };

    const scheduleAuto = () => {
      clearTimeout(autoTimer);
      if (!auto || !visible) return;
      autoTimer = window.setTimeout(() => {
        const next = (active + 1) % tabs.length;
        setActive(next);
        if (next === 0) stopAuto();
        else scheduleAuto();
      }, AUTO_STEP_MS);
    };

    // Só movimento de verdade conta: rolar a página com o mouse parado também dispara eventos de "passar por cima"
    root.addEventListener(
      'mousemove',
      (e) => {
        if (!auto || (e.movementX === 0 && e.movementY === 0)) return;
        stopAuto();
      },
      { signal },
    );
    root.addEventListener('pointerdown', stopAuto, { signal });
    root.addEventListener('focusin', stopAuto, { signal });

    let hoverTimer = 0;
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => setActive(i), { signal });
      tab.addEventListener(
        'pointerenter',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(hoverTimer);
          // Durante a passagem automática, quem troca é ela (até a pessoa mexer o mouse)
          hoverTimer = window.setTimeout(() => !auto && setActive(i), HOVER_WAIT_MS);
        },
        { signal },
      );
      tab.addEventListener('pointerleave', () => clearTimeout(hoverTimer), { signal });
      // Teclado: setas andam pelas etapas, Home e End vão para a primeira e a última
      tab.addEventListener(
        'keydown',
        (e) => {
          const last = tabs.length - 1;
          const to =
            e.key === 'ArrowRight' ? Math.min(i + 1, last)
            : e.key === 'ArrowLeft' ? Math.max(i - 1, 0)
            : e.key === 'Home' ? 0
            : e.key === 'End' ? last
            : -1;
          if (to < 0) return;
          e.preventDefault();
          setActive(to, true);
        },
        { signal },
      );
    });

    // Quando a seção aparece: roda a demonstração ativa e começa a passagem automática
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return clearTimeout(autoTimer);
        if (!started) {
          started = true;
          play(panels[active]);
        }
        scheduleAuto();
      },
      { threshold: 0.35 },
    );
    io.observe(root);

    cleanup = () => {
      controller.abort();
      io.disconnect();
      clearTimeout(hoverTimer);
      clearTimeout(autoTimer);
    };
  });
</script>
