---
import SectionTitle from './SectionTitle.astro';

// Escada "do dado à decisão": cada nível agrega mais valor que o anterior
const levels = [
  { title: 'Dados', text: 'Registros brutos de sistemas, bancos e planilhas.', width: '40%' },
  { title: 'Informação', text: 'Dados tratados, padronizados e organizados com SQL.', width: '60%' },
  { title: 'Conhecimento', text: 'Indicadores e tendências apresentados em dashboards.', width: '80%' },
  { title: 'Decisão', text: 'Ações estratégicas embasadas em evidências.', width: '100%' },
];

const deliverables = [
  {
    title: 'Visão unificada',
    text: 'Reunir dados de diferentes fontes em uma única base confiável.',
  },
  {
    title: 'Indicadores claros',
    text: 'KPIs que mostram o desempenho do negócio de forma objetiva.',
  },
  {
    title: 'Agilidade',
    text: 'Respostas em minutos, sem depender de relatórios manuais.',
  },
  {
    title: 'Decisões fundamentadas',
    text: 'Menos intuição, mais evidência na hora de escolher o próximo passo.',
  },
];

// Indicador do topo do painel, um por nível (exemplo fictício)
const kpis = [
  { label: 'Fontes de dados', value: '3 sistemas', note: 'formatos diferentes', tone: 'text-muted' },
  { label: 'Registros tratados', value: '2.230', note: 'padronizados', tone: 'text-muted' },
  { label: 'Faturamento · mar', value: 'R$ 48,2 mil', note: '▲ 12%', tone: 'text-accent' },
  { label: 'Ação · abr', value: '+15% estoque', note: 'meta definida', tone: 'text-accent' },
];

// Gráfico: barras mensais, linha de tendência e projeção
const base = 100;
const heights = [38, 52, 46, 64, 58, 80];
const bars = heights.map((h, i) => ({ x: 10 + i * 42, y: base - h, h }));
const linePoints = bars.map((b) => `${b.x + 11},${b.y}`).join(' ');
const last = bars[bars.length - 1];
const noise = [
  [18, 70], [34, 40], [52, 88], [66, 58], [88, 30], [104, 76], [122, 50], [140, 92],
  [158, 36], [176, 64], [196, 82], [214, 44], [236, 70], [258, 28], [278, 56],
];
---

<section id="bi" class="mx-auto max-w-5xl px-6 py-24">
  <SectionTitle
    title="Do dado à decisão"
    subtitle="Aprimorando a inteligência de negócios para transformar dados dispersos em informações importantes e confiáveis a fim de facilitar a tomada de decisão."
  />

  <div class="mt-14 grid items-start gap-10 lg:grid-cols-[2fr_3fr]">
    <div>
      <p data-reveal class="text-sm text-muted">
        A cadeia de valor dos dados <span class="text-accent">· clique em um nível</span>
      </p>
      <ol data-levels role="tablist" aria-orientation="vertical" aria-label="Níveis da cadeia de valor" class="mt-5 space-y-1">
        {
          levels.map((l, i) => (
            <li data-reveal style={`--delay: ${i * 150}ms`} role="presentation">
              <button
                type="button"
                role="tab"
                aria-controls="bi-dash"
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="group w-full cursor-pointer py-2 text-left"
              >
                <span class="block font-semibold text-muted transition-colors group-hover:text-fg group-aria-selected:text-heading">
                  <span class="mr-3 text-sm text-accent">{i + 1}</span>
                  {l.title}
                </span>
                <span class="mt-2 block h-1.5 rounded-full bg-line opacity-40 transition-opacity group-aria-selected:opacity-100">
                  <span
                    class="level-bar block h-full rounded-full bg-accent"
                    style={`width: ${l.width}; --delay: ${300 + i * 150}ms`}
                  />
                </span>
                <span class="mt-2 block text-sm text-muted">{l.text}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <blockquote data-reveal class="mt-6 border-l-2 border-accent pl-4 text-sm leading-relaxed text-fg/85">
        Meu papel nessa cadeia está na base: garantir que os dados cheguem ao BI extraídos, tratados e prontos para
        análise.
      </blockquote>
    </div>

    <div
      id="bi-dash"
      data-reveal
      data-stage="0"
      role="tabpanel"
      aria-label="Painel de exemplo"
      class="on-light bi-dash rounded-2xl bg-bg p-5"
    >
      <p class="text-sm text-muted">O que o BI entrega</p>

      <div class="mt-5 grid">
        {
          kpis.map((k, i) => (
            <div data-show={String(i)} class="col-start-1 row-start-1 flex items-end justify-between gap-4">
              <div>
                <p class="text-[11px] tracking-wide text-muted uppercase">{k.label}</p>
                <p class="mt-1 font-display text-2xl font-medium text-heading">{k.value}</p>
              </div>
              <p class:list={['text-xs', k.tone]}>{k.note}</p>
            </div>
          ))
        }
      </div>

      <svg viewBox="0 0 300 108" class="mt-4 w-full" aria-hidden="true">
        {[25, 50, 75].map((y) => <line x1="0" x2="300" y1={y} y2={y} stroke="#e3e5e9" stroke-dasharray="3 4" />)}
        <line x1="0" x2="300" y1={base} y2={base} stroke="#e3e5e9" />

        <g data-show="0">
          {noise.map(([cx, cy], i) => <circle cx={cx} cy={cy} r="3" fill={i % 4 === 0 ? '#0a0a0b' : '#9a9ca3'} opacity="0.8" />)}
        </g>
        <g data-show="1 3">
          {
            bars.map((b, i) => (
              <rect class="dash-bar" style={`--i: ${i}`} x={b.x} y={b.y} width="22" height={b.h} rx="4" fill="#0a0a0b" opacity="0.85" />
            ))
          }
        </g>
        <polyline
          data-show="2 3"
          class="dash-line"
          pathLength="1"
          points={linePoints}
          fill="none"
          stroke="#0a0a0b"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
        <g data-show="2">
          {bars.map((b) => <circle cx={b.x + 11} cy={b.y} r="3.5" fill="#ffffff" stroke="#0a0a0b" stroke-width="2" />)}
        </g>
        <g data-show="3">
          <line x1={last.x + 11} y1={last.y} x2="286" y2="8" stroke="#0a0a0b" stroke-width="2" stroke-dasharray="4 4" />
          <circle cx="286" cy="8" r="4" fill="#0a0a0b" />
        </g>
      </svg>

      <div class="mt-5 grid gap-x-6 gap-y-4 border-t border-line pt-5 sm:grid-cols-2">
        {
          deliverables.map((d) => (
            <div>
              <p class="text-sm font-semibold text-heading">{d.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">{d.text}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-4 text-right text-[11px] text-muted/70">exemplo fictício</p>
    </div>
  </div>
</section>

<script>
  // Cada nível da escada muda o estágio do painel; ao aparecer na tela, o painel percorre os níveis uma vez
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-levels]');
    const dash = document.getElementById('bi-dash');
    if (!list || !dash) return;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let timer: number | undefined;

    const select = (index: number) => {
      dash.dataset.stage = String(index);
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
    };

    const stopAuto = () => clearInterval(timer);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stopAuto();
        select(i);
      });
      tab.addEventListener('keydown', (ev) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[ev.key];
        if (!step) return;
        ev.preventDefault();
        stopAuto();
        const next = (i + step + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      select(tabs.length - 1);
      return;
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        let stage = 0;
        timer = window.setInterval(() => {
          stage += 1;
          select(stage);
          if (stage === tabs.length - 1) stopAuto();
        }, 1400);
      },
      { threshold: 0.5 },
    );
    io.observe(dash);
  });
</script>
