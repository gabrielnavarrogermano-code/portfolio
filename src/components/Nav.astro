---
import { site } from '../data/site';
import { idiomaDe, caminho, outroIdioma, textos } from '../i18n';

const idioma = idiomaDe(Astro.url);
const tx = textos[idioma].nav;
const inicio = caminho(idioma, '');
const links = tx.links.map((l) => ({ href: caminho(idioma, `#${l.id}`), label: l.label }));
// O botão de idioma leva para a mesma página no outro idioma
const outro = outroIdioma(Astro.url);
const idiomas = [
  { sigla: 'PT', lang: 'pt-BR', nome: 'Português', atual: idioma === 'pt' },
  { sigla: 'EN', lang: 'en', nome: 'English', atual: idioma === 'en' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    class="relative mx-auto flex max-w-5xl items-center justify-between overflow-hidden rounded-none border border-line bg-bg/95 py-2 pr-2 pl-5 min-[56rem]:bg-bg/90 min-[56rem]:backdrop-blur-md"
  >
    <a href={inicio} class="font-display font-semibold tracking-tight text-heading">
      gabriel<span class="text-accent">.</span>dados
    </a>

    <div class="flex items-center gap-1">
      <!-- Idioma: PT e EN lado a lado, ao lado do Menu. O que está em uso fica preenchido (e não é link);
           o outro leva para a mesma página no outro idioma -->
      <div class="idiomas" role="group" aria-label={tx.idiomaGrupo}>
        {
          idiomas.map((i) =>
            i.atual ? (
              <span class="idioma is-atual" aria-current="true" lang={i.lang} title={i.nome}>
                {i.sigla}
              </span>
            ) : (
              <a class="idioma" href={outro} hreflang={i.lang} lang={i.lang} title={i.nome} aria-label={i.nome}>
                {i.sigla}
              </a>
            ),
          )
        }
      </div>
      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
        class="group inline-flex cursor-pointer items-center gap-2.5 rounded-none px-4 py-2.5 text-[0.9375rem] font-semibold text-heading transition-colors hover:bg-heading/5"
      >
        <span class="flex w-4 flex-col gap-[3px]" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-2/3 bg-current transition-all group-hover:w-full"></span>
        </span>
        {tx.menu}
      </button>
      <a
        href={caminho(idioma, '#contato')}
        class="nav-contato hidden rounded-none bg-latao px-4 py-2.5 text-[0.9375rem] font-semibold text-navy transition-colors hover:bg-navy hover:text-sunset sm:inline-flex"
      >
        {tx.contato}
      </a>
    </div>

    <div class="pointer-events-none absolute inset-x-8 bottom-0 h-px" aria-hidden="true">
      <div id="read-progress" class="read-progress h-full bg-accent"></div>
    </div>
  </nav>
</header>

<!-- Menu em tela cheia: desce como uma cortina e os links sobem um por um.
     Fica fora do header para cobrir também a barra. -->
<div id="site-menu" class="site-menu on-navy fixed inset-0 z-[70] flex flex-col bg-bg" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 pt-7 sm:pt-8">
    <a href={inicio} class="menu-fade font-display font-semibold tracking-tight text-heading">
      gabriel<span class="text-accent">.</span>dados
    </a>
    <button
      type="button"
      data-menu-close
      class="menu-fade inline-flex cursor-pointer items-center gap-2.5 rounded-none border-[1.5px] border-line px-4 py-2.5 text-[0.9375rem] font-semibold text-heading transition-colors hover:border-heading/40"
    >
      {tx.fechar}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-8">
    <p class="menu-fade flex items-center gap-4 text-[0.9375rem] text-muted">
      {tx.paginas} <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
    </p>
    <ul class="mt-6">
      {
        links.map((link, i) => (
          <li class="overflow-hidden">
            <a
              href={link.href}
              data-nav-link={link.href.split('#')[1]}
              data-menu-link
              class="menu-link group flex items-start py-1"
              style={`--n: ${i}`}
            >
              <span
                class="menu-link-text font-display leading-[0.95] font-extrabold text-heading transition-colors group-hover:text-link"
              >
                {link.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="menu-fade mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line px-6 py-6 text-[0.9375rem] text-muted">
    <a href={`mailto:${site.email}`} class="transition-colors hover:text-heading">{site.email}</a>
    <div class="flex gap-5">
      <a href={site.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-heading">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener" class="transition-colors hover:text-heading">GitHub</a>
    </div>
  </div>
</div>

<style>
  /* PT e EN lado a lado, numa cápsula; o idioma em uso fica preenchido */
  .idiomas {
    display: inline-flex;
    padding: 3px;
    border: 1.5px solid var(--color-line);
    border-radius: 0;
  }

  .idioma {
    padding: 0.3rem 0.65rem;
    border-radius: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-muted);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  a.idioma:hover {
    color: var(--color-navy);
  }

  .idioma.is-atual {
    background: var(--color-heading);
    color: var(--color-bg);
  }

  /* Na capa, o Contato da barra some (a capa já tem o seu botão); volta quando os textos da capa saem (Hero) */
  .nav-contato {
    transition:
      opacity 0.3s ease,
      visibility 0s,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* html.na-capa: antes do script rodar (Hero); depois, a classe fica só no botão, para trocar sem recalcular o
     estilo da página inteira */
  :global(html.na-capa) .nav-contato,
  .nav-contato:global(.na-capa) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  /* Fechado: escondido e "enrolado" para cima. Aberto: a cortina desce e os links sobem em sequência */
  .site-menu {
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.75s cubic-bezier(0.75, 0, 0.2, 1),
      visibility 0s linear 0.75s;
  }

  .site-menu.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 0.75s cubic-bezier(0.75, 0, 0.2, 1),
      visibility 0s;
  }

  .menu-link-text {
    font-size: clamp(2.5rem, 9vw, 7rem);
  }

  .menu-link {
    transform: translateY(110%);
    transition: transform 0.5s cubic-bezier(0.5, 0, 0.75, 0);
  }

  .is-open .menu-link {
    transform: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.75, 0.15, 1) calc(0.3s + var(--n) * 0.07s);
  }

  .menu-fade {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .is-open .menu-fade {
    opacity: 1;
    transition: opacity 0.6s ease 0.45s;
  }

  /* Seção em que a pessoa está: o nome fica sublinhado (no azul, o destaque é o próprio Sunset) */
  .menu-link[aria-current='location'] .menu-link-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  :global(html.menu-open) body {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu,
    .site-menu.is-open {
      clip-path: none;
    }
  }
</style>

<script>
  // Mostra o progresso de leitura da página e destaca, no menu, a seção visível
  let bar: HTMLElement | null = null;
  let observer: IntersectionObserver | undefined;
  let ticking = false;
  // Altura rolável fica em cache: ler scrollHeight a cada scroll força recálculo de layout
  let max = 0;

  const measure = () => {
    max = document.documentElement.scrollHeight - window.innerHeight;
  };

  const updateProgress = () => {
    ticking = false;
    if (!bar) return;
    bar.style.setProperty('--progress', String(max > 0 ? Math.min(window.scrollY / max, 1) : 0));
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateProgress);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measure();
    onScroll();
  });
  new ResizeObserver(() => {
    measure();
    onScroll();
  }).observe(document.body);

  let menuController: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    bar = document.getElementById('read-progress');
    measure();
    updateProgress();

    // Menu em tela cheia: abre no botão; fecha no "Fechar", no Esc ou ao escolher um link
    menuController?.abort();
    menuController = new AbortController();
    const { signal } = menuController;
    const menu = document.getElementById('site-menu');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (menu && openBtn && closeBtn) {
      const isOpen = () => menu.classList.contains('is-open');
      const setOpen = (open: boolean) => {
        menu.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('menu-open', open);
        openBtn.setAttribute('aria-expanded', String(open));
        if (open) closeBtn.focus({ preventScroll: true });
        else openBtn.focus({ preventScroll: true });
      };
      openBtn.addEventListener('click', () => setOpen(true), { signal });
      closeBtn.addEventListener('click', () => setOpen(false), { signal });
      menu.querySelectorAll('[data-menu-link]').forEach((a) =>
        a.addEventListener('click', () => setOpen(false), { signal }),
      );

      document.addEventListener(
        'keydown',
        (e) => {
          if (!isOpen()) return;
          if (e.key === 'Escape') return setOpen(false);
          // Mantém o Tab dentro do menu enquanto ele está aberto
          if (e.key !== 'Tab') return;
          const items = [...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        },
        { signal },
      );
    }

    observer?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

    // Considera "ativa" a seção que cruza a faixa central da tela
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            if (link.dataset.navLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('main section[id]').forEach((section) => observer!.observe(section));
  });
</script>
