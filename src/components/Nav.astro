---
import { site } from '../data/site';

const links = [
  { href: '/#apresentacao', label: 'Apresentação' },
  { href: '/#projetos', label: 'Projetos' },
  { href: '/#habilidades', label: 'Como eu trabalho' },
  { href: '/#contato', label: 'Contato' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    class="relative mx-auto flex max-w-5xl items-center justify-between overflow-hidden rounded-full border border-line bg-bg/90 py-2 pr-2 pl-5 backdrop-blur-md"
  >
    <a href="/" class="font-display font-semibold tracking-tight text-heading">
      gabriel<span class="text-accent">.</span>dados
    </a>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
        class="group inline-flex cursor-pointer items-center gap-2.5 rounded-full px-4 py-2.5 font-mono text-xs tracking-[0.15em] text-heading uppercase transition-colors hover:bg-heading/5"
      >
        <span class="flex w-4 flex-col gap-[3px]" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-2/3 bg-current transition-all group-hover:w-full"></span>
        </span>
        Menu
      </button>
      <a
        href="/#contato"
        class="hidden rounded-full bg-red px-4 py-2.5 text-sm font-medium text-sunset transition-colors hover:bg-navy sm:inline-flex"
      >
        Contato
      </a>
    </div>

    <div class="pointer-events-none absolute inset-x-8 bottom-0 h-px" aria-hidden="true">
      <div id="read-progress" class="read-progress h-full bg-accent"></div>
    </div>
  </nav>
</header>

<!-- Menu em tela cheia: desce como uma cortina e os links sobem um por um.
     Fica fora do header para cobrir também a barra. -->
<div id="site-menu" class="site-menu on-navy fixed inset-0 z-[70] flex flex-col bg-bg" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 pt-7 sm:pt-8">
    <a href="/" class="menu-fade font-display font-semibold tracking-tight text-heading">
      gabriel<span class="text-accent">.</span>dados
    </a>
    <button
      type="button"
      data-menu-close
      class="menu-fade inline-flex cursor-pointer items-center gap-2.5 rounded-full border border-line px-4 py-2.5 font-mono text-xs tracking-[0.15em] text-heading uppercase transition-colors hover:border-heading/40"
    >
      Fechar
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-8">
    <p class="menu-fade flex items-center gap-4 font-mono text-xs tracking-[0.15em] text-muted uppercase">
      Páginas <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
    </p>
    <ul class="mt-6">
      {
        links.map((link, i) => (
          <li class="overflow-hidden">
            <a
              href={link.href}
              data-nav-link={link.href.split('#')[1]}
              data-menu-link
              class="menu-link group flex items-start py-1"
              style={`--n: ${i}`}
            >
              <span
                class="menu-link-text font-display leading-[0.95] font-black text-heading uppercase transition-colors group-hover:text-link"
              >
                {link.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="menu-fade mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line px-6 py-6 font-mono text-xs tracking-[0.15em] text-muted uppercase">
    <a href={`mailto:${site.email}`} class="normal-case tracking-normal transition-colors hover:text-heading">{site.email}</a>
    <div class="flex gap-5">
      <a href={site.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-heading">LinkedIn ↗</a>
      <a href={site.github} target="_blank" rel="noopener" class="transition-colors hover:text-heading">GitHub ↗</a>
    </div>
  </div>
</div>

<style>
  /* Fechado: escondido e "enrolado" para cima. Aberto: a cortina desce e os links sobem em sequência */
  .site-menu {
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.75s cubic-bezier(0.75, 0, 0.2, 1),
      visibility 0s linear 0.75s;
  }

  .site-menu.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 0.75s cubic-bezier(0.75, 0, 0.2, 1),
      visibility 0s;
  }

  .menu-link-text {
    font-size: clamp(2.5rem, 9vw, 7rem);
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  .menu-link {
    transform: translateY(110%);
    transition: transform 0.5s cubic-bezier(0.5, 0, 0.75, 0);
  }

  .is-open .menu-link {
    transform: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.75, 0.15, 1) calc(0.3s + var(--n) * 0.07s);
  }

  .menu-fade {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .is-open .menu-fade {
    opacity: 1;
    transition: opacity 0.6s ease 0.45s;
  }

  /* Seção em que a pessoa está: o nome fica sublinhado (no azul, o destaque é o próprio Sunset) */
  .menu-link[aria-current='location'] .menu-link-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  :global(html.menu-open) body {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu,
    .site-menu.is-open {
      clip-path: none;
    }
  }
</style>

<script>
  // Mostra o progresso de leitura da página e destaca, no menu, a seção visível
  let bar: HTMLElement | null = null;
  let observer: IntersectionObserver | undefined;
  let ticking = false;
  // Altura rolável fica em cache: ler scrollHeight a cada scroll força recálculo de layout
  let max = 0;

  const measure = () => {
    max = document.documentElement.scrollHeight - window.innerHeight;
  };

  const updateProgress = () => {
    ticking = false;
    if (!bar) return;
    bar.style.setProperty('--progress', String(max > 0 ? Math.min(window.scrollY / max, 1) : 0));
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateProgress);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measure();
    onScroll();
  });
  new ResizeObserver(() => {
    measure();
    onScroll();
  }).observe(document.body);

  let menuController: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    bar = document.getElementById('read-progress');
    measure();
    updateProgress();

    // Menu em tela cheia: abre no botão; fecha no "Fechar", no Esc ou ao escolher um link
    menuController?.abort();
    menuController = new AbortController();
    const { signal } = menuController;
    const menu = document.getElementById('site-menu');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (menu && openBtn && closeBtn) {
      const isOpen = () => menu.classList.contains('is-open');
      const setOpen = (open: boolean) => {
        menu.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('menu-open', open);
        openBtn.setAttribute('aria-expanded', String(open));
        if (open) closeBtn.focus({ preventScroll: true });
        else openBtn.focus({ preventScroll: true });
      };
      openBtn.addEventListener('click', () => setOpen(true), { signal });
      closeBtn.addEventListener('click', () => setOpen(false), { signal });
      menu.querySelectorAll('[data-menu-link]').forEach((a) =>
        a.addEventListener('click', () => setOpen(false), { signal }),
      );

      document.addEventListener(
        'keydown',
        (e) => {
          if (!isOpen()) return;
          if (e.key === 'Escape') return setOpen(false);
          // Mantém o Tab dentro do menu enquanto ele está aberto
          if (e.key !== 'Tab') return;
          const items = [...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        },
        { signal },
      );
    }

    observer?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

    // Considera "ativa" a seção que cruza a faixa central da tela
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            if (link.dataset.navLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('main section[id]').forEach((section) => observer!.observe(section));
  });
</script>
