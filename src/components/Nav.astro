---
const links = [
  { href: '/#apresentacao', label: 'Apresentação' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#habilidades', label: 'Habilidades' },
  { href: '/#bi', label: 'BI' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    class="on-black relative mx-auto flex max-w-5xl items-center justify-between overflow-hidden rounded-full border border-line/80 bg-ink/95 py-2 pr-2 pl-5"
  >
    <a href="/" class="font-display font-semibold tracking-tight text-heading">
      gabriel<span class="text-accent">.</span>dados
    </a>

    <div class="flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href.split('#')[1]}
            class="hidden rounded-full px-4 py-2 text-sm text-muted transition-colors hover:bg-heading/5 hover:text-heading aria-[current=location]:bg-heading/5 aria-[current=location]:text-heading sm:block"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contato"
        class="rounded-full bg-heading px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-heading/80"
      >
        Contato
      </a>
    </div>

    <div class="pointer-events-none absolute inset-x-8 bottom-0 h-px" aria-hidden="true">
      <div id="read-progress" class="read-progress h-full bg-accent"></div>
    </div>
  </nav>
</header>

<script>
  // Destaca o link da seção visível e mostra o progresso de leitura da página
  let bar: HTMLElement | null = null;
  let observer: IntersectionObserver | undefined;
  let ticking = false;
  // Altura rolável fica em cache: ler scrollHeight a cada scroll força recálculo de layout
  let max = 0;

  const measure = () => {
    max = document.documentElement.scrollHeight - window.innerHeight;
  };

  const updateProgress = () => {
    ticking = false;
    if (!bar) return;
    bar.style.setProperty('--progress', String(max > 0 ? Math.min(window.scrollY / max, 1) : 0));
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateProgress);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measure();
    onScroll();
  });
  new ResizeObserver(() => {
    measure();
    onScroll();
  }).observe(document.body);

  document.addEventListener('astro:page-load', () => {
    bar = document.getElementById('read-progress');
    measure();
    updateProgress();

    observer?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

    // Considera "ativa" a seção que cruza a faixa central da tela
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            if (link.dataset.navLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('main section[id]').forEach((section) => observer!.observe(section));
  });
</script>
