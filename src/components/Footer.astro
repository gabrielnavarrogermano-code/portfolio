---
import { site } from '../data/site';
import { idiomaDe, textos } from '../i18n';

// Rodapé enxuto: o nome e o ano de um lado, os links e o "voltar ao topo" do outro. Os links só aparecem na página
// do projeto, que não tem a seção de contato; na inicial eles já estão logo acima, nos botões de "Fale comigo".
interface Props {
  comLinks?: boolean;
}
const { comLinks = true } = Astro.props;
const tx = textos[idiomaDe(Astro.url)].rodape;
const links = [
  { label: tx.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', href: site.linkedin, external: true },
  { label: 'GitHub', href: site.github, external: true },
];
---

<footer class="rodape">
  <div class="secao-largura">
    <div class="rodape-linha">
      <p>© {site.ano} {site.name}</p>
      <nav aria-label="Links">
        {
          comLinks &&
          links.map((l) => (
            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {l.label}
            </a>
          ))
        }
        <button type="button" data-to-top>{tx.topo}</button>
      </nav>
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-block: 5rem 4rem;
  }

  .rodape-linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .rodape-linha nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }

  .rodape-linha a,
  .rodape-linha button {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.25s ease;
  }

  .rodape-linha a:hover,
  .rodape-linha button:hover {
    color: var(--color-heading);
  }
</style>

<script>
  // Voltar ao topo: desliza (o scroll-behavior: smooth do global.css já respeita quem pediu menos movimento)
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-to-top]')?.addEventListener('click', () => {
      window.scrollTo({ top: 0 });
    });
  });
</script>
