---
import Secao from './Secao.astro';
import { site } from '../data/site';
import { idiomaDe, textos } from '../i18n';

// Prazer, Gabriel: o fio vira a linha do tempo. Origem e Agora à esquerda, Descoberta à direita; cada ponto
// acende quando o fio chega nele. De "Agora" saem três ramos: a experiência (sempre visível), a formação e os
// estudos. No celular, tudo numa coluna, com a linha do tempo na lateral esquerda. Textos em src/i18n.ts.
const tx = textos[idiomaDe(Astro.url)].prazer;
const tools = ['Microsoft 365 Admin', 'Entra ID', 'SharePoint', 'Kanban'];

// Progresso do curso (o semestre é atualizado em data/site.ts)
const { semestre: semester, total: totalSemesters } = site.curso;
---

<Secao id="apresentacao" titulo={tx.titulo}>
  <div class="tempo">
    <div class="marco" data-abre>
      <h3>{tx.origem}</h3>
      <p set:html={tx.origemTexto} />
    </div>
    <span class="no" data-no aria-hidden="true"></span>

    <span class="no" data-no aria-hidden="true"></span>
    <div class="marco marco-dir" data-abre>
      <h3>{tx.descoberta}</h3>
      <p set:html={tx.descobertaTexto} />
    </div>

    <div class="marco" data-abre>
      <h3>{tx.agora}</h3>
      <p>{tx.agoraTexto}</p>
    </div>
    <span class="no" data-no aria-hidden="true"></span>
    <div class="ramos">
      <article class="ramo" data-abre>
        <p class="ramo-tipo">
          {tx.experiencia} <span class="ramo-atual">{tx.atual}</span>
        </p>
        <h4 class="ramo-titulo">{tx.cargo}</h4>
        <p class="ramo-texto">{tx.empresa}</p>
        <ul class="ramo-ferramentas" aria-label={tx.ferramentas}>
          {tools.map((t) => <li>{t}</li>)}
        </ul>
      </article>
      <article class="ramo" data-abre>
        <p class="ramo-tipo">{tx.formacao}</p>
        <h4 class="ramo-titulo">{tx.curso}</h4>
        <div class="ramo-semestres">
          <div class="barras" role="img" aria-label={tx.semestres(semester, totalSemesters)}>
            {Array.from({ length: totalSemesters }, (_, k) => <i class:list={[k < semester && 'feito']} />)}
          </div>
          <span>{tx.semestreCurto(semester, totalSemesters)}</span>
        </div>
      </article>
      <article class="ramo" data-abre>
        <p class="ramo-tipo">{tx.estudando}</p>
        <h4 class="ramo-titulo">{tx.estudos}</h4>
      </article>
    </div>
  </div>
</Secao>

<style>
  /* Três colunas: o lado esquerdo, o fio (4rem, no centro da página) e o lado direito */
  .tempo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr);
    row-gap: 3.2rem;
    margin-top: 4rem;
  }

  .marco {
    grid-column: 1;
    text-align: right;
  }

  .marco-dir {
    grid-column: 3;
    text-align: left;
  }

  .marco h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .marco p {
    max-width: 27rem;
    margin-top: 0.35rem;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .marco:not(.marco-dir) p {
    margin-left: auto;
  }

  .marco :global(b) {
    font-weight: 700;
    color: var(--color-heading);
  }

  /* O ponto no fio: acende em vermelho quando o fio passa por ele */
  .no {
    position: relative;
    z-index: 2;
    grid-column: 2;
    justify-self: center;
    width: 15px;
    height: 15px;
    margin-top: 0.35rem;
    border: 1.5px solid var(--color-heading);
    border-radius: 9999px;
    background: var(--color-bg);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .no:global(.aceso),
  :global(html:not(.fio-js)) .no {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .no:global(.aceso) {
    transform: scale(1.15);
  }

  /* Os ramos de "Agora": saem do fio para a direita, cada um com um traço que se desenha */
  .ramos {
    grid-column: 3;
    display: grid;
    gap: 1.6rem;
  }

  .ramo {
    position: relative;
    padding-left: 1.4rem;
  }

  .ramo::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 1.05rem;
    width: 2.9rem;
    height: 1.5px;
    background: var(--color-heading);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.2, 1) 0.1s;
  }

  :global(html.fio-js) .ramo:not(:global(.aberto))::before {
    transform: scaleX(0);
  }

  .ramo-tipo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .ramo-atual {
    padding: 0.1rem 0.55rem;
    border-radius: 9999px;
    background: var(--color-red);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-sunset);
  }

  .ramo-titulo {
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 800;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .ramo-texto {
    max-width: 30rem;
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .ramo-ferramentas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .ramo-ferramentas li {
    padding: 0.2rem 0.65rem;
    border: 1.5px solid var(--color-line);
    border-radius: 9999px;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .ramo-semestres {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-top: 0.55rem;
  }

  .barras {
    display: flex;
    gap: 4px;
    width: 9rem;
  }

  .barras i {
    flex: 1;
    height: 6px;
    border-radius: 9999px;
    background: rgb(26 27 22 / 0.15);
  }

  .barras i.feito {
    background: var(--color-red);
  }

  .ramo-semestres span {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* Celular e telas médias: uma coluna, com a linha do tempo na lateral esquerda */
  @media (max-width: 55.99rem) {
    .tempo {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      grid-auto-flow: dense;
      row-gap: 2.4rem;
      margin-top: 2.6rem;
    }

    .tempo::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(1.1rem - 0.75px);
      width: 1.5px;
      background: var(--color-heading);
    }

    .marco,
    .marco-dir {
      grid-column: 2;
      text-align: left;
    }

    .marco:not(.marco-dir) p {
      margin-left: 0;
    }

    .marco p {
      font-size: 1.125rem;
    }

    .no {
      grid-column: 1;
    }

    .ramos {
      grid-column: 2;
    }

    .ramo::before {
      left: -1.9rem;
      width: 1.6rem;
    }
  }
</style>
