---
import SectionTitle from './SectionTitle.astro';
import Letras from './Letras.astro';
import { site } from '../data/site';

// As cenas 2 e 3 do palco da capa (ver Hero): "Prazer, Gabriel" e a trajetória.
// - No palco (computador, com movimento), cada cena fica por cima da capa e entra quando a rolagem chega nela.
// - Fora do palco (celular, movimento reduzido ou sem JS), as cenas são blocos normais, um embaixo do outro,
// A trajetória fica sempre visível: experiência, formação e estudos, cada um com um título grande em serifa.
const tools = ['Microsoft 365 Admin', 'Entra ID', 'SharePoint', 'Kanban'];
const studying = ['SQL', 'DAX no Power BI', 'Data storytelling'];

// Progresso do curso (o semestre é atualizado em data/site.ts)
const { semestre: semester, total: totalSemesters } = site.curso;
---

<!-- Cena 2: Prazer, Gabriel -->
<div class="cena cena-prazer" data-cena="prazer">
  <!-- Destino do link "Apresentação" do menu (no palco, a Hero leva este marcador para a altura certa da rolagem) -->
  <span id="apresentacao" data-ancora class="cena-ancora" aria-hidden="true"></span>
  <div class="cena-grade mx-auto w-full max-w-5xl px-6">
    <div class="cena-texto">
      <SectionTitle title="Prazer, Gabriel" />
      <p class="pt-text mt-8 font-serif text-[1.3rem] leading-[1.35] text-fg/60 sm:mt-10 sm:text-[1.6rem]">
        Cresci entre <b>empreendedores</b>, meu pai e meu avô, vendo de perto o que funcionava e o que podia melhorar em
        um negócio. Cursando <b>Engenharia de Software</b>, encontrei na <b>análise de dados</b> um jeito de levar os
        números para dentro dessas decisões. Hoje sou <b>estagiário de TI</b> numa indústria farmacêutica e sigo
        estudando para fazer o caminho inteiro, da extração ao dashboard. No estágio, aprendi que um dashboard só
        funciona se <em class="text-accent">quem não é técnico consegue usar sozinho.</em>
      </p>
    </div>
  </div>
</div>

<!-- Cena 3: trajetória: experiência, formação e estudos -->
<div class="cena cena-trajetoria" data-cena="trajetoria">
  <div class="cena-grade mx-auto w-full max-w-5xl px-6">
    <div class="cena-texto grid content-start gap-7">
      <article>
        <p class="pt-kind">
          <span class="pt-live relative size-1.5 flex-none rounded-full bg-accent" aria-hidden="true"></span>
          Experiência <span class="text-accent">· Atual</span>
        </p>
        <h3 class="pt-linha"><Letras texto="Estagiário de TI" class="block font-serif" /></h3>
        <p class="mt-1.5 text-heading">
          Hebe's Life Science <span class="text-muted">· Indústria farmacêutica</span>
        </p>
        <p class="mt-1.5 max-w-lg leading-relaxed text-fg/75">
          Atendo chamados e cuido de acessos: vejo de perto como cada área trabalha e do que ela precisa. Foi daí que
          saiu o controle de notebooks.
        </p>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Ferramentas">
          {tools.map((t) => <li class="rounded-full border border-line px-3 py-1 font-mono text-[11px] text-muted sm:text-xs">{t}</li>)}
        </ul>
      </article>

      <article>
        <p class="pt-kind">
          <span class="size-1.5 flex-none rounded-full bg-muted/60" aria-hidden="true"></span>
          Formação
        </p>
        <h3 class="pt-linha"><Letras texto="Engenharia de Software" class="block font-serif" atraso={0.15} /></h3>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="text-heading">UniCesumar <span class="text-muted">· lógica, programação e banco de dados</span></p>
          <div class="flex items-center gap-3">
            <div class="flex w-28 gap-1" role="img" aria-label={`${semester}º de ${totalSemesters} semestres`}>
              {Array.from({ length: totalSemesters }, (_, k) => (
                <span class:list={['h-1.5 flex-1 rounded-full', k < semester ? 'bg-accent' : 'bg-line']} />
              ))}
            </div>
            <span class="font-mono text-xs text-muted" aria-hidden="true">{semester}º / {totalSemesters}</span>
          </div>
        </div>
      </article>

      <article>
        <p class="pt-kind">
          <span class="size-1.5 flex-none rounded-full bg-muted/60" aria-hidden="true"></span>
          Estudando agora
        </p>
        <h3 class="pt-linha"><Letras texto={studying.join(' · ')} class="block font-serif" atraso={0.3} /></h3>
      </article>
    </div>
  </div>
</div>

<style>
  /* ---------- Fora do palco: blocos normais ---------- */
  .cena {
    padding-block: 4rem;
  }

  @media (min-width: 40rem) {
    .cena {
      padding-block: 6rem;
    }
  }

  .cena-grade {
    display: grid;
    gap: 2.5rem;
  }


  /* ---------- No palco (computador, com movimento): ver a Hero ---------- */
  /* Cada cena cobre o palco inteiro, por cima da capa, e só aparece quando a rolagem chega nela (is-ativa) */
  :global(html.palco-ativo) .cena {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-block: 6rem 2rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s linear 0.5s;
  }

  /* A cena cobre o palco inteiro, mas só o texto recebe o mouse: a foto, embaixo dela, continua se desintegrando */
  :global(html.palco-ativo) .cena.is-ativa .cena-texto {
    pointer-events: auto;
  }

  :global(html.palco-ativo) .cena.is-ativa {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  /* As letras dos títulos entram em onda cada vez que a cena aparece */
  :global(html.palco-ativo) .cena:not(.is-ativa) :global(.letra) {
    opacity: 0;
    transform: translateY(0.55em) rotate(12deg);
  }

  /* Sem nada ao lado, o texto de cada cena fica numa coluna de leitura confortável */
  :global(html.palco-ativo) .cena-texto {
    max-width: 44rem;
  }

  /* ---------- Texto ---------- */
  /* Palavras de destaque do texto: brancas, sem negrito pesado */
  .pt-text :global(b) {
    font-weight: 400;
    color: var(--color-heading);
  }

  /* Rótulo de cada item: mono, com a bolinha de status */
  .pt-kind {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .pt-kind {
      font-size: 0.75rem;
    }
  }

  /* Título de cada item: grande, em serifa (a Letras leva a fonte; o h3 do global.css usaria a Tektur) */
  .pt-linha {
    margin-top: 0.5rem;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.05;
    color: var(--color-heading);
  }

  /* "Atual": a bolinha pulsa como um indicador ao vivo, igual ao status da capa */
  .pt-live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--color-accent);
    animation: pt-ping 2.4s ease-out infinite;
  }

  @keyframes pt-ping {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    60%,
    to {
      opacity: 0;
      transform: scale(3.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-live::after {
      animation: none;
    }
  }
</style>
