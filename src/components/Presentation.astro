---
import SectionTitle from './SectionTitle.astro';
import { site } from '../data/site';

const tools = ['Microsoft 365 Admin', 'Entra ID', 'SharePoint', 'Kanban'];

// O que estou estudando agora (terceira coluna da Trajetória)
const studying = ['SQL', 'DAX no Power BI', 'Data storytelling'];

// A história, em capítulos. As palavras em <b> ficam em destaque (brancas).
const chapters = [
  {
    title: 'Origem',
    text: 'Cresci entre <b>empreendedores</b>, meu pai e meu avô, vendo de perto o que funcionava e o que podia melhorar em um negócio.',
  },
  {
    title: 'Números',
    text: 'Na faculdade, encontrei na <b>análise de dados</b> um jeito de levar os números para dentro das decisões de uma empresa.',
  },
  {
    title: 'Hoje',
    text: 'Sou <b>estagiário de TI</b> em uma indústria farmacêutica. Atendendo chamados e cuidando de acessos, vejo de perto como cada área trabalha e do que ela precisa.',
  },
];

// Progresso do curso (o semestre é atualizado em data/site.ts)
const { semestre: semester, total: totalSemesters } = site.curso;
---

<!-- Sem palavra de fundo (ela fica só em Projetos e Contato): o espaço acima do título vem do padding -->
<section id="apresentacao" class="relative isolate mx-auto max-w-5xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-24 lg:pt-32">
  <SectionTitle title="Prazer, Gabriel" />

  <!-- Computador: a história à esquerda e, ao lado, a frase que resume o que aprendi, em destaque.
       Celular: tudo em uma coluna -->
  <div class="mt-8 grid grid-cols-1 gap-10 sm:mt-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-16">
    <!-- A história em três capítulos: número e título numa coluna estreita, o texto ao lado.
         Cada linha tem só a altura do próprio texto -->
    <ol class="border-t border-line">
      {
        chapters.map((c, i) => (
          <li data-reveal class="chapter grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-x-6">
            <div class="pt-0.5">
              <span class="block font-mono text-[11px] text-muted">( 0{i + 1} )</span>
              <h3 class="mt-1.5 font-sans text-lg leading-snug font-semibold text-heading sm:text-xl">{c.title}</h3>
            </div>
            <p class="leading-relaxed text-fg/75 sm:text-[1.05rem]" set:html={c.text} />
          </li>
        ))
      }
    </ol>

    <!-- Citação: a mesma serifa da frase da capa, com o final em lima e itálico -->
    <figure data-reveal class="lg:self-center">
      <span class="block font-serif text-6xl leading-none text-muted/60" aria-hidden="true">“</span>
      <blockquote class="-mt-4 font-serif text-[2rem] leading-[1.1] text-balance text-heading sm:text-[2.5rem]">
        Um dashboard só funciona se <em class="text-accent">quem não é técnico consegue usar sozinho.</em>
      </blockquote>
      <figcaption class="mt-6 flex items-center gap-3 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
        <span class="h-px w-8 bg-line" aria-hidden="true"></span>
        O que aprendi no estágio
      </figcaption>
    </figure>
  </div>

  <!-- Trajetória: formação, experiência e estudos lado a lado, como a ficha do projeto (no celular, uma embaixo da outra) -->
  <div class="mt-14 sm:mt-16">
    <p class="flex items-center gap-4 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
      ( Trajetória ) <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
    </p>

    <dl class="mt-2 grid md:grid-cols-3">
      <div data-reveal class="col">
        <dt class="row-kind">( 01 ) Formação</dt>
        <dd>
          <p class="row-title">Engenharia de Software</p>
          <p class="mt-1 text-heading">UniCesumar</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">Base técnica em lógica, programação e banco de dados, aplicada desde já a projetos de análise.</p>
          <div class="mt-4 flex items-center gap-3">
            <div class="flex w-32 gap-1" role="img" aria-label={`${semester}º de ${totalSemesters} semestres`}>
              {
                Array.from({ length: totalSemesters }, (_, i) => (
                  <span class:list={['h-1.5 flex-1 rounded-full', i < semester ? 'bg-accent' : 'bg-line']} />
                ))
              }
            </div>
            <span class="font-mono text-xs text-muted" aria-hidden="true">{semester}º / {totalSemesters} semestres</span>
          </div>
        </dd>
      </div>

      <div data-reveal class="col">
        <dt class="row-kind">( 02 ) Experiência atual</dt>
        <dd>
          <p class="row-title">Estagiário de TI</p>
          <p class="mt-1 text-heading">Hebe's Life Science</p>
          <p class="text-sm text-muted">Indústria farmacêutica</p>
          <ul class="mt-3 flex flex-wrap gap-x-2 font-mono text-xs leading-relaxed text-muted" aria-label="Ferramentas">
            {tools.map((t, i) => <li>{t}{i < tools.length - 1 && <span aria-hidden="true"> ·</span>}</li>)}
          </ul>
        </dd>
      </div>

      <div data-reveal class="col">
        <dt class="row-kind">( 03 ) Em andamento</dt>
        <dd>
          <p class="row-title">Estudando agora</p>
          <ul class="mt-1 flex flex-wrap gap-x-2 text-heading" aria-label="Estudos">
            {studying.map((t, i) => <li>{t}{i < studying.length - 1 && <span class="text-muted" aria-hidden="true"> ·</span>}</li>)}
          </ul>
          <p class="mt-2 text-sm leading-relaxed text-muted">Para fazer o caminho inteiro, da extração ao dashboard.</p>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* Capítulos da história: as palavras-chave em branco */
  .chapter :global(b) {
    font-weight: 500;
    color: var(--color-heading);
  }

  /* Colunas da trajetória: celular em pilha, separadas por linhas; a partir de md, lado a lado,
     separadas por uma linha vertical (como a ficha do projeto) */
  .col {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 48rem) {
    .col {
      padding-inline: 1.5rem;
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }

    .col:first-child {
      padding-left: 0;
    }

    .col:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }

  .row-kind {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .row-title {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 2vw, 1.4rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-heading);
  }
</style>
