---
import Secao from './Secao.astro';
import { site } from '../data/site';
import { idiomaDe, textos } from '../i18n';

// ( 01 ) Prazer, Gabriel: a história em três blocos à esquerda e a trajetória (experiência, formação e estudos)
// no painel. A experiência fica sempre visível, sem depender de toque ou hover. Textos em src/i18n.ts.
const tx = textos[idiomaDe(Astro.url)].prazer;
const tools = ['Microsoft 365 Admin', 'Entra ID', 'SharePoint', 'Kanban'];

// Progresso do curso (o semestre é atualizado em data/site.ts)
const { semestre: semester, total: totalSemesters } = site.curso;
---

<Secao id="apresentacao" num="01" rotulo={tx.rotulo} rotuloDir={tx.rotuloDir} titulo={tx.titulo}>
  <!-- A história em três blocos curtos, cada um com um rótulo: dá para ler por partes, sem um bloco corrido -->
  <div slot="negocio" class="pt-historia">
    <div>
      <p class="pt-rot">{tx.origem}</p>
      <p class="serif-grande" set:html={tx.origemTexto} />
    </div>
    <div>
      <p class="pt-rot">{tx.descoberta}</p>
      <p class="serif-grande" set:html={tx.descobertaTexto} />
    </div>
    <div>
      <p class="pt-rot">{tx.agora}</p>
      <p class="serif-grande" set:html={tx.agoraTexto} />
    </div>
  </div>

  <article slot="dados" class="pt-item">
    <p class="pt-kind">
      <span class="pt-live relative size-1.5 flex-none rounded-full bg-heading" aria-hidden="true"></span>
      {tx.experiencia} <span class="pt-atual">{tx.atual}</span>
    </p>
    <h3 class="pt-linha">{tx.cargo}</h3>
    <p class="pt-texto">{tx.empresa}</p>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label={tx.ferramentas}>
      {tools.map((t) => <li class="rounded-full border border-line px-3 py-1 font-mono text-[11px] text-muted">{t}</li>)}
    </ul>
  </article>

  <article slot="dados" class="pt-item">
    <p class="pt-kind">{tx.formacao}</p>
    <h3 class="pt-linha">{tx.curso}</h3>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="flex w-36 gap-1" role="img" aria-label={tx.semestres(semester, totalSemesters)}>
        {Array.from({ length: totalSemesters }, (_, k) => (
          <span class:list={['h-1.5 flex-1 rounded-full', k < semester ? 'bg-heading' : 'bg-heading/20']} />
        ))}
      </div>
      <span class="font-mono text-xs text-muted">{tx.semestreCurto(semester, totalSemesters)}</span>
    </div>
  </article>

  <article slot="dados" class="pt-item">
    <p class="pt-kind">{tx.estudando}</p>
    <h3 class="pt-linha">{tx.estudos.join(' · ')}</h3>
  </article>
</Secao>

<style>
  /* A história: três blocos, cada um com o rótulo em mono e um traço; a serifa um pouco menor que a de uma frase só */
  .pt-historia {
    display: grid;
    gap: 1.4rem;
  }

  .pt-historia .serif-grande {
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
  }

  .pt-rot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pt-rot::before {
    content: '';
    width: 1.1rem;
    height: 1px;
    background: var(--color-accent);
  }

  .pt-item + .pt-item {
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-line);
  }

  .pt-kind {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* "Atual": a etiqueta vermelha, o único destaque do painel */
  .pt-atual {
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-red);
    color: var(--color-sunset);
    letter-spacing: 0.1em;
  }

  .pt-linha {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 800;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .pt-texto {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* A bolinha do "Atual" pulsa como um indicador ao vivo */
  .pt-live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--color-heading);
    animation: pt-ping 2.4s ease-out infinite;
  }

  @keyframes pt-ping {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    60%,
    to {
      opacity: 0;
      transform: scale(3.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-live::after {
      animation: none;
    }
  }
</style>
