---
import Secao from './Secao.astro';
import { site } from '../data/site';
import { idiomaDe, textos } from '../i18n';

// Prazer, Gabriel: a história em três passos lado a lado (Origem, Descoberta, Agora). O fio desce do título e, ao
// chegar na trilha, se abre para os dois lados: vira a linha do tempo, com um ponto por passo que acende quando o fio
// passa. Embaixo, uma ficha plana: a experiência de um lado, a formação e os estudos do outro.
// No celular, os passos ficam um embaixo do outro, com a linha do tempo na lateral esquerda. Textos em src/i18n.ts.
const tx = textos[idiomaDe(Astro.url)].prazer;
const tools = ['Microsoft 365 Admin', 'Entra ID', 'SharePoint', 'Kanban'];

// Progresso do curso (o semestre é atualizado em data/site.ts)
const { semestre: semester, total: totalSemesters } = site.curso;

const passos = [
  { titulo: tx.origem, texto: tx.origemTexto },
  { titulo: tx.descoberta, texto: tx.descobertaTexto },
  { titulo: tx.agora, texto: tx.agoraTexto },
];
---

<Secao id="apresentacao" titulo={tx.titulo}>
  <div class="historia" data-fio-fim>
    <!-- a trilha: o fio termina no meio dela (o topo da .historia) e ela se desenha do centro para as pontas -->
    <span class="trilha" data-abre aria-hidden="true"></span>
    <ol class="passos">
      {
        passos.map((p) => (
          <li class="passo" data-abre>
            <span class="no" data-no aria-hidden="true" />
            <h3 class="passo-titulo">{p.titulo}</h3>
            <p class="passo-texto" set:html={p.texto} />
          </li>
        ))
      }
    </ol>
  </div>

  <div class="ficha">
    <article class="ficha-bloco" data-abre>
      <p class="ficha-tipo">
        {tx.experiencia} <span class="ficha-atual">{tx.atual}</span>
      </p>
      <h4 class="ficha-titulo">{tx.cargo}</h4>
      <p class="ficha-texto">{tx.empresa}</p>
      <p class="ficha-ferramentas">
        <span class="sr-only">{tx.ferramentas}: </span>{tools.join(', ')}
      </p>
    </article>

    <div class="ficha-bloco ficha-lado" data-abre>
      <div>
        <p class="ficha-tipo">{tx.formacao}</p>
        <h4 class="ficha-titulo">{tx.curso}</h4>
        <div class="semestres">
          <div class="barras" role="img" aria-label={tx.semestres(semester, totalSemesters)}>
            {Array.from({ length: totalSemesters }, (_, k) => <i class:list={[k < semester && 'feito']} />)}
          </div>
          <span>{tx.semestreCurto(semester, totalSemesters)}</span>
        </div>
      </div>
      <div>
        <p class="ficha-tipo">{tx.estudando}</p>
        <h4 class="ficha-titulo ficha-titulo-menor">{tx.estudos}</h4>
      </div>
    </div>
  </div>
</Secao>

<style>
  /* ---------- A história: três passos, a trilha por cima ---------- */
  .historia {
    position: relative;
    margin-top: 4.5rem;
    padding-top: 0.5rem;
  }

  /* a linha do tempo deitada; abre do centro (onde o fio chega) para as pontas */
  .trilha {
    position: absolute;
    top: 1rem;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--color-fio);
    transform-origin: center;
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.2, 1) !important;
  }

  :global(html.fio-js) .trilha:not(:global(.aberto)) {
    opacity: 1;
    transform: scaleX(0);
  }

  .passos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }

  .passo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* o ponto na trilha: acende em latão quando o fio passa por ele */
  .no {
    position: relative;
    z-index: 2;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--color-fio);
    border-radius: 9999px;
    background: var(--color-bg);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .no:global(.aceso),
  :global(html:not(.fio-js)) .no {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .no:global(.aceso) {
    transform: scale(1.2);
  }

  .passo-titulo {
    margin-top: 1.5rem;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-heading);
  }

  .passo-texto {
    max-width: 21rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .passo-texto :global(b) {
    font-weight: 700;
    color: var(--color-heading);
  }

  /* ---------- A ficha: experiência | formação e estudos ---------- */
  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem;
    margin-top: 5.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgb(20 25 55 / 0.2);
  }

  .ficha-lado {
    display: grid;
    gap: 2.25rem;
    align-content: start;
  }

  .ficha-tipo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* reto, como os botões */
  .ficha-atual {
    padding: 0.15rem 0.5rem;
    background: var(--color-latao);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .ficha-titulo {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .ficha-titulo-menor {
    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
  }

  .ficha-texto {
    max-width: 32rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .ficha-ferramentas {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .semestres {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-top: 0.75rem;
  }

  .barras {
    display: flex;
    gap: 4px;
    width: 9rem;
  }

  .barras i {
    flex: 1;
    height: 6px;
    background: rgb(20 25 55 / 0.15);
  }

  .barras i.feito {
    background: var(--color-latao);
  }

  .semestres span {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* ---------- Celular e telas médias: uma coluna, a linha do tempo na lateral esquerda ---------- */
  @media (max-width: 55.99rem) {
    .historia {
      margin-top: 2.75rem;
    }

    .trilha {
      top: 0.5rem;
      bottom: 0.5rem;
      left: calc(0.5rem - 0.75px);
      right: auto;
      width: 1.5px;
      height: auto;
      transform-origin: top;
    }

    :global(html.fio-js) .trilha:not(:global(.aberto)) {
      transform: scaleY(0);
    }

    .passos {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }

    .passo {
      display: grid;
      grid-template-columns: 1rem minmax(0, 1fr);
      column-gap: 1.25rem;
      align-items: start;
      text-align: left;
    }

    .no {
      grid-row: 1 / 3;
      margin-top: 0.35rem;
    }

    .passo-titulo {
      margin-top: 0;
      font-size: 1.6rem;
    }

    .passo-texto {
      grid-column: 2;
      max-width: none;
      margin-top: 0.4rem;
    }

    .ficha {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
    }
  }
</style>
