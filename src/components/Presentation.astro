---
import CardToggle from './CardToggle.astro';
import SectionTitle from './SectionTitle.astro';

// Atividades do estágio, curtas o bastante para virar tags
const experience = ['Infraestrutura de redes', 'Diagnóstico e reparo de hardware'];

const tools = ['Kanban', 'SharePoint', 'Microsoft 365 Admin', 'Entra ID'];

// Progresso do curso: atualize o semestre a cada período
const semester = 2;
const totalSemesters = 8;

// Card "gabriel.py": a apresentação escrita como um dicionário Python
const profile: [string, string | string[]][] = [
  ['curso', 'Engenharia de Software'],
  ['semestre', `${semester}º de ${totalSemesters}`],
  ['foco', ['Inteligência de Dados', 'Análise de Dados']],
  ['estudando', ['Extração de dados', 'Tratamento de dados', 'Excel e SQL']],
  ['busca', ['Estágio em Dados', 'Júnior em Dados']],
];
---

<section id="apresentacao" class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="lg:sticky lg:top-28">
        <SectionTitle title="Prazer, Gabriel" />

        <div data-reveal style="--delay: 100ms" class="mt-8 overflow-hidden rounded-2xl border border-line bg-white/[0.03]">
          <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
            <span class="ml-2 font-mono text-xs text-muted">gabriel.py</span>
          </div>
          <!-- Cores no estilo do tema GitHub Dark do VS Code: comentário cinza, variável laranja, strings azul-claro e colchetes coloridos por nível -->
          <pre class="overflow-x-auto p-4 font-mono text-[11px] leading-relaxed text-[#c9d1d9] sm:p-5 sm:text-[13px]"><code><span class="text-[#8b949e]"># do negócio real a respostas confiáveis</span>
<span class="text-[#ffa657]">gabriel</span> = <span class="text-[#79c0ff]">{'{'}</span>
{
  profile.map(([key, value]) => (
    <Fragment>
      {'  '}<span class="text-[#a5d6ff]">"{key}"</span>: {typeof value === 'string' ? (
        <Fragment><span class="text-[#a5d6ff]">"{value}"</span>,{'\n'}</Fragment>
      ) : (
        <Fragment><span class="text-[#56d364]">[</span>{'\n'}{value.map((v) => (
          <Fragment>{'    '}<span class="text-[#a5d6ff]">"{v}"</span>,{'\n'}</Fragment>
        ))}{'  '}<span class="text-[#56d364]">]</span>,{'\n'}</Fragment>
      )}
    </Fragment>
  ))
}<span class="text-[#79c0ff]">{'}'}</span></code></pre>
        </div>
      </div>
    </div>

    <div class="lg:col-span-3">
      <article data-reveal>
        <p class="leading-relaxed text-fg/85">
          Eu sempre fui uma pessoa que gostou de tecnologia, mas principalmente de números, estatísticas e de como eles
          se relacionam com a área de negócio. Por isso, resolvi me aprofundar na análise de dados, buscando contribuir
          diretamente para o crescimento da empresa, além de fornecer uma visão do cenário da empresa em uma parte que
          pode ser difícil de entender para pessoas não técnicas: a análise e a inteligência de dados. Quero que quem
          decide só se preocupe em tomar a melhor decisão com base nos dados trazidos por mim, confiando no meu trabalho.
        </p>
        <p class="mt-4 leading-relaxed text-fg/85">
          Na empresa onde trabalho atualmente, ainda temos um volume considerado pequeno de dados, então vi que era a
          hora perfeita para começar a centralizar algumas informações, para que mais para frente isso não vire um
          problema. Isso me levou para a parte de extração e tratamento, principalmente de dados relacionados aos
          colaboradores.
        </p>
        <p class="mt-4 leading-relaxed text-fg/85">
          Meu estágio em TI em uma indústria farmacêutica me deu essa visão na prática. Atendendo chamados,
          gerenciando acessos e documentando processos, vejo de perto como cada área trabalha e quais informações ela
          precisa para seguir em frente. É nesse dia a dia que a tecnologia deixa de ser só ferramenta e passa a fazer
          parte de como o negócio funciona.
        </p>
      </article>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-3 sm:mt-12 md:grid-cols-2 md:gap-6">
    <article data-reveal data-collapse style="--delay: 100ms" class="rounded-2xl border border-line p-5 transition-colors max-sm:data-open:border-heading/30 max-sm:data-open:bg-white/[0.03] sm:p-6">
      <div class="relative max-sm:pr-8">
        <p class="text-sm text-accent">Formação</p>
        <h3 class="mt-2 text-xl font-semibold text-heading">Engenharia de Software</h3>
        <p class="mt-1 text-muted">UniCesumar</p>
        <CardToggle label="Formação: ver detalhes" target="formacao-detalhes" />
      </div>
      <div id="formacao-detalhes" data-collapse-body>
        <div class="mt-4 flex items-center gap-3">
          <div class="flex flex-1 gap-1" role="img" aria-label={`${semester}º de ${totalSemesters} semestres`}>
            {
              Array.from({ length: totalSemesters }, (_, i) => (
                <span class:list={['h-1.5 flex-1 rounded-full', i < semester ? 'bg-accent' : 'bg-line']} />
              ))
            }
          </div>
          <span class="flex-none text-sm text-muted">{semester}º de {totalSemesters} semestres</span>
        </div>
        <p class="mt-4 leading-relaxed text-fg/85">
          Base técnica em lógica, programação e banco de dados, aplicada desde já a projetos de análise.
        </p>
      </div>
    </article>

    <article data-reveal data-collapse style="--delay: 200ms" class="rounded-2xl border border-line p-5 transition-colors max-sm:data-open:border-heading/30 max-sm:data-open:bg-white/[0.03] sm:p-6">
      <div class="relative max-sm:pr-8">
        <p class="text-sm text-accent">Experiência atual</p>
        <h3 class="mt-2 text-xl font-semibold text-heading">Estagiário de TI</h3>
        <p class="mt-1 text-muted">Hebe's Life Science · Indústria farmacêutica</p>
        <CardToggle label="Experiência atual: ver detalhes" target="experiencia-detalhes" />
      </div>
      <div id="experiencia-detalhes" data-collapse-body>
        <p class="mt-4 leading-relaxed text-fg/85">
          Meu dia a dia consiste em resolver chamados de helpdesk, gerenciar permissões e acessos de usuários na empresa
          e documentar processos operacionais padrão.
        </p>
        <a
          href="/projetos/controle-de-notebooks/"
          class="group mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent"
        >
          Ver o projeto de controle de notebooks
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            experience.map((item) => (
              <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-fg/85">{item}</li>
            ))
          }
        </ul>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Ferramentas">
          {
            tools.map((t) => (
              <li class="rounded-md bg-white/[0.06] px-2.5 py-1 font-mono text-xs text-muted">{t}</li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  /* No celular, o conteúdo extra fica fechado até o toque; a partir de sm aparece sempre */
  @media (width < 40rem) {
    [data-collapse]:not([data-open]) [data-collapse-body] {
      display: none;
    }

    [data-collapse][data-open] [data-collapse-body] {
      animation: collapse-fade 0.3s ease;
    }
  }

  @keyframes collapse-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-collapse-toggle]').forEach((button) => {
      const card = button.closest<HTMLElement>('[data-collapse]')!;
      button.addEventListener('click', () => {
        const open = card.toggleAttribute('data-open');
        button.setAttribute('aria-expanded', String(open));
      });
    });
  });
</script>
