---
// Fundo estilo painel de BI: gráfico de linhas ondulando + KPIs discretos nas laterais
const kpis = [
  { label: 'Receita', value: 128.4, prefix: 'R$ ', suffix: 'k', decimals: 1, delta: '+8,2%', pos: 'top-[22%] left-6' },
  { label: 'Margem', value: 34.7, suffix: '%', decimals: 1, delta: '+1,4 p.p.', pos: 'top-[62%] left-10' },
  { label: 'Pedidos', value: 2310, decimals: 0, delta: '+12%', pos: 'top-[30%] right-8' },
  { label: 'Ticket médio', value: 55.6, prefix: 'R$ ', decimals: 2, delta: '−0,6%', pos: 'top-[70%] right-6' },
];
---

<div id="bi-bg" transition:persist class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
  <canvas class="h-full w-full"></canvas>

  {
    kpis.map((kpi) => (
      <div
        class={`absolute hidden w-40 rounded-xl border border-white/[0.04] bg-white/[0.015] p-3 min-[1400px]:block ${kpi.pos}`}
      >
        <p class="font-mono text-[10px] tracking-widest text-zinc-500/50 uppercase">{kpi.label}</p>
        <p class="mt-1 font-mono text-xl text-zinc-300/25">
          {kpi.prefix}
          <span data-kpi={kpi.value} data-decimals={kpi.decimals}>
            {kpi.value.toLocaleString('pt-BR', { minimumFractionDigits: kpi.decimals })}
          </span>
          {kpi.suffix}
        </p>
        <p class={`mt-0.5 font-mono text-[10px] ${kpi.delta.startsWith('+') ? 'text-accent-2/40' : 'text-zinc-500/40'}`}>
          {kpi.delta}
        </p>
      </div>
    ))
  }
</div>

<script>
  const root = document.getElementById('bi-bg')!;
  const canvas = root.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cada linha: altura base (0–1 da tela), amplitude, cor, opacidade e ondas que se somam
  const lines = [
    { base: 0.22, amp: 0.05, color: '212 215 221', alpha: 0.07, waves: [[1.1, 0.00012, 0], [2.7, 0.00021, 1.3]] },
    { base: 0.45, amp: 0.07, color: '143 165 187', alpha: 0.1, fill: true, waves: [[0.8, 0.00009, 2.1], [2.1, 0.00017, 0.4]] },
    { base: 0.68, amp: 0.06, color: '212 215 221', alpha: 0.05, waves: [[1.4, 0.00014, 4.2], [3.3, 0.00025, 2.8]] },
    { base: 0.86, amp: 0.05, color: '143 165 187', alpha: 0.07, waves: [[0.9, 0.0001, 5.5], [2.4, 0.0002, 3.6]] },
  ];

  // Linhas-guia horizontais com valores no eixo
  const gridSteps = 6;

  let width = 0;
  let height = 0;

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function drawGrid() {
    ctx.setLineDash([3, 6]);
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgb(255 255 255 / 0.025)';
    ctx.fillStyle = 'rgb(154 156 163 / 0.18)';
    ctx.font = '10px "JetBrains Mono", monospace';
    for (let i = 1; i < gridSteps; i++) {
      const y = (height / gridSteps) * i;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
      ctx.fillText(`${(gridSteps - i) * 20}k`, 8, y - 4);
    }
    ctx.setLineDash([]);
  }

  function draw(time: number) {
    ctx.clearRect(0, 0, width, height);
    drawGrid();

    for (const line of lines) {
      ctx.beginPath();
      for (let x = 0; x <= width; x += 8) {
        const t = (x / width) * Math.PI * 2;
        let offset = 0;
        for (const [freq, speed, phase] of line.waves) {
          offset += Math.sin(t * freq + time * speed + phase);
        }
        const y = height * (line.base + (line.amp * offset) / line.waves.length);
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgb(${line.color} / ${line.alpha})`;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Área sombreada abaixo da linha principal
      if (line.fill) {
        ctx.lineTo(width, height);
        ctx.lineTo(0, height);
        ctx.closePath();
        const grad = ctx.createLinearGradient(0, height * (line.base - line.amp), 0, height);
        grad.addColorStop(0, `rgb(${line.color} / 0.05)`);
        grad.addColorStop(1, `rgb(${line.color} / 0)`);
        ctx.fillStyle = grad;
        ctx.fill();
      }
    }
  }

  function loop(time: number) {
    draw(time);
    requestAnimationFrame(loop);
  }

  resize();
  window.addEventListener('resize', () => {
    resize();
    if (reduce) draw(0);
  });

  if (reduce) draw(0);
  else requestAnimationFrame(loop);

  // KPIs variando levemente, como um painel atualizando
  if (!reduce) {
    const els = root.querySelectorAll<HTMLElement>('[data-kpi]');
    setInterval(() => {
      const el = els[Math.floor(Math.random() * els.length)];
      const base = Number(el.dataset.kpi);
      const decimals = Number(el.dataset.decimals);
      const value = base * (1 + (Math.random() - 0.5) * 0.04);
      el.textContent = value.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    }, 2500);
  }
</script>
