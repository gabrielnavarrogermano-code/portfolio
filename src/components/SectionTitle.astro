---
interface Props {
  index: string;
  label: string;
  title: string;
  subtitle?: string;
}

const { index, label, title, subtitle } = Astro.props;
---

<div data-reveal="left" class="max-w-2xl">
  <p class="font-mono text-sm text-accent">
    {index} <span class="text-muted">/ {label}</span>
  </p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</div>
