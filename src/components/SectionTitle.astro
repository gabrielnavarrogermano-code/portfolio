---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div data-reveal class="max-w-2xl">
  <h2 class="text-3xl font-semibold tracking-tight text-heading sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</div>
