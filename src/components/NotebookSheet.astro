---
// Simulação da planilha de controle de notebooks (dados fictícios).
// Ordem das colunas igual à planilha real. A tabela mostra 15 exemplos; o dashboard calcula sobre as 100 linhas.
import { initial, incoming, records, compute, sectorOrder, donutDash, PEND_TOP, type Example } from '../lib/notebooks';

const cols = ['Nome de usuário', 'E-mail cadastrado', 'Setor', 'Licenças', 'Nome PC', 'Antivírus', 'LAPS', 'Selo de patrimônio', 'Versão Windows'];

// No celular só cabem as colunas principais: e-mail, licença, patrimônio e Windows ficam no computador
const desktopOnly = new Set([1, 3, 7, 8]);

const email = (nome: string) =>
  nome.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(' ', '.') + '@empresa.com.br';

// Texto e tom de cada célula: ok (verde), warn (amarelo, precisa de atenção) ou muted (não se aplica)
type Tone = 'ok' | 'warn' | 'muted' | undefined;
const cell = (e: Example, ci: number): [string, Tone] => {
  const noPc = !e.pc;
  switch (ci) {
    case 0: return [e.nome, undefined];
    case 1: return [email(e.nome), undefined];
    case 2: return [e.setor, undefined];
    case 3: return [e.lic, undefined];
    case 4: return noPc ? ['Sem notebook', 'warn'] : [e.pc, undefined];
    case 5: return noPc ? ['—', 'muted'] : [e.av!, e.av === 'Ativo' ? 'ok' : 'warn'];
    case 6: return noPc ? ['—', 'muted'] : [e.laps!, e.laps === 'Aplicado' ? 'ok' : 'warn'];
    case 7: return noPc ? ['—', 'muted'] : e.pat ? [e.pat, undefined] : ['Sem selo', 'warn'];
    default: return noPc ? ['—', 'muted'] : [e.win!, undefined];
  }
};

const rows = [...initial.map((e) => ({ e, isNew: false })), ...incoming.map((e) => ({ e, isNew: true }))];

// Estado inicial já vem calculado (funciona sem JS): planilha antes dos 3 novos colaboradores
const { t, w } = compute(records.filter((r) => r.n < 0));

const kpis = [
  { label: 'Contas ativas', key: 'contas', sub: 'no Microsoft 365' },
  { label: 'Equipamentos', key: 'equip', sub: 'notebooks da empresa' },
  { label: '% LAPS', key: 'laps', subKey: 'laps:sub' },
  { label: '% Antivírus', key: 'av', subKey: 'av:sub' },
  { label: 'Sem notebook corporativo', key: 'semPc', sub: 'contas' },
  { label: 'Sem selo de patrimônio', key: 'semSelo', sub: 'equipamentos' },
];
const splits = [
  { title: 'Contas ativas por licença', key: 'lic', values: ['Standard', 'Basic'] },
  { title: 'Versão do Windows', key: 'win', values: ['Pro', 'Home'] },
];

// Setores: no celular os 8 maiores ficam à vista, o restante abre em "ver todos"
const SECTORS_VISIBLE = 8;
---

<div data-sheet data-reveal class="relative overflow-hidden rounded-2xl border border-line bg-white/[0.03]">
  <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
    <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
    <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
    <span class="ml-2 truncate font-mono text-xs text-muted">controle-notebooks.xlsx</span>
    <span class="ml-auto flex-none pl-2 text-xs text-muted">dados fictícios</span>
  </div>

  <!-- Aviso de novo colaborador vindo do Microsoft 365 -->
  <div
    data-toast
    aria-live="polite"
    class="sheet-toast absolute top-14 right-4 z-10 rounded-xl border border-line bg-bg px-4 py-3 text-sm shadow-lg"
  >
    <p class="text-xs text-muted">Microsoft 365 · novo colaborador</p>
    <p data-toast-name class="mt-0.5 font-medium text-heading"></p>
  </div>

  <p class="px-4 pt-3 text-sm text-muted">Aba <span class="font-mono text-fg">Base</span></p>

  <div class="overflow-x-auto">
    <table class="w-full text-sm tabular-nums">
      <thead>
        <tr>
          <th class="hidden w-10 border-b border-line px-3 py-2 text-left font-mono text-xs font-normal text-muted/60 sm:table-cell">#</th>
          {cols.map((c, ci) => <th class:list={['border-b border-line px-3 py-2 text-left font-medium whitespace-nowrap text-muted', desktopOnly.has(ci) && 'hidden sm:table-cell']}>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ e, isNew }, i) => (
            <tr data-new={isNew || undefined} hidden={isNew}>
              <td class="hidden border-b border-line px-3 py-2 font-mono text-xs text-muted/60 sm:table-cell">{i + 1}</td>
              {cols.map((_, ci) => {
                const [v, tone] = cell(e, ci);
                return (
                  <td style={`--c: ${ci}`} class:list={['border-b border-line px-3 py-2 whitespace-nowrap text-fg/85', desktopOnly.has(ci) && 'hidden sm:table-cell']}>
                    {tone === 'ok' || tone === 'warn' ? (
                      <span class:list={[tone === 'ok' ? 'text-emerald-400' : 'text-amber-400']}>
                        {tone === 'ok' ? '✓' : '!'} {v}
                      </span>
                    ) : (
                      <span class:list={[tone === 'muted' && 'text-muted/70']}>{v}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="flex flex-wrap justify-between gap-x-4 gap-y-1 px-4 pt-2 pb-3 text-xs text-muted">
    <span>Exibindo <span data-shown>{initial.length}</span> de <span data-m="contas">{t.contas}</span> linhas da planilha</span>
    <span>← arraste a tabela para ver mais →</span>
  </p>

  <!-- Dashboard: recalculado sobre as 100 linhas a cada colaborador novo -->
  <div class="border-t border-line p-3 sm:p-5">
    <p class="text-sm text-muted">Aba <span class="font-mono text-fg">Dashboard</span> · mesmo arquivo, atualiza junto com a base</p>

    <!-- 6 KPIs: 2 colunas no celular, 3 no tablet, 6 no computador -->
    <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {
        kpis.map((k) => (
          <div class="flex flex-col rounded border border-line px-3 py-2.5">
            <p class="text-xs leading-tight text-muted">{k.label}</p>
            <p class="mt-auto pt-1.5">
              <span data-m={k.key} class="sheet-kpi text-xl font-semibold text-heading tabular-nums sm:text-2xl">{t[k.key]}</span>
            </p>
            <p class="text-[11px] text-muted" data-m={k.subKey}>{k.subKey ? t[k.subKey] : k.sub}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-2 grid grid-cols-2 gap-2 lg:grid-cols-3">
      <!-- Licença e Windows: duas categorias cada. Computador: barra dividida; celular: rosquinha com o % no meio -->
      {
        splits.map((c) => (
          <div class="rounded border border-line px-3 py-3">
            <!-- Altura fixa de 2 linhas no celular: as duas rosquinhas ficam alinhadas -->
            <p class="min-h-[2.5em] text-xs leading-tight text-muted sm:min-h-0">{c.title}</p>
            <div class="relative mx-auto mt-2 size-24 sm:hidden" role="img" aria-label={c.values.map((v) => `${v}: ${t[`${c.key}:${v}`]}`).join(', ')}>
              <svg viewBox="0 0 36 36" class="size-full -rotate-90">
                {c.values.map((v, vi) => {
                  const d = donutDash(w[`${c.key}:${c.values[0]}`], vi);
                  return (
                    <circle
                      data-donut={`${c.key}:${c.values[0]}`}
                      data-seg={vi}
                      cx="18"
                      cy="18"
                      r="15.9155"
                      fill="none"
                      stroke-width="3.5"
                      class:list={['sheet-donut', vi === 0 ? 'stroke-accent' : 'stroke-accent/30']}
                      stroke-dasharray={d.dash}
                      stroke-dashoffset={d.offset}
                    />
                  );
                })}
              </svg>
              <span class="absolute inset-0 flex flex-col items-center justify-center leading-none">
                <span data-m={`${c.key}:pct`} class="text-lg font-semibold text-heading tabular-nums">{t[`${c.key}:pct`]}</span>
                <span class="mt-1 text-[10px] text-muted">{c.values[0]}</span>
              </span>
            </div>
            <div class="mt-3 hidden h-2.5 gap-0.5 sm:flex" role="img" aria-label={c.values.map((v) => `${v}: ${t[`${c.key}:${v}`]}`).join(', ')}>
              {c.values.map((v, vi) => (
                <span data-w={`${c.key}:${v}`} class:list={['sheet-bar h-full rounded-sm', vi === 0 ? 'bg-accent' : 'bg-accent/30']} style={`width: ${w[`${c.key}:${v}`]}%`} />
              ))}
            </div>
            <ul class="mt-2.5 space-y-1 text-xs">
              {c.values.map((v, vi) => (
                <li class="flex items-center gap-1.5">
                  <span class:list={['h-2 w-2 flex-none rounded-sm', vi === 0 ? 'bg-accent' : 'bg-accent/30']} />
                  <span class="text-fg/85">{v}</span>
                  <span data-m={`${c.key}:${v}`} class="ml-auto font-mono text-fg/85">{t[`${c.key}:${v}`]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Setores com mais pendências: top 5 -->
      <div class="col-span-2 rounded border border-line px-3 py-3 lg:col-span-1">
        <p class="text-xs leading-tight text-muted">Setores com mais pendências</p>
        <p class="text-[11px] text-muted/70">antivírus inativo, LAPS pendente ou sem selo</p>
        <!-- Celular: ranking numerado com o detalhe de cada tipo à vista (não existe "passar o mouse") -->
        <ol class="mt-1.5 sm:hidden">
          {
            Array.from({ length: PEND_TOP }, (_, i) => (
              <li class="flex items-center gap-3 border-b border-line py-2.5 last:border-0 last:pb-0">
                <span class="w-5 flex-none text-xs text-muted tabular-nums">{i + 1}º</span>
                <div class="min-w-0 flex-1">
                  <p data-m={`pend:${i}:name`} class="truncate text-sm text-fg">{t[`pend:${i}:name`]}</p>
                  <p class="mt-1.5 flex flex-wrap gap-1.5 text-[11px]">
                    {[
                      ['av', 'Antivírus'],
                      ['laps', 'LAPS'],
                      ['selo', 'Selo'],
                    ].map(([k, label]) => (
                      <span data-chip class:list={['rounded border border-line px-1.5 py-0.5 text-muted', t[`pend:${i}:${k}`] === '0' && 'opacity-40']}>
                        {label} <span data-m={`pend:${i}:${k}`} class="font-mono text-fg">{t[`pend:${i}:${k}`]}</span>
                      </span>
                    ))}
                  </p>
                </div>
                <span class="flex flex-none items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-amber-400" />
                  <span data-m={`pend:${i}`} class="text-xl font-semibold text-heading tabular-nums">{t[`pend:${i}`]}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <!-- Computador: barras com o detalhe ao passar o mouse -->
        <ol class="mt-2.5 hidden space-y-2 sm:block">
          {
            Array.from({ length: PEND_TOP }, (_, i) => (
              <li data-tip={`pend:${i}:tip`} title={t[`pend:${i}:tip`]}>
                <div class="flex justify-between gap-2 text-xs">
                  <span data-m={`pend:${i}:name`} class="truncate text-fg/85">{t[`pend:${i}:name`]}</span>
                  <span data-m={`pend:${i}`} class="font-mono text-fg/85">{t[`pend:${i}`]}</span>
                </div>
                <div class="mt-1 h-1.5">
                  <span data-w={`pend:${i}`} class="sheet-bar block h-full rounded-sm bg-amber-400/80" style={`width: ${w[`pend:${i}`]}%`} />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- Contas ativas e dispositivos por setor: barra clara = contas, barra cheia = notebooks -->
    <div class="mt-2 rounded border border-line px-3 py-3">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="text-xs leading-tight text-muted">Contas ativas e dispositivos por setor</p>
        <p class="hidden gap-3 text-[11px] text-muted sm:flex">
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-accent/30" />Contas</span>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-amber-400/70" />Contas (setor com falta de notebook)</span>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-accent" />Dispositivos</span>
        </p>
        <p class="flex gap-3 text-[11px] text-muted sm:hidden">
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-accent/30" />Contas</span>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-accent" />Dispositivos</span>
        </p>
      </div>
      <!-- Computador/tablet: duas colunas finas lado a lado por setor (clara = contas, cheia = notebooks) -->
      <div class="hidden sm:block">
        <div class="mt-2 flex h-48 items-end gap-1 border-b border-line pt-5 pl-8">
          {
            sectorOrder.map((s) => (
              <div data-tip={`set:${s}:tip`} title={t[`set:${s}:tip`]} class="flex h-full min-w-0 flex-1 items-end justify-center gap-1">
                <!-- Contas: só este número fica à vista; dispositivos aparecem ao passar o mouse -->
                <span
                  data-h={`set:${s}:c`}
                  data-gap={`set:${s}:gap`}
                  class:list={['sheet-col sheet-contas relative block w-2.5 flex-none rounded-t-sm', t[`set:${s}:gap`] && 'is-gap']}
                  style={`height: ${w[`set:${s}:c`]}%`}
                >
                  <span data-m={`set:${s}:c`} class="absolute bottom-full left-1/2 mb-1 -translate-x-1/2 font-mono text-[10px] text-muted">{t[`set:${s}:c`]}</span>
                </span>
                <span data-h={`set:${s}:dh`} class="sheet-col block w-2.5 flex-none rounded-t-sm bg-accent" style={`height: ${w[`set:${s}:dh`]}%`} />
              </div>
            ))
          }
        </div>
        <!-- Nomes inclinados para caber todos os setores -->
        <div class="flex h-28 gap-1 pl-8" aria-hidden="true">
          {
            sectorOrder.map((s) => (
              <div class="relative min-w-0 flex-1">
                <span class="absolute top-1.5 right-1/2 origin-top-right -rotate-45 text-[11px] whitespace-nowrap text-fg/85">{s}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Celular: barras deitadas (clara = contas, cheia = notebooks por dentro).
           Aparecem os 8 maiores setores e o restante abre em "ver todos" (sem JS, via checkbox) -->
      <div class="sectors sm:hidden">
        <input type="checkbox" id="sectors-all" class="sectors-toggle sr-only" />
        <ul class="mt-3 grid gap-y-2">
          {
            sectorOrder.map((s, i) => (
              <li data-extra={i >= SECTORS_VISIBLE || undefined}>
                <div class="flex justify-between gap-2 text-xs">
                  <span class="truncate text-fg/85">{s}</span>
                  <span class="flex-none font-mono text-fg/85">
                    <span data-m={`set:${s}:c`}>{t[`set:${s}:c`]}</span>
                    <span class="text-muted/70"> / </span>
                    <span data-m={`set:${s}:d`}>{t[`set:${s}:d`]}</span>
                  </span>
                </div>
                <div class="mt-1 h-1.5" role="img" aria-label={t[`set:${s}:tip`]}>
                  <span data-w={`set:${s}:c`} class="sheet-bar block h-full rounded-sm bg-accent/30" style={`width: ${w[`set:${s}:c`]}%`}>
                    <span data-w={`set:${s}:d`} class="sheet-bar block h-full rounded-sm bg-accent" style={`width: ${w[`set:${s}:d`]}%`} />
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
        <label for="sectors-all" class="sectors-more mt-3 inline-block cursor-pointer text-xs text-muted hover:text-fg">
          <span class="when-closed">Ver todos os {sectorOrder.length} setores ↓</span>
          <span class="when-open">Mostrar menos ↑</span>
        </label>
      </div>
    </div>
  </div>
</div>

<style>
  .sheet-toast {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .sheet-toast.is-on {
    opacity: 1;
    transform: none;
  }

  /* Linha nova: destaque que some e células entrando em sequência */
  tr.is-in {
    animation: row-flash 2.4s ease;
  }

  tr.is-in td {
    animation: cell-in 0.4s ease both;
    animation-delay: calc(var(--c, 0) * 70ms);
  }

  @keyframes row-flash {
    from {
      background: rgb(255 255 255 / 0.1);
    }
  }

  @keyframes cell-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .sheet-bar {
    transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sheet-col {
    transition: height 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Coluna de contas: cinza; âmbar quando o setor tem conta sem notebook */
  .sheet-contas {
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition:
      height 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.4s ease;
  }

  .sheet-contas.is-gap {
    background: color-mix(in srgb, var(--color-amber-400) 70%, transparent);
  }

  .sheet-donut {
    transition:
      stroke-dasharray 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      stroke-dashoffset 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }


  /* Celular: setores extras e o texto do botão dependem do checkbox "ver todos" */
  .sectors:has(.sectors-toggle:checked) .when-closed,
  .sectors:not(:has(.sectors-toggle:checked)) .when-open {
    display: none;
  }

  @media (max-width: 639px) {
    .sectors:not(:has(.sectors-toggle:checked)) [data-extra] {
      display: none;
    }
  }

  .sectors-toggle:focus-visible ~ .sectors-more {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .sheet-kpi.is-bump {
    animation: kpi-bump 0.6s ease;
  }

  @keyframes kpi-bump {
    30% {
      transform: scale(1.12);
    }
  }

  .sheet-kpi {
    display: inline-block;
    transform-origin: left;
  }
</style>

<script>
  import { records, compute, initial, donutDash } from '../lib/notebooks';

  let timer: number | undefined;

  function initSheet() {
    const root = document.querySelector<HTMLElement>('[data-sheet]');
    if (!root) return;

    const toast = root.querySelector<HTMLElement>('[data-toast]')!;
    const toastName = root.querySelector<HTMLElement>('[data-toast-name]')!;
    const shownEl = root.querySelector<HTMLElement>('[data-shown]')!;
    const fresh = [...root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-new]')];
    let next = 0;
    let visible = false;

    // Recalcula o dashboard sobre as linhas da planilha completa, como o Excel faz
    const render = () => {
      const { t, w } = compute(records.filter((r) => r.n < next));
      shownEl.textContent = String(initial.length + next);
      root.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
        const v = t[el.dataset.m!];
        if (v === undefined || el.textContent === v) return;
        el.textContent = v;
        if (!el.classList.contains('sheet-kpi')) return;
        el.classList.remove('is-bump');
        void el.offsetWidth;
        el.classList.add('is-bump');
      });
      root.querySelectorAll<HTMLElement>('[data-w]').forEach((el) => {
        el.style.width = `${w[el.dataset.w!] ?? 0}%`;
      });
      root.querySelectorAll<HTMLElement>('[data-h]').forEach((el) => {
        el.style.height = `${w[el.dataset.h!] ?? 0}%`;
      });
      root.querySelectorAll<HTMLElement>('[data-gap]').forEach((el) => {
        el.classList.toggle('is-gap', !!t[el.dataset.gap!]);
      });
      root.querySelectorAll<SVGCircleElement>('[data-donut]').forEach((el) => {
        const d = donutDash(w[el.dataset.donut!] ?? 0, Number(el.dataset.seg));
        el.setAttribute('stroke-dasharray', d.dash);
        el.setAttribute('stroke-dashoffset', d.offset);
      });
      // Etiquetas de pendência zeradas ficam apagadas
      root.querySelectorAll<HTMLElement>('[data-chip]').forEach((el) => {
        el.classList.toggle('opacity-40', el.querySelector('[data-m]')?.textContent === '0');
      });
      root.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
        el.title = t[el.dataset.tip!] ?? '';
      });
    };

    // Sem animação: mostra direto a planilha completa
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      fresh.forEach((r) => (r.hidden = false));
      next = fresh.length;
      render();
      return;
    }

    // Um passo: avisa o novo colaborador, insere a linha e atualiza o dashboard.
    // Depois do último, espera e volta ao estado inicial para recomeçar.
    const step = () => {
      if (!visible) return;
      if (next < fresh.length) {
        const row = fresh[next];
        toastName.textContent = row.cells[1].textContent;
        toast.classList.add('is-on');
        timer = window.setTimeout(() => {
          // Só avança aqui: se a planilha sair da tela durante o aviso, a mesma linha é retomada
          next++;
          toast.classList.remove('is-on');
          row.hidden = false;
          row.classList.add('is-in');
          render();
          timer = window.setTimeout(step, 3000);
        }, 1400);
      } else {
        timer = window.setTimeout(() => {
          fresh.forEach((r) => {
            r.hidden = true;
            r.classList.remove('is-in');
          });
          next = 0;
          render();
          timer = window.setTimeout(step, 1500);
        }, 3000);
      }
    };

    // Só anima enquanto a planilha está na tela
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        clearTimeout(timer);
        toast.classList.remove('is-on');
        if (visible) timer = window.setTimeout(step, 1200);
      },
      // Limite baixo: com o dashboard, o bloco fica mais alto que a tela do celular
      { threshold: 0.15 },
    ).observe(root);
  }

  document.addEventListener('astro:page-load', initSheet);
  document.addEventListener('astro:before-swap', () => clearTimeout(timer));
</script>
