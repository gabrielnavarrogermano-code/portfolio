---
// Simulação do painel "Usuários Office 365 e Equipamentos" no Power BI (dados fictícios), com as quatro abas do painel
// real (Licenças, Segurança, Custos e Comparação), a barra lateral de filtros e, embaixo, a planilha que alimenta o painel.
// A cada colaborador novo que chega do Microsoft 365, a linha entra na planilha e o painel é recalculado.
// Sem JS, o painel aparece calculado e as abas funcionam (radio + CSS); os filtros precisam do script.
import {
  exemplos,
  chegando,
  registros,
  calcular,
  listaPendencias,
  pendencias,
  rosca,
  ordemSetores,
  MOTIVOS,
  FILTRO_LIC,
  FILTRO_TIPO,
  FILTRO_FALTA,
  WINDOWS,
  AV_SIMULACAO,
  AV_PRECO,
  PRECO,
  SEL_VAZIA,
  brl,
  brl2,
  historico,
  MESES,
  type Rec,
} from '../lib/notebooks';

// Estado inicial: a planilha antes dos colaboradores novos, sem filtros
const inicial = registros.filter((x) => x.n < 0);
const { t, w } = calcular(inicial, SEL_VAZIA);
const pend = listaPendencias(inicial, SEL_VAZIA);

const ABAS = [
  ['lic', 'Licenças'],
  ['seg', 'Segurança'],
  ['cus', 'Custos'],
  ['cmp', 'Comparação'],
] as const;

// ===== Comparação: um gráfico de linha por assunto, com o fechamento de cada mês =====
const hist = historico(inicial);
const [anterior, ultimo] = hist.slice(-2);
const virgula = (v: number, casas = 1) => v.toFixed(casas).replace('.', ',');
const sinal = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + virgula(Math.abs(v));
const totalLic = (m: (typeof hist)[number]) => m.std + m.basic + m.adobe;
const varLic = totalLic(ultimo) - totalLic(anterior);
const varCusto = ((ultimo.custo - anterior.custo) / anterior.custo) * 100;
const varPend = ultimo.pend - anterior.pend;

type Serie = { rotulo: string; cor: string; vals: number[]; fmt: (v: number) => string };
// Posições em % (x da esquerda, y do topo) para o SVG esticado e para os pontos e valores em HTML por cima,
// assim o texto não deforma quando o gráfico muda de largura
function grafico(series: Serie[]) {
  const todos = series.flatMap((s) => s.vals);
  const min = Math.min(...todos);
  const max = Math.max(...todos);
  const folga = (max - min || 1) * 0.25;
  const lo = min - folga;
  const hi = max + folga;
  return series.map((s) => {
    const pts = s.vals.map((v, i) => ({ x: 5 + (i * 90) / (s.vals.length - 1), y: 100 - ((v - lo) / (hi - lo)) * 100, txt: s.fmt(v) }));
    return { ...s, pts, d: `M ${pts.map((p) => `${p.x} ${p.y}`).join(' L ')}` };
  });
}
const descrever = (series: Serie[]) => series.map((s) => `${s.rotulo}: ${s.vals.map((v, i) => `${MESES[i]} ${s.fmt(v)}`).join(', ')}`).join('. ');

const SERIES_LIC: Serie[] = [
  { rotulo: 'Standard', cor: 'ouro', vals: hist.map((m) => m.std), fmt: String },
  { rotulo: 'Basic', cor: 'prata', vals: hist.map((m) => m.basic), fmt: String },
  { rotulo: 'Adobe', cor: 'roxo', vals: hist.map((m) => m.adobe), fmt: String },
];
const SERIES_CUS: Serie[] = [{ rotulo: 'Custo por mês', cor: 'ciano', vals: hist.map((m) => m.custo), fmt: (v) => `${virgula(v / 1000)} mil` }];
const SERIES_PEND: Serie[] = [{ rotulo: 'Equipamentos com pendência', cor: 'vermelho', vals: hist.map((m) => m.pend), fmt: (v) => `${Math.round(v)}%` }];
const comparacoes = [
  {
    titulo: 'Licenças por mês',
    sub: `quantidade de contas em cada licença · nov × out: ${varLic > 0 ? '+' : ''}${varLic} ${Math.abs(varLic) === 1 ? 'licença' : 'licenças'}`,
    series: SERIES_LIC,
    largo: true,
  },
  { titulo: 'Custo de licenças por mês', sub: `R$ por mês · nov × out: ${sinal(varCusto)}%`, series: SERIES_CUS },
  { titulo: 'Pendências de segurança por mês', sub: `% dos equipamentos com alguma pendência · nov × out: ${sinal(varPend)} p.p.`, series: SERIES_PEND },
];

type Kpi = { rotulo: string; sub?: string; subKey?: string; key: string; st?: boolean };
const kpis: Record<'lic' | 'seg' | 'cus', Kpi[]> = {
  lic: [
    { rotulo: 'Contas ativas', subKey: 'lic:contas:sub', key: 'lic:contas' },
    { rotulo: 'M365 Empresas (Standard)', key: 'lic:std' },
    { rotulo: 'M365 Empresas Basic', key: 'lic:basic' },
    { rotulo: 'Adobe Acrobat Pro', key: 'lic:adobe' },
    { rotulo: 'Antivírus (Kaspersky)', key: 'lic:av' },
  ],
  seg: [
    { rotulo: 'Equipamentos sem LAPS', subKey: 'seg:laps:sub', key: 'seg:laps', st: true },
    { rotulo: 'Equipamentos sem antivírus', subKey: 'seg:av:sub', key: 'seg:av', st: true },
    { rotulo: 'Windows 11 HOME', sub: 'precisam virar PRO para usar o LAPS', key: 'seg:home', st: true },
    { rotulo: 'Windows 10', sub: 'fora do suporte da Microsoft desde 14/10/2025', key: 'seg:w10', st: true },
    { rotulo: 'Windows PRO sem LAPS', sub: 'Windows PRO: dá para instalar o LAPS já', key: 'seg:prolaps', st: true },
    { rotulo: 'Contas em computador particular', sub: 'usam computador próprio · sem antivírus nem LAPS da empresa', key: 'seg:part', st: true },
  ],
  cus: [
    { rotulo: 'Custo anual total de licenças', sub: 'M365 + Adobe + antivírus (÷ 3 anos)', key: 'cus:total' },
    { rotulo: 'Custo por mês', sub: 'custo anual ÷ 12', key: 'cus:mes' },
    { rotulo: 'Custo por conta ativa', sub: 'custo anual de licenças ÷ contas ativas', key: 'cus:conta' },
    { rotulo: 'Antivírus (contrato de 3 anos)', subKey: 'cus:avc:sub', key: 'cus:avc' },
  ],
};

// Partes das barras empilhadas (chave, texto e a cor fixa de cada licença, igual em todas as abas)
const PARTES_LIC = [
  ['std', 'Contas Standard', 'nb-ouro'],
  ['basic', 'Contas Basic', 'nb-prata'],
  ['adobe', 'Contas Adobe', 'nb-roxo'],
] as const;
const PARTES_CUS = [
  ['m365', 'Custo M365 (ano)', 'nb-ouro'],
  ['adobe', 'Custo Adobe (ano)', 'nb-roxo'],
  ['av', 'Custo antivírus (ano)', 'nb-ciano'],
] as const;
const FATIAS = [
  ['std', 'M365 Standard', 'nb-ouro'],
  ['adobe', 'Adobe', 'nb-roxo'],
  ['av', 'Antivírus', 'nb-ciano'],
  ['basic', 'M365 Basic', 'nb-prata'],
] as const;
const arcos = rosca(FATIAS.map(([k]) => w[`cus:don:${k}`]));

const precos = `Standard ${brl2(PRECO.Standard)} · Basic ${brl2(PRECO.Basic)} · Adobe ${brl2(PRECO.Adobe)} por conta por ano · antivírus ${brl2(AV_PRECO)} por equipamento a cada 3 anos`;

// A planilha: as últimas linhas, onde entram os colaboradores novos
const COLS = ['Nome dos usuários', 'E-mail', 'Centro de custo', 'Função', 'Licenças', 'Nome PC', 'Com antivírus', 'Com LAPS', 'Motivo sem equipamento', 'Selo de patrimônio', 'Versão Windows'];
// No celular só cabem as colunas principais
const SO_TELA_LARGA = new Set([1, 3, 4, 8, 9, 10]);
const celula = (x: Rec, c: number): [string, string?] => {
  const sem = !x.pc;
  switch (c) {
    case 0: return [x.nome];
    case 1: return [x.email];
    case 2: return [x.setor];
    case 3: return [x.funcao || '—', x.funcao ? undefined : 'nb-apagado'];
    case 4: return [`Microsoft 365 Empresas${x.lic === 'Basic' ? ' Basic' : ''}${x.adobe ? '; Adobe Acrobat Pro' : ''}`];
    case 5: return sem ? ['—', 'nb-apagado'] : [x.pc];
    case 6: return sem ? ['—', 'nb-apagado'] : x.av ? ['SIM', 'nb-ok'] : ['NÃO', 'nb-ruim'];
    case 7: return sem ? ['—', 'nb-apagado'] : x.laps ? ['SIM', 'nb-ok'] : ['NÃO', 'nb-ruim'];
    case 8: return sem ? [MOTIVOS.find(([k]) => k === x.motivo)![1]] : ['—', 'nb-apagado'];
    case 9: return sem ? ['—', 'nb-apagado'] : [x.selo];
    default: return sem ? ['—', 'nb-apagado'] : [x.win!];
  }
};
const linhas = [...exemplos.map((x) => ({ x, nova: false })), ...chegando.map((x) => ({ x, nova: true }))];
const primeiraLinha = inicial.length - exemplos.length + 2; // + 1 do cabeçalho da planilha
---

<div data-sheet class="nb">
  <div class="nb-janela">
    <span></span><span></span><span></span>
    <span class="nb-arquivo">usuarios-office365.pbix</span>
    <span class="ml-auto">Power BI</span>
  </div>

  <div class="nb-relatorio">
    <!-- As abas do relatório: radios no início, para o CSS mostrar só a página escolhida -->
    {ABAS.map(([k], i) => <input type="radio" name="nb-aba" id={`nb-pg-${k}`} value={k} checked={i === 0} class="nb-aba-input sr-only" />)}

    <!-- Barra lateral de filtros, como no painel real. No celular, abre pelo botão Filtros -->
    <aside id="nb-filtros" data-painel class="nb-lateral">
      <div class="flex items-center justify-between">
        <p class="nb-lateral-titulo">Filtros</p>
        <button type="button" data-fechar class="nb-fechar" aria-label="Fechar filtros">×</button>
      </div>

      <label class="nb-filtro">
        <span class="nb-filtro-nome">Setor</span>
        <select data-f="setor" class="nb-select">
          <option value="">Todos</option>
          {ordemSetores.map((s) => <option value={s}>{s.replace('⚠ ', '')}</option>)}
        </select>
      </label>

      <!-- Filtros de cada aba: só os que fazem sentido nela -->
      <fieldset class="nb-filtro" data-para="lic">
        <legend class="nb-filtro-nome">Licença</legend>
        {FILTRO_LIC.map(([v, rotulo]) => <label class="nb-check"><input type="checkbox" data-f="lic" value={v} />{rotulo}</label>)}
      </fieldset>
      <fieldset class="nb-filtro" data-para="lic">
        <legend class="nb-filtro-nome">Tipo de conta</legend>
        {FILTRO_TIPO.map((v) => <label class="nb-check"><input type="checkbox" data-f="tipo" value={v} />{v}</label>)}
      </fieldset>
      <fieldset class="nb-filtro" data-para="seg">
        <legend class="nb-filtro-nome">Versão do Windows</legend>
        {WINDOWS.map((v) => <label class="nb-check"><input type="checkbox" data-f="win" value={v} />{v}</label>)}
      </fieldset>
      <fieldset class="nb-filtro" data-para="seg">
        <legend class="nb-filtro-nome">O que falta no equipamento</legend>
        {FILTRO_FALTA.map(([v, rotulo]) => <label class="nb-check"><input type="checkbox" data-f="falta" value={v} />{rotulo}</label>)}
      </fieldset>
      <label class="nb-filtro" data-para="cus">
        <span class="nb-filtro-nome">Custo antivírus (simulação)</span>
        <select data-f="av" class="nb-select">
          <option value="">Todos ({brl(AV_PRECO)})</option>
          {AV_SIMULACAO.map((v) => <option value={v}>{brl(v)}</option>)}
        </select>
      </label>

      <p class="nb-filtro nb-filtro-nota" data-para="cmp">A comparação usa o fechamento de cada mês da planilha inteira, por isso não tem filtros.</p>

      <div class="nb-aviso" data-sem-cmp>
        <p data-aviso aria-live="polite">Sem filtros ativos – os números referem-se ao total</p>
        <button type="button" data-limpar hidden class="nb-limpar">Limpar filtros</button>
      </div>
    </aside>

    <div class="nb-main">
      <!-- Cabeçalho: título, nome da aba e o aviso de colaborador novo -->
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="nb-titulo">Usuários Office 365 e Equipamentos</p>
          <p class="nb-sub">
            {ABAS.map(([k, rotulo]) => <span data-pg={k}>{rotulo}</span>)}
            <span data-atualizado aria-live="polite" class="nb-atualizado"></span>
          </p>
        </div>
        <button type="button" data-abrir aria-expanded="false" aria-controls="nb-filtros" class="nb-botao-filtros">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
          Filtros <span data-contador hidden class="nb-contador"></span>
        </button>
      </div>

      <!-- ===== Licenças: só quantidades ===== -->
      <div data-pg="lic" class="nb-pagina">
        <div class="nb-kpis nb-kpis-5">
          {kpis.lic.map((k) => (
            <div class="nb-card nb-kpi">
              <p class="nb-kpi-rotulo">{k.rotulo}</p>
              {(k.sub || k.subKey) && <p class="nb-kpi-sub" data-m={k.subKey}>{k.subKey ? t[k.subKey] : k.sub}</p>}
              <p data-m={k.key} class="nb-kpi-valor">{t[k.key]}</p>
            </div>
          ))}
        </div>

        <div class="nb-grade-lic">
          <!-- Licenças por setor: Standard, Basic e Adobe empilhadas, do setor com mais contas para o com menos -->
          <div class="nb-card">
            <p class="nb-card-titulo">Licenças por setor</p>
            <p class="nb-card-sub">Contas com Standard, Basic e Adobe em cada setor</p>
            <p class="nb-legenda">{PARTES_LIC.map(([, rotulo, cor]) => <span><i class={cor} />{rotulo}</span>)}</p>
            <ul class="nb-barras">
              {ordemSetores.map((s) => (
                <li data-tip={`lic:set:${s}:tip`} title={t[`lic:set:${s}:tip`]}>
                  <span class="nb-barra-nome">{s}</span>
                  <span class="nb-barra-trilho">
                    <span data-w={`lic:set:${s}`} class="nb-barra" style={`width: ${w[`lic:set:${s}`]}%`}>
                      {PARTES_LIC.map(([k, , cor]) => (
                        <span data-w={`lic:set:${s}:${k}`} class:list={['nb-parte', cor]} style={`width: ${w[`lic:set:${s}:${k}`]}%`}>
                          <span data-m={`lic:set:${s}:${k}`}>{t[`lic:set:${s}:${k}`]}</span>
                        </span>
                      ))}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Licenças que podem ser revistas: só quantidades, e o motivo das Standard sem equipamento -->
          <div class="flex min-w-0 flex-col gap-2">
            <div class="nb-card nb-kpi">
              <p class="nb-kpi-rotulo">Standard que podem ser revistas</p>
              <p class="nb-kpi-sub">sem notebook da empresa · poderiam ser Basic</p>
              <p data-m="lic:rev" class="nb-kpi-valor">{t['lic:rev']}</p>
            </div>
            <div class="nb-card nb-kpi">
              <p class="nb-kpi-rotulo">Contas não pessoais com licença paga</p>
              <p class="nb-kpi-sub">contas administradoras e dispositivos compartilhados</p>
              <p data-m="lic:np" class="nb-kpi-valor">{t['lic:np']}</p>
            </div>
            <div class="nb-card flex-1">
              <p class="nb-card-titulo">Por que essas Standard não têm equipamento</p>
              <p class="nb-card-sub">Contas Standard sem notebook da empresa, por motivo · passe o mouse para ver quem são</p>
              <ul class="nb-barras nb-barras-motivo">
                {MOTIVOS.map(([k, rotulo]) => (
                  <li data-tip={`lic:mot:${k}:tip`} title={t[`lic:mot:${k}:tip`]}>
                    <span class="nb-barra-nome">{rotulo}</span>
                    <span class="nb-barra-trilho">
                      <span data-w={`lic:mot:${k}`} class="nb-barra nb-ouro" style={`width: ${w[`lic:mot:${k}`]}%`} />
                      <span data-m={`lic:mot:${k}`} class="nb-barra-valor">{t[`lic:mot:${k}`]}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== Segurança ===== -->
      <div data-pg="seg" class="nb-pagina">
        <div class="nb-kpis nb-kpis-6">
          {kpis.seg.map((k) => (
            <div class="nb-card nb-kpi">
              <p class="nb-kpi-rotulo">{k.rotulo}</p>
              <p class="nb-kpi-sub" data-m={k.subKey}>{k.subKey ? t[k.subKey] : k.sub}</p>
              <p data-m={k.key} data-st={`${k.key}:st`} data-estado={t[`${k.key}:st`]} class="nb-kpi-valor nb-estado">{t[k.key]}</p>
            </div>
          ))}
        </div>

        <!-- Equipamentos por setor: com pendência (embaixo) e sem pendência, em colunas empilhadas -->
        <div class="nb-card mt-2">
          <p class="nb-card-titulo">Equipamentos por setor</p>
          <p class="nb-card-sub">Com pendência = sem LAPS, sem antivírus ou Windows HOME · passe o mouse para ver os equipamentos</p>
          <p class="nb-legenda"><span><i class="nb-vermelho" />Com pendência de segurança</span><span><i class="nb-ouro" />Sem pendência de segurança</span></p>
          <div class="nb-colunas-rolagem">
            <ul class="nb-colunas">
              {ordemSetores.map((s) => (
                <li data-tip={`seg:set:${s}:tip`} title={t[`seg:set:${s}:tip`]}>
                  <span class="nb-coluna">
                    <span data-h={`seg:set:${s}:sem`} class="nb-coluna-parte nb-ouro" style={`height: ${w[`seg:set:${s}:sem`]}%`}><span data-m={`seg:set:${s}:sem`}>{t[`seg:set:${s}:sem`]}</span></span>
                    <span data-h={`seg:set:${s}:com`} class="nb-coluna-parte nb-vermelho" style={`height: ${w[`seg:set:${s}:com`]}%`}><span data-m={`seg:set:${s}:com`}>{t[`seg:set:${s}:com`]}</span></span>
                  </span>
                  <span class="nb-coluna-nome">{s.replace('⚠ ', '')}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- A lista dos equipamentos com pendência de segurança -->
        <div class="nb-card mt-2">
          <p class="nb-card-titulo">Equipamentos com pendência de segurança</p>
          <div class="nb-tabela-rolagem">
            <table class="nb-tabela">
              <thead>
                <tr><th>Nome dos usuários</th><th>Centro de custo</th><th>Nome PC</th><th>Windows</th><th>Status LAPS</th><th>Status antivírus</th><th>Pendências de segurança</th></tr>
              </thead>
              <tbody data-pendencias>
                {pend.map((x) => (
                  <tr>
                    <td>{x.nome}</td><td>{x.setor}</td><td>{x.pc}</td><td>{x.win}</td>
                    <td class={x.laps ? 'nb-ok' : 'nb-ruim'}>{x.laps ? 'Com LAPS' : 'Sem LAPS'}</td>
                    <td class={x.av ? 'nb-ok' : 'nb-ruim'}>{x.av ? 'Com antivírus' : 'Sem antivírus'}</td>
                    <td>{pendencias(x)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===== Custos: só valores em R$ ===== -->
      <div data-pg="cus" class="nb-pagina">
        <div class="nb-kpis nb-kpis-4">
          {kpis.cus.map((k) => (
            <div class="nb-card nb-kpi">
              <p class="nb-kpi-rotulo">{k.rotulo}</p>
              <p class="nb-kpi-sub" data-m={k.subKey}>{k.subKey ? t[k.subKey] : k.sub}</p>
              <p data-m={k.key} class="nb-kpi-valor nb-kpi-dinheiro">{t[k.key]}</p>
            </div>
          ))}
        </div>

        <div class="nb-grade-cus">
          <!-- Custo anual por setor: M365, Adobe e antivírus (÷ 3 anos), com o valor escrito na barra -->
          <div class="nb-card">
            <p class="nb-card-titulo">Custo anual de licenças por setor</p>
            <p class="nb-card-sub">M365 + Adobe + antivírus (÷ 3 anos) · valores em milhares de reais</p>
            <p class="nb-legenda">{PARTES_CUS.map(([, rotulo, cor]) => <span><i class={cor} />{rotulo}</span>)}</p>
            <ul class="nb-barras">
              {ordemSetores.map((s) => (
                <li data-tip={`cus:set:${s}:tip`} title={t[`cus:set:${s}:tip`]}>
                  <span class="nb-barra-nome">{s}</span>
                  <span class="nb-barra-trilho">
                    <span data-w={`cus:set:${s}`} class="nb-barra" style={`width: ${w[`cus:set:${s}`]}%`}>
                      {PARTES_CUS.map(([k, , cor]) => (
                        <span data-w={`cus:set:${s}:${k}`} class:list={['nb-parte', cor]} style={`width: ${w[`cus:set:${s}:${k}`]}%`}>
                          <span data-m={`cus:set:${s}:${k}`}>{t[`cus:set:${s}:${k}`]}</span>
                        </span>
                      ))}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex min-w-0 flex-col gap-2">
            <!-- Para onde vai o dinheiro: rosca com o valor e o % de cada licença -->
            <div class="nb-card">
              <p class="nb-card-titulo">Para onde vai o dinheiro (R$ por ano)</p>
              <p class="nb-card-sub">Preços fictícios: {precos}</p>
              <div class="nb-rosca">
                <svg viewBox="0 0 36 36" class="nb-rosca-svg" aria-hidden="true">
                  {FATIAS.map(([k, , cor], i) => (
                    <circle data-fatia={k} cx="18" cy="18" r="15.9155" fill="none" stroke-width="5.5" class:list={['nb-fatia', cor]} stroke-dasharray={arcos[i].dash} stroke-dashoffset={arcos[i].offset} />
                  ))}
                </svg>
                <ul class="nb-rosca-legenda">
                  {FATIAS.map(([k, rotulo, cor]) => (
                    <li>
                      <i class={cor} />
                      <span>{rotulo}</span>
                      <span class="nb-rosca-valor"><span data-m={`cus:don:${k}`}>{t[`cus:don:${k}`]}</span> (<span data-m={`cus:don:${k}:pct`}>{t[`cus:don:${k}:pct`]}</span>)</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Custo por conta ativa por setor -->
            <div class="nb-card flex-1">
              <p class="nb-card-titulo">Custo por conta ativa por setor (R$ por ano)</p>
              <p class="nb-card-sub">Custo anual de licenças do setor ÷ contas ativas do setor · passe o mouse para ver a conta</p>
              <ul class="nb-barras nb-barras-compactas">
                {ordemSetores.map((s) => (
                  <li data-tip={`cus:cc:${s}:tip`} title={t[`cus:cc:${s}:tip`]}>
                    <span class="nb-barra-nome">{s}</span>
                    <span class="nb-barra-trilho">
                      <span data-w={`cus:cc:${s}`} class="nb-barra nb-ouro" style={`width: ${w[`cus:cc:${s}`]}%`} />
                      <span data-m={`cus:cc:${s}`} class="nb-barra-valor">{t[`cus:cc:${s}`]}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== Comparação: o fechamento de cada mês, sem filtros ===== -->
      <div data-pg="cmp" class="nb-pagina">
        <div class="nb-grade-cmp">
          {comparacoes.map((g) => (
            <div class:list={['nb-card', g.largo && 'nb-cmp-largo']}>
              <p class="nb-card-titulo">{g.titulo}</p>
              <p class="nb-card-sub">{g.sub}</p>
              {g.series.length > 1 && <p class="nb-legenda">{g.series.map((s) => <span><i style={`background: var(--nb-${s.cor})`} />{s.rotulo}</span>)}</p>}
              <div class="nb-lg" role="img" aria-label={`${g.titulo}. ${descrever(g.series)}`}>
                <div class="nb-lg-area">
                  <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="nb-lg-svg" aria-hidden="true">
                    {[0, 50, 100].map((y) => <line x1="0" x2="100" y1={y} y2={y} class="nb-lg-guia" vector-effect="non-scaling-stroke" />)}
                    {grafico(g.series).map((s) => <path d={s.d} fill="none" class="nb-lg-traco" style={`stroke: var(--nb-${s.cor})`} vector-effect="non-scaling-stroke" />)}
                  </svg>
                  {grafico(g.series).map((s) =>
                    s.pts.map((p, i) => (
                      <span class:list={['nb-lg-ponto', i === s.pts.length - 1 && 'is-ultimo']} style={`left: ${p.x}%; top: ${p.y}%; --cor: var(--nb-${s.cor})`}>
                        <b>{p.txt}</b>
                      </span>
                    )),
                  )}
                </div>
                <div class="nb-lg-meses" aria-hidden="true">
                  {MESES.map((m, i) => <span style={`left: ${5 + (i * 90) / (MESES.length - 1)}%`}>{m}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- As abas no rodapé, como no Power BI -->
      <div role="radiogroup" aria-label="Abas do relatório" class="nb-abas">
        {ABAS.map(([k, rotulo]) => <label for={`nb-pg-${k}`} class="nb-aba">{rotulo}</label>)}
      </div>
    </div>
  </div>

  <!-- A planilha que alimenta o painel: as últimas linhas, onde entram os colaboradores novos -->
  <div class="nb-planilha">
    <div class="nb-janela">
      <span></span><span></span><span></span>
      <span class="nb-arquivo">usuarios_office365.xlsx</span>
      <span class="ml-auto">fonte de dados</span>
    </div>

    <div data-aviso-novo aria-live="polite" class="nb-aviso-novo">
      <p class="text-xs text-muted">Microsoft 365 · novo colaborador</p>
      <p data-aviso-nome class="mt-0.5 font-medium text-heading"></p>
    </div>

    <p class="px-4 pt-3 text-sm text-muted">Aba <span class="font-mono text-fg">usuarios_office365</span> · últimas linhas</p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm tabular-nums">
        <thead>
          <tr>
            <th class="nb-num hidden sm:table-cell">#</th>
            {COLS.map((c, ci) => <th class:list={['nb-th', SO_TELA_LARGA.has(ci) && 'hidden sm:table-cell']}>{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {linhas.map(({ x, nova }, i) => (
            <tr data-nova={nova || undefined} hidden={nova}>
              <td class="nb-num hidden sm:table-cell">{primeiraLinha + i}</td>
              {COLS.map((_, ci) => {
                const [v, tom] = celula(x, ci);
                return <td style={`--c: ${ci}`} class:list={['nb-td', tom, SO_TELA_LARGA.has(ci) && 'hidden sm:table-cell']}>{v}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="flex flex-wrap justify-between gap-x-4 gap-y-1 px-4 pt-2 pb-3 text-xs text-muted">
      <span>Exibindo <span data-exibindo data-base={exemplos.length}>{exemplos.length}</span> de <span data-total>{inicial.length}</span> linhas da planilha</span>
      <span class="sm:hidden">← arraste a tabela para ver mais →</span>
    </p>
  </div>
</div>

<style>
  /* ---------- Cores do painel (as mesmas do painel real) ---------- */
  .nb {
    --nb-fundo: #0d1330;
    --nb-card: #141c40;
    --nb-linha: rgb(255 255 255 / 0.08);
    --nb-texto: #e9ecf5;
    --nb-apagado: #a3abc4;
    --nb-ouro: #d4a84b;
    --nb-prata: #b8bfcc;
    --nb-roxo: #c77dff;
    --nb-ciano: #4fc3f7;
    --nb-vermelho: #ff6170;
    --nb-verde: #4cc38a;
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--color-line);
    background: var(--nb-fundo);
    color: var(--nb-texto);
  }

  .nb-ouro { background: var(--nb-ouro); stroke: var(--nb-ouro); }
  .nb-prata { background: var(--nb-prata); stroke: var(--nb-prata); }
  .nb-roxo { background: var(--nb-roxo); stroke: var(--nb-roxo); }
  .nb-ciano { background: var(--nb-ciano); stroke: var(--nb-ciano); }
  .nb-vermelho { background: var(--nb-vermelho); }

  /* Barra de título da janela (o arquivo do Power BI e o da planilha) */
  .nb-janela {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--nb-linha);
    font-size: 0.75rem;
    color: var(--nb-apagado);
  }

  .nb-janela > span:nth-child(-n + 3) {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--nb-linha);
    border-radius: 9999px;
  }

  .nb-arquivo {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
  }

  /* ---------- Relatório: barra lateral de filtros + página ---------- */
  .nb-relatorio {
    position: relative;
    display: grid;
  }

  @media (min-width: 64rem) {
    .nb-relatorio {
      grid-template-columns: 12.5rem minmax(0, 1fr);
    }
  }

  /* Só a aba escolhida aparece (sem suporte a :has, todas ficam à vista) */
  .nb-relatorio:has(#nb-pg-seg:checked) [data-pg]:not([data-pg='seg']),
  .nb-relatorio:has(#nb-pg-cus:checked) [data-pg]:not([data-pg='cus']),
  .nb-relatorio:has(#nb-pg-cmp:checked) [data-pg]:not([data-pg='cmp']),
  .nb-relatorio:not(:has(#nb-pg-seg:checked, #nb-pg-cus:checked, #nb-pg-cmp:checked)) [data-pg]:not([data-pg='lic']),
  .nb-relatorio:has(#nb-pg-seg:checked) [data-para]:not([data-para='seg']),
  .nb-relatorio:has(#nb-pg-cus:checked) [data-para]:not([data-para='cus']),
  .nb-relatorio:has(#nb-pg-cmp:checked) [data-para]:not([data-para='cmp']),
  .nb-relatorio:not(:has(#nb-pg-seg:checked, #nb-pg-cus:checked, #nb-pg-cmp:checked)) [data-para]:not([data-para='lic']),
  /* Na Comparação não há filtros: some também o de setor e o aviso de filtros ativos */
  .nb-relatorio:has(#nb-pg-cmp:checked) .nb-filtro:not([data-para]),
  .nb-relatorio:has(#nb-pg-cmp:checked) [data-sem-cmp] {
    display: none;
  }

  .nb-filtro-nota {
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* A barra lateral, em papel (como no painel real): filtros em cartões brancos */
  .nb-lateral {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem;
    background: var(--color-sunset);
    color: var(--color-navy);
  }

  .nb-lateral-titulo {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nb-fechar {
    display: none;
    padding: 0 0.4rem;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .nb-filtro {
    display: block;
    margin: 0;
    padding: 0.55rem 0.65rem;
    border: 0;
    border-radius: 0.5rem;
    background: #fbfaf7;
    box-shadow: inset 0 0 0 1px rgb(20 25 55 / 0.1);
  }

  .nb-filtro-nome {
    display: block;
    padding: 0;
    margin-bottom: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .nb-select {
    width: 100%;
    padding: 0.25rem 0.4rem;
    border: 1px solid rgb(20 25 55 / 0.25);
    border-radius: 0.25rem;
    background: white;
    font-size: 0.75rem;
    color: var(--color-navy);
    cursor: pointer;
  }

  .nb-check {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .nb-check input {
    accent-color: var(--color-navy);
  }

  .nb-aviso {
    margin-top: auto;
    padding: 0.65rem;
    border-radius: 0.5rem;
    background: #fbfaf7;
    box-shadow: inset 0 0 0 1px rgb(20 25 55 / 0.1);
    font-size: 0.6875rem;
    line-height: 1.4;
    text-align: center;
  }

  .nb-aviso .is-ativo {
    color: #a24e00;
    font-weight: 600;
  }

  .nb-limpar {
    margin-top: 0.4rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* Celular e tablet: a barra lateral vira um painel por cima, aberto pelo botão Filtros */
  @media (max-width: 63.99rem) {
    .nb-lateral {
      position: absolute;
      inset: 0 0 auto auto;
      z-index: 20;
      width: min(18rem, 100%);
      min-height: 100%;
      box-shadow: -12px 0 32px rgb(0 0 0 / 0.4);
    }

    .nb-lateral:not(.is-aberta) {
      display: none;
    }

    .nb-fechar {
      display: block;
    }
  }

  .nb-botao-filtros {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--nb-linha);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    color: var(--nb-texto);
    cursor: pointer;
  }

  .nb-botao-filtros.is-ativo {
    border-color: var(--nb-ouro);
  }

  .nb-contador {
    padding: 0 0.35rem;
    border-radius: 9999px;
    background: var(--nb-ouro);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1rem;
    color: var(--nb-fundo);
  }

  @media (min-width: 64rem) {
    .nb-botao-filtros {
      display: none;
    }
  }

  /* ---------- A página ---------- */
  .nb-main {
    min-width: 0;
    padding: 0.9rem 0.9rem 0;
  }

  .nb-titulo {
    font-size: 1.05rem;
    font-weight: 700;
    color: white;
  }

  .nb-sub {
    font-size: 0.75rem;
    color: var(--nb-apagado);
  }

  .nb-atualizado:not(:empty)::before {
    content: ' · ';
  }

  .nb-atualizado {
    color: var(--nb-ouro);
  }

  .nb-pagina {
    margin-top: 0.75rem;
  }

  .nb-card {
    min-width: 0;
    padding: 0.7rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--nb-card);
  }

  .nb-card-titulo {
    font-size: 0.8125rem;
    font-weight: 700;
    color: white;
  }

  .nb-card-sub {
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--nb-apagado);
  }

  /* ---------- Cards de número ---------- */
  .nb-kpis {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 40rem) {
    .nb-kpis-5,
    .nb-kpis-6 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .nb-kpis-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .nb-kpis-5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .nb-kpis-6 {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .nb-kpi {
    display: flex;
    flex-direction: column;
  }

  .nb-kpi-rotulo {
    font-size: 0.6875rem;
    line-height: 1.3;
    color: #d5daea;
  }

  .nb-kpi-sub {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 0.625rem;
    line-height: 1.3;
    color: var(--nb-apagado);
  }

  .nb-kpi-valor {
    margin-top: auto;
    padding-top: 0.3rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    color: white;
    font-variant-numeric: tabular-nums;
  }

  .nb-kpi-dinheiro {
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    white-space: nowrap;
  }

  /* Indicador de pendência: vermelho com algum equipamento, verde (e ✓) com zero */
  .nb-estado[data-estado='ruim'] {
    color: var(--nb-vermelho);
  }

  .nb-estado[data-estado='bom'] {
    color: var(--nb-verde);
  }

  .nb-estado[data-estado='bom']::after {
    content: ' ✓';
    font-size: 0.6em;
  }

  .nb-kpi-valor.is-pulo {
    animation: nb-pulo 0.6s ease;
  }

  @keyframes nb-pulo {
    30% {
      transform: scale(1.12);
    }
  }

  /* ---------- Legendas e barras horizontais ---------- */
  .nb-legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    margin-top: 0.45rem;
    font-size: 0.6875rem;
    color: #d5daea;
  }

  .nb-legenda span,
  .nb-rosca-legenda li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nb-legenda i,
  .nb-rosca-legenda i {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-radius: 9999px;
  }

  .nb-barras {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .nb-barras li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  .nb-barras-motivo {
    gap: 0.6rem;
  }

  .nb-barras-motivo li {
    grid-template-columns: 9rem minmax(0, 1fr);
  }

  .nb-barras-compactas {
    gap: 0.2rem;
  }

  .nb-barra-nome {
    overflow: hidden;
    font-size: 0.6875rem;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #d5daea;
  }

  .nb-barra-trilho {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    padding-right: 3.5rem;
  }

  .nb-barra {
    display: flex;
    flex: none;
    height: 1rem;
    overflow: hidden;
    border-radius: 0.15rem;
    transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nb-barras-compactas .nb-barra {
    height: 0.75rem;
  }

  .nb-parte {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 0.625rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--nb-fundo);
    transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nb-parte + .nb-parte {
    border-left: 1px solid var(--nb-card);
  }

  .nb-barra-valor {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Colunas (equipamentos por setor) ---------- */
  .nb-colunas-rolagem {
    overflow-x: auto;
  }

  .nb-colunas {
    display: grid;
    grid-auto-columns: minmax(2.6rem, 1fr);
    grid-auto-flow: column;
    gap: 0.4rem;
    min-width: 46rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .nb-colunas li {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
  }

  .nb-coluna {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 8.5rem;
  }

  .nb-coluna-parte {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--nb-fundo);
    transition: height 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nb-coluna-parte:first-child {
    border-radius: 0.15rem 0.15rem 0 0;
  }

  .nb-coluna-nome {
    display: -webkit-box;
    height: 2.1em;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 0.5625rem;
    line-height: 1.05;
    text-align: center;
    color: #d5daea;
  }

  /* ---------- Tabela de pendências ---------- */
  .nb-tabela-rolagem {
    max-height: 13rem;
    margin-top: 0.5rem;
    overflow: auto;
  }

  .nb-tabela {
    width: 100%;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .nb-tabela th {
    position: sticky;
    top: 0;
    padding: 0.35rem 0.5rem;
    background: #1d2754;
    font-weight: 600;
    text-align: left;
    color: white;
  }

  /* As linhas da tabela são recriadas pelo script ao filtrar: os estilos delas precisam valer sem o escopo do Astro */
  .nb-tabela :global(td) {
    padding: 0.3rem 0.5rem;
    border-bottom: 1px solid var(--nb-linha);
  }

  .nb-tabela :global(.nb-ok) {
    color: var(--nb-verde);
  }

  .nb-tabela :global(.nb-ruim) {
    color: var(--nb-vermelho);
  }

  .nb-ok {
    color: var(--nb-verde);
  }

  .nb-ruim {
    color: var(--nb-vermelho);
  }

  .nb-apagado {
    color: var(--nb-apagado);
  }

  /* ---------- Rosca ---------- */
  .nb-rosca {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.6rem;
  }

  .nb-rosca-svg {
    width: 7.5rem;
    height: 7.5rem;
    flex: none;
    transform: rotate(-90deg);
  }

  .nb-fatia {
    background: none;
    transition:
      stroke-dasharray 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      stroke-dashoffset 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nb-rosca-legenda {
    display: grid;
    gap: 0.45rem;
    padding: 0;
    font-size: 0.75rem;
    list-style: none;
  }

  .nb-rosca-valor {
    margin-left: auto;
    padding-left: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Grades das páginas ---------- */
  .nb-grade-lic,
  .nb-grade-cus {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 56rem) {
    .nb-grade-lic {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .nb-grade-cus {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ---------- Abas no rodapé ---------- */
  .nb-abas {
    display: flex;
    gap: 0.25rem;
    margin: 0.9rem -0.9rem 0;
    padding: 0 0.9rem;
    border-top: 1px solid var(--nb-linha);
    background: rgb(0 0 0 / 0.18);
  }

  .nb-aba {
    margin-top: -1px;
    padding: 0.6rem 1rem;
    border-top: 2px solid transparent;
    font-size: 0.75rem;
    color: var(--nb-apagado);
    cursor: pointer;
  }

  .nb-aba:hover {
    color: white;
  }

  /* Celular: as quatro abas precisam caber lado a lado */
  @media (max-width: 30rem) {
    .nb-abas {
      gap: 0;
      overflow-x: auto;
    }

    .nb-aba {
      flex: 1 0 auto;
      padding: 0.6rem 0.5rem;
      text-align: center;
      white-space: nowrap;
    }
  }

  #nb-pg-lic:checked ~ .nb-main [for='nb-pg-lic'],
  #nb-pg-seg:checked ~ .nb-main [for='nb-pg-seg'],
  #nb-pg-cus:checked ~ .nb-main [for='nb-pg-cus'],
  #nb-pg-cmp:checked ~ .nb-main [for='nb-pg-cmp'] {
    border-color: var(--nb-ouro);
    background: rgb(255 255 255 / 0.05);
    font-weight: 600;
    color: white;
  }

  #nb-pg-lic:focus-visible ~ .nb-main [for='nb-pg-lic'],
  #nb-pg-seg:focus-visible ~ .nb-main [for='nb-pg-seg'],
  #nb-pg-cus:focus-visible ~ .nb-main [for='nb-pg-cus'],
  #nb-pg-cmp:focus-visible ~ .nb-main [for='nb-pg-cmp'] {
    outline: 2px solid var(--nb-ouro);
    outline-offset: -2px;
  }

  /* ---------- Comparação: gráficos de linha mês a mês ---------- */
  .nb-grade-cmp {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 56rem) {
    .nb-grade-cmp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .nb-cmp-largo {
      grid-column: 1 / -1;
    }
  }

  .nb-lg {
    margin-top: 0.6rem;
    padding-top: 1rem;
  }

  .nb-lg-area {
    position: relative;
    height: 8.5rem;
  }

  .nb-lg-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .nb-lg-guia {
    stroke: var(--nb-linha);
    stroke-width: 1;
  }

  .nb-lg-traco {
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .nb-lg-ponto {
    position: absolute;
    width: 0.45rem;
    height: 0.45rem;
    border: 2px solid var(--cor);
    border-radius: 9999px;
    background: var(--nb-card);
    transform: translate(-50%, -50%);
  }

  .nb-lg-ponto.is-ultimo {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--cor);
  }

  .nb-lg-ponto b {
    position: absolute;
    bottom: calc(100% + 0.2rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.625rem;
    font-weight: 600;
    white-space: nowrap;
    color: #d5daea;
    font-variant-numeric: tabular-nums;
  }

  .nb-lg-ponto.is-ultimo b {
    font-weight: 700;
    color: white;
  }

  .nb-lg-meses {
    position: relative;
    height: 1.1rem;
    margin-top: 0.45rem;
    border-top: 1px solid var(--nb-linha);
  }

  .nb-lg-meses span {
    position: absolute;
    top: 0.3rem;
    transform: translateX(-50%);
    font-size: 0.625rem;
    color: var(--nb-apagado);
  }

  /* ---------- A planilha ---------- */
  .nb-planilha {
    position: relative;
    border-top: 1px solid var(--nb-linha);
    background: var(--color-sunset);
    color: var(--color-fg);
  }

  .nb-planilha .nb-janela {
    border-color: var(--color-line);
    color: var(--color-muted);
  }

  .nb-planilha .nb-janela > span:nth-child(-n + 3) {
    border-color: var(--color-line);
  }

  .nb-th,
  .nb-num {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
    color: var(--color-muted);
  }

  .nb-td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }

  td.nb-num {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .nb-planilha .nb-ok {
    color: #1d7a4a;
    font-weight: 600;
  }

  .nb-planilha .nb-ruim {
    color: #b3261e;
    font-weight: 600;
  }

  .nb-planilha .nb-apagado {
    color: var(--color-muted);
  }

  .nb-aviso-novo {
    position: absolute;
    top: 3.4rem;
    right: 1rem;
    z-index: 10;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-card);
    box-shadow: 0 12px 30px -12px rgb(20 25 55 / 0.35);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .nb-aviso-novo.is-on {
    opacity: 1;
    transform: none;
  }

  /* Linha nova: destaque que some e células entrando em sequência */
  tr.is-in {
    animation: nb-linha 2.4s ease;
  }

  tr.is-in td {
    animation: nb-celula 0.4s ease both;
    animation-delay: calc(var(--c, 0) * 60ms);
  }

  @keyframes nb-linha {
    from {
      background: color-mix(in srgb, var(--color-latao) 30%, transparent);
    }
  }

  @keyframes nb-celula {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nb-barra,
    .nb-parte,
    .nb-coluna-parte,
    .nb-fatia {
      transition: none;
    }
  }
</style>

<script>
  import { registros, calcular, listaPendencias, pendencias, rosca, SEL_VAZIA, type Sel } from '../lib/notebooks';

  let relogio: number | undefined;

  function iniciar() {
    const root = document.querySelector<HTMLElement>('[data-sheet]');
    if (!root) return;

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const campos = [...root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-f]')];
    const painel = $('[data-painel]');
    const abrir = $<HTMLButtonElement>('[data-abrir]');
    const contador = $('[data-contador]');
    const aviso = $('[data-aviso]');
    const limpar = $<HTMLButtonElement>('[data-limpar]');
    const tbodyPend = $('[data-pendencias]');
    const atualizado = $('[data-atualizado]');
    const avisoNovo = $('[data-aviso-novo]');
    const avisoNome = $('[data-aviso-nome]');
    const exibindo = $('[data-exibindo]');
    const total = $('[data-total]');
    const novas = [...root.querySelectorAll<HTMLTableRowElement>('tr[data-nova]')];
    const base0 = Number(exibindo.dataset.base);
    let proximo = 0;
    let visivel = false;

    // Os filtros escolhidos, no formato do cálculo
    const selecao = (): Sel => {
      const s: Sel = structuredClone(SEL_VAZIA);
      for (const c of campos) {
        const k = c.dataset.f as keyof Sel;
        if (c instanceof HTMLInputElement) {
          if (c.checked) (s[k] as string[]).push(c.value);
        } else (s[k] as string) = c.value;
      }
      return s;
    };

    // Nome de cada filtro em uso, para o aviso da barra lateral
    const emUso = () => {
      const nomes = new Set<string>();
      for (const c of campos) {
        const ativo = c instanceof HTMLInputElement ? c.checked : !!c.value;
        if (ativo) nomes.add(c.closest('.nb-filtro')!.querySelector('.nb-filtro-nome')!.textContent!);
      }
      return [...nomes];
    };

    const celula = (texto: string, classe?: string) => {
      const td = document.createElement('td');
      td.textContent = texto;
      if (classe) td.className = classe;
      return td;
    };

    // Recalcula o painel sobre as linhas da planilha que passam nos filtros, como o Power BI faz
    const render = () => {
      const base = registros.filter((x) => x.n < proximo);
      const s = selecao();
      const { t, w } = calcular(base, s);
      exibindo.textContent = String(base0 + proximo);
      total.textContent = String(base.length);

      root.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
        const v = t[el.dataset.m!];
        if (v === undefined || el.textContent === v) return;
        el.textContent = v;
        if (!el.classList.contains('nb-kpi-valor')) return;
        el.classList.remove('is-pulo');
        void el.offsetWidth;
        el.classList.add('is-pulo');
      });
      root.querySelectorAll<HTMLElement>('[data-w]').forEach((el) => (el.style.width = `${w[el.dataset.w!] ?? 0}%`));
      root.querySelectorAll<HTMLElement>('[data-h]').forEach((el) => (el.style.height = `${w[el.dataset.h!] ?? 0}%`));
      root.querySelectorAll<HTMLElement>('[data-st]').forEach((el) => (el.dataset.estado = t[el.dataset.st!] ?? ''));
      root.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => (el.title = t[el.dataset.tip!] ?? ''));
      const fatias = [...root.querySelectorAll<SVGCircleElement>('[data-fatia]')];
      rosca(fatias.map((f) => w[`cus:don:${f.dataset.fatia}`] ?? 0)).forEach((d, i) => {
        fatias[i].setAttribute('stroke-dasharray', d.dash);
        fatias[i].setAttribute('stroke-dashoffset', d.offset);
      });
      tbodyPend.replaceChildren(
        ...listaPendencias(base, s).map((x) => {
          const tr = document.createElement('tr');
          tr.append(
            celula(x.nome),
            celula(x.setor),
            celula(x.pc),
            celula(x.win ?? ''),
            celula(x.laps ? 'Com LAPS' : 'Sem LAPS', x.laps ? 'nb-ok' : 'nb-ruim'),
            celula(x.av ? 'Com antivírus' : 'Sem antivírus', x.av ? 'nb-ok' : 'nb-ruim'),
            celula(pendencias(x)),
          );
          return tr;
        }),
      );

      // Aviso de filtros (como no painel real) e o contador no botão
      const nomes = emUso();
      aviso.textContent = nomes.length ? `⚠ Filtros ativos: ${nomes.join(', ')}` : 'Sem filtros ativos – os números referem-se ao total';
      aviso.classList.toggle('is-ativo', nomes.length > 0);
      limpar.hidden = !nomes.length;
      contador.hidden = !nomes.length;
      contador.textContent = String(nomes.length);
      abrir.classList.toggle('is-ativo', nomes.length > 0);
    };

    // Celular e tablet: a barra lateral abre pelo botão Filtros e fecha no × ou com Esc
    const setPainel = (aberto: boolean) => {
      painel.classList.toggle('is-aberta', aberto);
      abrir.setAttribute('aria-expanded', String(aberto));
      (aberto ? campos[0] : abrir).focus();
    };
    abrir.addEventListener('click', () => setPainel(!painel.classList.contains('is-aberta')));
    $('[data-fechar]').addEventListener('click', () => setPainel(false));
    painel.addEventListener('keydown', (e) => e.key === 'Escape' && setPainel(false));

    campos.forEach((c) => c.addEventListener('change', render));
    limpar.addEventListener('click', () => {
      campos.forEach((c) => (c instanceof HTMLInputElement ? (c.checked = false) : (c.value = '')));
      render();
    });
    // O navegador pode restaurar uma escolha antiga ao voltar para a página
    if (campos.some((c) => (c instanceof HTMLInputElement ? c.checked : c.value))) render();

    // Sem animação: mostra direto a planilha completa
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      novas.forEach((r) => (r.hidden = false));
      proximo = novas.length;
      render();
      return;
    }

    // Um passo: avisa o colaborador novo, insere a linha e recalcula o painel.
    // Depois do último, espera e volta ao estado inicial para recomeçar
    const passo = () => {
      if (!visivel) return;
      if (proximo < novas.length) {
        const linha = novas[proximo];
        const nome = linha.cells[1].textContent ?? '';
        avisoNome.textContent = nome;
        avisoNovo.classList.add('is-on');
        relogio = window.setTimeout(() => {
          proximo++;
          avisoNovo.classList.remove('is-on');
          linha.hidden = false;
          linha.classList.add('is-in');
          atualizado.textContent = `↻ ${nome} entrou na planilha`;
          render();
          relogio = window.setTimeout(passo, 3000);
        }, 1400);
      } else {
        relogio = window.setTimeout(() => {
          novas.forEach((r) => {
            r.hidden = true;
            r.classList.remove('is-in');
          });
          proximo = 0;
          atualizado.textContent = '';
          render();
          relogio = window.setTimeout(passo, 1500);
        }, 3000);
      }
    };

    // Só anima enquanto a simulação está na tela
    new IntersectionObserver(
      ([e]) => {
        visivel = e.isIntersecting;
        clearTimeout(relogio);
        avisoNovo.classList.remove('is-on');
        if (visivel) relogio = window.setTimeout(passo, 1200);
      },
      { threshold: 0.15 },
    ).observe(root);
  }

  document.addEventListener('astro:page-load', iniciar);
  document.addEventListener('astro:before-swap', () => clearTimeout(relogio));
</script>
