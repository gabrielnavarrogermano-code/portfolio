---
import Secao from './Secao.astro';
import { idiomaDe, textos } from '../i18n';

// ( 0N ) Como eu trabalho: 4 princípios de negócio.
// À esquerda, a lista dos princípios (abas): o ativo abre e mostra o título e a frase. No painel, a demonstração
// animada do raciocínio dele, feita com exemplos de negócio (marcados como exemplo).
// - Em telas estreitas (celular), o card de cada princípio vai para dentro dele: tocou, abre o texto e o card juntos,
//   logo embaixo (o script move os cards; em telas largas eles voltam para o painel da direita).
// - Na primeira vez que a seção aparece, passa sozinho por 01 → 04 e volta ao 01 (para quando a pessoa interage);
//   no celular, não, para a página não mudar de altura sozinha enquanto a pessoa lê.
// - Sem JS, todos os princípios ficam abertos e as demonstrações, uma embaixo da outra.
// - Com movimento reduzido, as demonstrações já aparecem no estado final.
interface Props {
  num: string;
}
const { num } = Astro.props;

const idioma = idiomaDe(Astro.url);
const tx = textos[idioma].trabalho;
const principles = tx.principios;

// Demonstração 1: o que medir, depois que a pergunta de negócio aparece
const measures = tx.d1.medidas;

// Demonstração 4: a matriz impacto × esforço. Linha de cima = alto impacto; coluna da esquerda = pouco esforço
const quadrants = tx.d4.quadrantes;
---

<div id="habilidades" data-principles>
  <Secao num={num} rotulo={tx.rotulo} rotuloDir={tx.rotuloDir} titulo={tx.titulo} rotuloDados={tx.rotuloDados}>
    <!-- Os princípios: abas na vertical; a ativa abre o título e a frase -->
    <ol slot="negocio" role="tablist" aria-label={tx.lista} aria-orientation="vertical" class="pp-lista">
      {
        principles.map((p, i) => (
          <li class:list={['pp-item', i === 0 && 'is-active']}>
            <button
              type="button"
              role="tab"
              data-tab
              id={`pp-tab-${i}`}
              aria-controls={`pp-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="pp-tab"
            >
              <span class="pp-num">0{i + 1}</span>
              <span class="pp-curto">{p.short}</span>
              <span class="pp-marca" aria-hidden="true"></span>
            </button>
            <div class="pp-corpo">
              <div>
                <h3 class="pp-titulo">{p.title}</h3>
                <p class="pp-texto">{p.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- As demonstrações: com JS, empilhadas no mesmo lugar (a altura não pula ao trocar) e só a ativa aparece -->
    <div slot="dados" class="pp-panels">
      {
        principles.map((_, i) => (
          <div
            role="tabpanel"
            data-panel
            id={`pp-panel-${i}`}
            aria-labelledby={`pp-tab-${i}`}
            class:list={['pp-panel', i === 0 && 'is-active']}
            data-rotulo={tx.exemplo}
          >
            {i === 0 && (
              <div aria-hidden="true">
                <p class="d-tag">{tx.d1.pedidoTag}</p>
                <p class="d-pop mt-3 font-serif text-2xl leading-[1.1] text-fg/50">
                  <span class="d-strike" style="--s: 0.9s">{tx.d1.pedido}</span>
                </p>
                <p class="d-pop d-tag mt-7 flex items-center gap-3" style="--d: 1.2s">
                  {tx.d1.perguntaTag} <span class="h-px flex-1 bg-navy/10" />
                </p>
                <p class="d-pop mt-3 font-serif text-[1.75rem] leading-[1.1] text-heading text-balance" style="--d: 1.4s">
                  {tx.d1.perguntaAntes}<em class="d-destaque">{tx.d1.perguntaDestaque}</em>{tx.d1.perguntaDepois}
                </p>
                <ul class="mt-6 flex flex-wrap gap-2 font-mono text-[11px]">
                  {measures.map((m, k) => (
                    <li class="d-pop rounded-full border border-navy/15 px-2.5 py-1 text-fg/80" style={`--d: ${2.1 + k * 0.2}s`}>
                      {m}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {i === 1 && (
              <div aria-hidden="true">
                <p class="d-tag">{tx.d2.tag}</p>
                <p class="mt-3 font-display text-6xl leading-[0.85] font-black text-heading">
                  <span class="text-3xl">{tx.d2.moeda}</span> {tx.d2.valor}
                </p>
                <dl class="mt-6 border-t border-navy/10 text-sm">
                  <div class="d-pop flex items-center justify-between gap-4 border-b border-navy/10 py-3" style="--d: 0.6s">
                    <dt class="text-muted">{tx.d2.vsMes}</dt>
                    <dd class="font-mono text-heading">▼ 8%</dd>
                  </div>
                  <div class="d-pop border-b border-navy/10 py-3" style="--d: 1.1s">
                    <div class="flex items-center justify-between gap-4">
                      <dt class="text-muted">{tx.d2.meta}</dt>
                      <dd class="font-mono text-heading">92%</dd>
                    </div>
                    <dd class="relative mt-2.5 h-1.5 rounded-full bg-navy/10">
                      <span class="d-fill absolute inset-y-0 left-0 w-[92%] rounded-full bg-heading" style="--d: 1.4s" />
                      <span class="absolute -top-1 right-0 h-3.5 w-px bg-heading" />
                    </dd>
                  </div>
                </dl>
                <p class="d-pop mt-4 text-sm" style="--d: 2.3s">
                  <span class="d-selo">{tx.d2.atencao}</span> <span class="text-muted">{tx.d2.falta}</span>
                </p>
              </div>
            )}

            {i === 2 && (
              <div aria-hidden="true">
                <p class="d-tag">{tx.d3.tecnicoTag}</p>
                <p class="d-pop mt-3 font-mono text-lg text-fg/50">
                  <span class="d-strike" style="--s: 0.9s">{tx.d3.tecnico}</span>
                </p>
                <p class="d-pop d-tag mt-7 flex items-center gap-3" style="--d: 1.2s">
                  {tx.d3.quemDecideTag} <span class="h-px flex-1 bg-navy/10" />
                </p>
                <p class="d-pop mt-3 font-serif text-[1.75rem] leading-[1.1] text-heading text-balance" style="--d: 1.4s">
                  <em class="d-destaque">{tx.d3.destaque}</em>{tx.d3.frase}
                </p>
                <div class="mt-6 grid max-w-[17rem] grid-cols-12 gap-1.5">
                  {Array.from({ length: 24 }, (_, k) => (
                    <span
                      class:list={['d-pop aspect-square rounded-full', k === 23 ? 'd-hit bg-accent' : 'bg-navy/15']}
                      style={`--d: ${1.9 + k * 0.025}s`}
                    />
                  ))}
                </div>
              </div>
            )}

            {i === 3 && (
              <div aria-hidden="true">
                <p class="d-tag">{tx.d4.tag}</p>
                <p class="mt-4 font-mono text-[10px] tracking-[0.15em] text-muted uppercase">{tx.d4.impacto}</p>
                <div class="mt-2 grid grid-cols-2 border-b border-l border-navy/25">
                  {quadrants.map((q, k) => (
                    <div
                      class:list={['d-pop m-1 rounded-lg border p-3', q.win ? 'd-win' : 'border-navy/10']}
                      style={`--d: ${0.4 + k * 0.3}s`}
                    >
                      <p class:list={['text-xs leading-snug sm:text-sm', q.win ? 'd-win-texto' : 'text-fg/70']}>{q.task}</p>
                      <p class:list={['mt-2 font-mono text-[10px] tracking-[0.1em] uppercase', q.win ? 'd-win-tag' : 'text-muted']}>{q.tag}</p>
                    </div>
                  ))}
                </div>
                <p class="mt-2 text-right font-mono text-[10px] tracking-[0.15em] text-muted uppercase">{tx.d4.esforco}</p>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </Secao>
</div>

<style>
  /* ---------- Os princípios (abas na vertical) ---------- */
  .pp-lista {
    list-style: none;
    padding: 0;
  }

  .pp-item {
    border-top: 1px solid var(--color-line);
  }

  .pp-item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .pp-tab {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    width: 100%;
    padding: 1rem 0;
    text-align: left;
    cursor: pointer;
  }

  .pp-num {
    flex: none;
    width: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-astro);
    transition: color 0.3s ease;
  }

  .pp-curto {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 800;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-astro);
    transition: color 0.3s ease;
  }

  .pp-tab:hover .pp-curto,
  .pp-item.is-active .pp-curto {
    color: var(--color-heading);
  }

  .pp-item.is-active .pp-num {
    color: var(--color-accent);
  }

  /* A marca vermelha do princípio ativo */
  .pp-marca {
    align-self: center;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 0.4s cubic-bezier(0.65, 0, 0.2, 1);
  }

  .pp-item.is-active .pp-marca {
    width: 1.75rem;
  }

  .pp-tab:focus-visible {
    outline-offset: 4px;
    border-radius: 0.375rem;
  }

  /* O ativo abre (altura animada com grid 0fr → 1fr); sem JS, todos ficam abertos */
  .pp-corpo {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.65, 0, 0.2, 1);
  }

  [data-principles].is-js .pp-item:not(.is-active) .pp-corpo {
    grid-template-rows: 0fr;
  }

  .pp-corpo > div {
    overflow: hidden;
    padding-left: 2.3rem;
  }

  .pp-titulo {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-heading);
  }

  .pp-texto {
    margin: 0.4rem 0 1.15rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  /* ---------- Celular: o card dentro do princípio ----------
     O painel da direita some (os cards foram para dentro dos princípios) e cada card ganha o mesmo visual do painel:
     papel com borda azul e a faixa Neon Navy no topo com o rótulo. */
  [data-principles].is-celular :global(.painel) {
    display: none;
  }

  .pp-corpo .pp-panel {
    --color-heading: var(--color-navy);
    --color-line: rgb(20 25 55 / 0.14);
    position: relative;
    margin: 0.25rem 0 1.4rem;
    padding: 3.3rem 1.1rem 1.3rem;
    border-radius: 1rem;
    background: linear-gradient(var(--color-navy) 0 2.3rem, var(--color-sunset) 2.3rem);
    box-shadow: inset 0 0 0 1px rgb(20 25 55 / 0.35);
  }

  .pp-corpo .pp-panel::before {
    content: attr(data-rotulo);
    position: absolute;
    top: 0.8rem;
    left: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-sunset);
  }

  [data-principles].is-celular .pp-corpo > div {
    padding-left: 0;
  }

  [data-principles].is-celular .pp-titulo,
  [data-principles].is-celular .pp-texto {
    padding-left: 2.3rem;
  }

  /* ---------- Painéis das demonstrações ---------- */
  .pp-panels {
    display: grid;
    gap: 3rem;
  }

  [data-principles].is-js .pp-panels {
    gap: 0;
  }

  [data-principles].is-js .pp-panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s 0.35s;
  }

  [data-principles].is-js .pp-panel.is-active {
    visibility: visible;
    opacity: 1;
    transform: none;
    /* entra quando o anterior já quase sumiu, para os dois não se misturarem */
    transition:
      opacity 0.35s ease 0.25s,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s;
  }

  /* ---------- Demonstrações ----------
     No painel: rótulos em mono, números em Tektur e frases em serifa, em azul-marinho; o destaque é o vermelho.
     Sem a classe is-play, tudo fica no estado final (sem JS ou com movimento reduzido).
     Com is-play, cada peça roda a sua animação uma vez, com o atraso --d. */
  .d-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pp-panel .font-display {
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
  }

  /* Destaque das frases: o vermelho, como no resto do site */
  .d-destaque {
    color: var(--color-accent);
  }

  /* Selo de atenção: a etiqueta vermelha, como o "Atual" */
  .d-selo {
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-red);
    color: var(--color-sunset);
    font-weight: 500;
  }

  /* O quadrante vencedor: o bloco azul-marinho cheio, com o texto em Sunset */
  .d-win {
    border: 1px solid var(--color-navy);
    background: var(--color-navy);
  }

  .d-win-texto,
  .d-win-tag {
    color: var(--color-sunset);
  }

  .is-play .d-pop {
    animation: d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes d-pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* 01 e 03: o pedido vago e o termo técnico são riscados depois de aparecer (atraso --s) */
  .d-strike {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .is-play .d-strike {
    animation: d-strike 0.5s ease var(--s, 0s) both;
  }

  @keyframes d-strike {
    from {
      color: color-mix(in oklab, var(--color-fg) 85%, transparent);
      text-decoration-color: transparent;
    }
  }

  /* 02: a barra da meta enche até o valor */
  .d-fill {
    transform-origin: left;
  }

  .is-play .d-fill {
    animation: d-fill 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes d-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* 03: o cliente que saiu acende depois que a fileira aparece */
  .is-play .d-hit {
    animation:
      d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both,
      d-hit 0.6s ease 2.6s both;
  }

  @keyframes d-hit {
    from {
      background-color: rgb(20 25 55 / 0.15);
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
  }

  /* 04: o quadrante de mais impacto e menos esforço acende por último */
  .is-play .d-win {
    animation:
      d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both,
      d-win 0.6s ease 1.8s both;
  }

  @keyframes d-win {
    from {
      border-color: rgb(20 25 55 / 0.1);
      background-color: transparent;
    }
  }

  .is-play .d-win .d-win-texto,
  .is-play .d-win .d-win-tag {
    animation: d-win-texto 0.6s ease 1.8s both;
  }

  @keyframes d-win-texto {
    from {
      color: var(--color-fg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-corpo,
    .pp-marca {
      transition: none;
    }
  }
</style>

<script>
  // Uma etapa ativa por vez. Clique, toque, teclado (setas, Home, End) ou mouse (computador) trocam a etapa.
  const HOVER_WAIT_MS = 120; // espera curta antes de trocar, para não piscar quando o mouse só atravessa a lista
  const AUTO_STEP_MS = 4000; // tempo em cada etapa na passagem automática (dá para ver a demonstração inteira)
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-principles]');
    if (!root) return;
    root.classList.add('is-js');

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const items = tabs.map((t) => t.closest('li')!);
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const panelsHome = root.querySelector<HTMLElement>('.pp-panels');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const estreita = matchMedia('(max-width: 55.99rem)');
    const controller = new AbortController();
    const { signal } = controller;

    // Celular: cada card vai para dentro do princípio dele; tela larga: todos voltam para o painel da direita
    const posicionar = () => {
      const celular = estreita.matches;
      root.classList.toggle('is-celular', celular);
      panels.forEach((p, i) => {
        const destino = celular ? items[i].querySelector<HTMLElement>('.pp-corpo > div') : panelsHome;
        if (destino && p.parentElement !== destino) destino.append(p);
      });
    };
    posicionar();
    estreita.addEventListener('change', posicionar, { signal });

    // Reinicia a demonstração (tirar e pôr a classe faz as animações rodarem de novo)
    const play = (el: HTMLElement) => {
      if (reduced) return;
      el.classList.remove('is-play');
      void el.offsetWidth;
      el.classList.add('is-play');
    };

    let active = -1;
    let started = false;
    const setActive = (i: number, focus = false) => {
      if (i === active) return;
      active = i;
      tabs.forEach((t, k) => {
        items[k].classList.toggle('is-active', k === i);
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
      if (focus) tabs[i].focus();
      play(panels[i]);
      // Celular: o anterior fecha e o tocado pode subir para baixo do menu; depois da animação, traz ele de volta
      if (estreita.matches && started) {
        window.setTimeout(() => {
          if (tabs[i].getBoundingClientRect().top < 90) tabs[i].scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        }, 600);
      }
    };
    setActive(0);

    // ----- Passagem automática (só na primeira vez que a seção aparece) -----
    // Passa sozinha por 01 → 02 → 03 → 04 e volta ao 01, onde para.
    // Para de vez quando a pessoa mexe o mouse sobre a seção, toca, clica ou usa o teclado; pausa fora da tela.
    let auto = !reduced && !estreita.matches;
    let autoTimer = 0;
    let visible = false;

    const stopAuto = () => {
      auto = false;
      clearTimeout(autoTimer);
    };

    const scheduleAuto = () => {
      clearTimeout(autoTimer);
      if (!auto || !visible) return;
      autoTimer = window.setTimeout(() => {
        const next = (active + 1) % tabs.length;
        setActive(next);
        if (next === 0) stopAuto();
        else scheduleAuto();
      }, AUTO_STEP_MS);
    };

    // Só movimento de verdade conta: rolar a página com o mouse parado também dispara eventos de "passar por cima"
    root.addEventListener(
      'mousemove',
      (e) => {
        if (!auto || (e.movementX === 0 && e.movementY === 0)) return;
        stopAuto();
      },
      { signal },
    );
    root.addEventListener('pointerdown', stopAuto, { signal });
    root.addEventListener('focusin', stopAuto, { signal });

    let hoverTimer = 0;
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => setActive(i), { signal });
      tab.addEventListener(
        'pointerenter',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(hoverTimer);
          // Durante a passagem automática, quem troca é ela (até a pessoa mexer o mouse)
          hoverTimer = window.setTimeout(() => !auto && setActive(i), HOVER_WAIT_MS);
        },
        { signal },
      );
      tab.addEventListener('pointerleave', () => clearTimeout(hoverTimer), { signal });
      // Teclado: setas andam pelos princípios, Home e End vão para o primeiro e o último
      tab.addEventListener(
        'keydown',
        (e) => {
          const last = tabs.length - 1;
          const to =
            e.key === 'ArrowDown' || e.key === 'ArrowRight' ? Math.min(i + 1, last)
            : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? Math.max(i - 1, 0)
            : e.key === 'Home' ? 0
            : e.key === 'End' ? last
            : -1;
          if (to < 0) return;
          e.preventDefault();
          setActive(to, true);
        },
        { signal },
      );
    });

    // Quando os lados aparecem: roda a demonstração ativa e começa a passagem automática
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return clearTimeout(autoTimer);
        if (!started) {
          started = true;
          // espera o painel encher (ver o fio) para a demonstração rodar já visível
          const i = active;
          window.setTimeout(() => i === active && play(panels[i]), 900);
        }
        scheduleAuto();
      },
      { threshold: 0.35 },
    );
    const alvo = root.querySelector<HTMLElement>('[data-lados]') ?? root;
    io.observe(alvo);

    cleanup = () => {
      controller.abort();
      io.disconnect();
      clearTimeout(hoverTimer);
      clearTimeout(autoTimer);
    };
  });
</script>
