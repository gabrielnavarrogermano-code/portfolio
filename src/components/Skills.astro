---
import SectionTitle from './SectionTitle.astro';
import EtlStep from './EtlStep.astro';
import { siGit, siGithub } from 'simple-icons';

// Pipeline: as etapas e as ferramentas usadas em cada uma
const pipeline = [
  { stage: 'Extração', tools: ['SQL', 'Python'] },
  { stage: 'Tratamento', tools: ['pandas', 'Excel'] },
  { stage: 'Armazenamento', tools: ['PostgreSQL', 'MySQL'] },
  { stage: 'Visualização', tools: ['Power BI', 'DAX'] },
];

// Caso fictício: vendas de uma distribuidora passando pelas 4 etapas.
// A origem guarda os pedidos importados de planilhas com colunas em texto, por isso os formatos misturados.
// bad: coluna com problema → o motivo, mostrado ao passar o mouse na célula
const rawCols = ['Pedido', 'Data', 'Cliente', 'Produto', 'Qtd', 'Preço', 'UF'];
const repeated = 'Pedido repetido';
const raw: { row: string[]; bad: Record<number, string> }[] = [
  { row: ['1001', '2026-09-02', 'Mercado Sol', 'Café 500g', '2', '18.90', 'SP'], bad: {} },
  {
    row: ['1002', '02/09/2026', 'mercado sol', 'Café 500g', '1', '18,90', 'sp'],
    bad: { 1: 'Data em outro formato', 2: 'Mesmo cliente, escrito de outro jeito', 5: 'Preço com vírgula', 6: 'Estado em minúsculas' },
  },
  { row: ['1003', '2026-09-03', 'Padaria Lua', 'Açúcar 1kg', '5', 'NULL', 'RJ'], bad: { 5: 'Pedido sem preço' } },
  { row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG'], bad: {} },
  {
    row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG'],
    bad: Object.fromEntries(rawCols.map((_, i) => [i, repeated])),
  },
  { row: ['1005', '2026-09-05', 'Padaria Lua', 'Café 500g', '3', '18.90', 'RJ'], bad: {} },
];

// fixed: coluna corrigida no tratamento → o que foi feito (faturamento, índice 7, é sempre calculado)
const cleanCols = ['Pedido', 'Data', 'Cliente', 'Produto', 'Qtd', 'Preço', 'UF', 'Faturamento'];
const clean: { row: string[]; fixed: Record<number, string> }[] = [
  { row: ['1001', '2026-09-02', 'Mercado Sol', 'Café 500g', '2', '18.90', 'SP', '37.80'], fixed: {} },
  {
    row: ['1002', '2026-09-02', 'Mercado Sol', 'Café 500g', '1', '18.90', 'SP', '18.90'],
    fixed: { 1: 'Data padronizada', 2: 'Nome unificado', 5: 'Preço convertido em número', 6: 'Estado padronizado' },
  },
  {
    row: ['1003', '2026-09-03', 'Padaria Lua', 'Açúcar 1kg', '5', '5.49', 'RJ', '27.45'],
    fixed: { 5: 'Preenchido pela tabela de preços' },
  },
  { row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG', '57.48'], fixed: {} },
  { row: ['1005', '2026-09-05', 'Padaria Lua', 'Café 500g', '3', '18.90', 'RJ', '56.70'], fixed: {} },
];
for (const r of clean) r.fixed[7] = `Calculado: ${r.row[4]} × ${r.row[5]}`;

// Dica fica alinhada à direita nas últimas colunas, para não sair da tabela
const tipSide = (col: number, total: number) => (col >= total - 3 ? 'tip-end' : '');

// value é número para a contagem animada; o texto inicial já vem formatado (funciona sem JS)
const kpis = [
  { label: 'Faturamento', value: 198.33, decimals: 2, prefix: 'R$ ' },
  { label: 'Pedidos', value: 5, decimals: 0, prefix: '' },
  { label: 'Ticket médio', value: 39.67, decimals: 2, prefix: 'R$ ' },
];
const byProduct = [
  { name: 'Café 500g', value: 113.4 },
  { name: 'Leite 1L', value: 57.48 },
  { name: 'Açúcar 1kg', value: 27.45 },
];
const maxProduct = Math.max(...byProduct.map((p) => p.value));
const brl = (n: number, decimals = 2) =>
  n.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });

const code = {
  extract: `df = pd.read_sql("""
    SELECT id, data, cliente, produto, qtd, valor_unit, uf
    FROM erp.pedidos_importados
""", conn)

precos = pd.read_sql("SELECT produto, preco FROM erp.produtos", conn)`,
  transform: `df = df.drop_duplicates()

# datas: 02/09/2026 -> 2026-09-02
df["data"] = pd.to_datetime(
    df["data"].str.replace(r"(\\d{2})/(\\d{2})/(\\d{4})", r"\\3-\\2-\\1", regex=True)
)
df["cliente"] = df["cliente"].str.title()
df["uf"] = df["uf"].str.upper()

# texto -> número ("18,90" -> 18.90, NULL continua vazio)
df["qtd"] = df["qtd"].astype(int)
df["valor_unit"] = pd.to_numeric(df["valor_unit"].str.replace(",", "."))

# regra de negócio: valor ausente assume o preço de tabela do produto
df["valor_unit"] = df["valor_unit"].fillna(
    df["produto"].map(precos.set_index("produto")["preco"])
)
df["faturamento"] = df["qtd"] * df["valor_unit"]`,
  load: `# grava a base tratada como a tabela "vendas" no PostgreSQL
df.to_sql("vendas", conn, if_exists="replace", index=False)

-- conferência da carga no banco
SELECT COUNT(*) AS linhas, SUM(faturamento) AS faturamento_total
FROM vendas;`,
  visualize: `Faturamento  = SUM ( vendas[faturamento] )
Pedidos      = DISTINCTCOUNT ( vendas[id] )
Ticket Médio = DIVIDE ( [Faturamento], [Pedidos] )`,
};
---

<section id="habilidades" class="py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionTitle title="Como eu trabalho" />
    <p data-reveal class="mt-3 text-muted md:hidden">Abra cada etapa para ver o exemplo na prática.</p>

    <!-- Git e GitHub em cima, com uma linha descendo para cada uma das 4 etapas -->
    <div data-reveal class="git-link mt-10 md:mt-14">
      <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-muted">
        <span class="inline-flex items-center gap-1.5 text-fg">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={siGit.path} /></svg>Git
        </span>
        e
        <span class="inline-flex items-center gap-1.5 text-fg">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>GitHub
        </span>
        versionando todas as etapas
      </p>
      <div class="git-lines relative mt-3 hidden h-8 lg:block" aria-hidden="true">
        <span class="git-stem"></span>
        <span class="git-hline"></span>
        {[0, 1, 2, 3].map((i) => <span class="git-drop" data-i={i} style={`left: ${12.5 + i * 25}%; --i: ${i}`} />)}
      </div>
    </div>

    <div class="etl mt-6 space-y-3 md:mt-8 md:space-y-0 lg:mt-0" data-etl>
      <EtlStep index={0} {...pipeline[0]} open>
        <div class="overflow-x-auto">
          <table class="w-full text-sm tabular-nums">
            <thead><tr>{rawCols.map((c) => <th class="border-b border-line px-3 py-2 text-left font-medium text-muted">{c}</th>)}</tr></thead>
            <tbody>
              {raw.map((r) => (
                <tr>{r.row.map((v, ci) => r.bad[ci] ? (
                  <td tabindex="0" class:list={['cell-tip border-b border-line px-3 py-2 whitespace-nowrap text-red-400', tipSide(ci, rawCols.length)]}>{v}<span class="tip">{r.bad[ci]}</span></td>
                ) : (
                  <td class="border-b border-line px-3 py-2 whitespace-nowrap text-fg/85">{v}</td>
                ))}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        <p class="mt-4 text-sm text-muted"><span class="mr-2 text-red-400">✕</span>Passe o mouse (ou toque) nas células em vermelho para ver cada erro</p>
        <details class="mt-3">
          <summary class="w-fit cursor-pointer py-2 text-sm text-muted transition-colors hover:text-heading">Ver o código (Python + SQL)</summary>
          <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.extract}</pre>
          <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        </details>
      </EtlStep>
      <EtlStep index={1} {...pipeline[1]}>
        <div class="overflow-x-auto">
          <table class="w-full text-sm tabular-nums">
            <thead><tr>{cleanCols.map((c) => <th class="border-b border-line px-3 py-2 text-left font-medium text-muted">{c}</th>)}</tr></thead>
            <tbody>
              {clean.map((r, ri) => (
                <tr>{r.row.map((v, ci) => r.fixed[ci] ? (
                  <td tabindex="0" style={`--fix-delay: ${ri * 90}ms`} class:list={['cell-tip is-fixed border-b border-line px-3 py-2 whitespace-nowrap text-emerald-400', tipSide(ci, cleanCols.length)]}>{v}<span class="tip">{r.fixed[ci]}</span></td>
                ) : (
                  <td class="border-b border-line px-3 py-2 whitespace-nowrap text-fg/85">{v}</td>
                ))}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        <p class="mt-4 text-sm text-muted"><span class="mr-2 text-emerald-400">✓</span>Pedido repetido removido · passe o mouse nas células em verde para ver cada correção</p>
        <details class="mt-3">
          <summary class="w-fit cursor-pointer py-2 text-sm text-muted transition-colors hover:text-heading">Ver o código (Python)</summary>
          <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.transform}</pre>
          <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        </details>
      </EtlStep>
      <EtlStep index={2} {...pipeline[2]}>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded border border-line px-4 py-3">
            <p class="text-sm text-muted">Pedidos gravados</p>
            <p class="mt-1 text-2xl font-semibold text-heading tabular-nums"><span data-count={clean.length}>{clean.length}</span> <span class="text-sm font-normal text-emerald-400">✓ todos chegaram</span></p>
          </div>
          <div class="rounded border border-line px-4 py-3">
            <p class="text-sm text-muted">Faturamento total</p>
            <p class="mt-1 text-2xl font-semibold text-heading tabular-nums"><span data-count="198.33" data-decimals="2" data-prefix="R$ ">R$ 198,33</span> <span class="text-sm font-normal text-emerald-400">✓ bate com o painel</span></p>
          </div>
        </div>
        <details class="mt-3">
          <summary class="w-fit cursor-pointer py-2 text-sm text-muted transition-colors hover:text-heading">Ver o código (Python + SQL)</summary>
          <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.load}</pre>
          <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        </details>
      </EtlStep>
      <EtlStep index={3} {...pipeline[3]}>
        <div class="grid gap-4 sm:grid-cols-3">
          {kpis.map((k) => (
            <div class="rounded border border-line px-4 py-3">
              <p class="text-sm text-muted">{k.label}</p>
              <p class="mt-1 text-2xl font-semibold text-heading tabular-nums">
                <span data-count={k.value} data-decimals={k.decimals} data-prefix={k.prefix}>{k.prefix}{brl(k.value, k.decimals)}</span>
              </p>
            </div>
          ))}
        </div>
        <div class="mt-4 rounded border border-line px-4 py-4">
          <p class="text-sm text-muted">Faturamento por produto</p>
          <ul class="mt-3 space-y-2">
            {byProduct.map((p, i) => (
              <li class="grid grid-cols-[6.5rem_1fr_4.5rem] items-center gap-3 text-sm">
                <span class="text-fg/85">{p.name}</span>
                <span class="etl-bar h-2 rounded bg-accent" style={`width: ${(p.value / maxProduct) * 100}%; --bar-delay: ${i * 120}ms`} />
                <span class="text-right font-mono text-fg/85">{brl(p.value)}</span>
              </li>
            ))}
          </ul>
        </div>
        <details class="mt-3">
          <summary class="w-fit cursor-pointer py-2 text-sm text-muted transition-colors hover:text-heading">Ver as fórmulas (DAX)</summary>
          <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.visualize}</pre>
          <p class="mt-2 text-xs text-muted sm:hidden">← arraste para ver mais →</p>
        </details>
      </EtlStep>
    </div>
  </div>
</section>

<style>
  /* Linhas do Git até as etapas: descem do texto, abrem para os lados e caem em cada aba */
  .git-stem,
  .git-hline,
  .git-drop {
    position: absolute;
    background: var(--color-line);
    transition:
      transform 0.5s ease,
      background-color 0.25s ease;
  }

  .git-stem {
    top: 0;
    left: 50%;
    width: 1px;
    height: 0.75rem;
    transform-origin: top;
    transform: scaleY(0);
    transition-delay: 0.2s;
  }

  .git-hline {
    top: 0.75rem;
    left: 12.5%;
    right: 12.5%;
    height: 1px;
    transform: scaleX(0);
    transition-delay: 0.6s;
  }

  .git-drop {
    top: 0.75rem;
    bottom: 0;
    width: 1px;
    transform-origin: top;
    transform: scaleY(0);
    transition-delay: calc(1s + var(--i) * 80ms), 0s;
  }

  .git-link:global(.is-visible) .git-stem,
  .git-link:global(.is-visible) .git-drop {
    transform: scaleY(1);
  }

  .git-link:global(.is-visible) .git-hline {
    transform: scaleX(1);
  }

  /* A linha da etapa aberta fica destacada */
  section:has(:global(.etl-step:nth-child(1)[data-open])) .git-drop[data-i='0'],
  section:has(:global(.etl-step:nth-child(2)[data-open])) .git-drop[data-i='1'],
  section:has(:global(.etl-step:nth-child(3)[data-open])) .git-drop[data-i='2'],
  section:has(:global(.etl-step:nth-child(4)[data-open])) .git-drop[data-i='3'] {
    background: var(--color-heading);
  }

  @media (prefers-reduced-motion: reduce) {
    .git-stem,
    .git-hline,
    .git-drop {
      transition: none;
      transform: none;
    }
  }

  /*
    Celular: cards um embaixo do outro, cada um abre o próprio exemplo.
    A partir de md: os cabeçalhos viram abas lado a lado e os exemplos ficam empilhados
    no mesmo espaço embaixo delas, com a altura do maior, para a página não pular ao trocar.
  */
  :global(.etl-step:not([data-open]) > .etl-body) {
    display: none;
  }

  @media (min-width: 48rem) {
    .etl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .etl :global(.etl-step) {
      display: contents;
    }

    .etl :global(.etl-head) {
      border-bottom-width: 1px;
    }

    .etl :global(.etl-step:nth-child(-n + 2) > .etl-head) {
      border-top-width: 1px;
    }

    .etl :global(.etl-step:nth-child(even) > .etl-head) {
      border-left-width: 1px;
    }

    .etl :global(.etl-body) {
      grid-row: 3;
      grid-column: 1 / -1;
    }

    .etl :global(.etl-step:not([data-open]) > .etl-body) {
      display: block;
      visibility: hidden;
    }

    .etl :global(.etl-step[data-open] > .etl-body) {
      animation: etl-fade 0.3s ease;
    }
  }

  @media (min-width: 64rem) {
    .etl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .etl :global(.etl-step > .etl-head) {
      border-top-width: 1px;
    }

    .etl :global(.etl-step:not(:first-child) > .etl-head) {
      border-left-width: 1px;
    }

    .etl :global(.etl-body) {
      grid-row: 2;
    }
  }

  /* No celular, o conteúdo do card aparece com um fade ao abrir */
  :global(.etl-step[data-open] > .etl-body) {
    animation: etl-fade 0.3s ease;
  }

  @keyframes etl-fade {
    from {
      opacity: 0;
    }
  }
  /* Dica da célula: aparece acima dela ao passar o mouse, focar ou tocar */
  .cell-tip {
    position: relative;
    cursor: help;
    outline: none;
  }

  .cell-tip:focus-visible {
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .tip {
    position: absolute;
    bottom: calc(100% - 4px);
    left: 0.5rem;
    z-index: 10;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: #ffffff;
    color: #0a0a0b;
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .tip-end .tip {
    left: auto;
    right: 0.5rem;
  }

  .cell-tip:hover .tip,
  .cell-tip:focus .tip {
    opacity: 1;
    transform: none;
  }

  /* Em telas de toque, o cursor "pointer" faz o toque ativar o :hover */
  @media (hover: none) {
    .cell-tip {
      cursor: pointer;
    }
  }

  /* Tratamento: ao abrir o card, as células corrigidas passam de vermelho a verde */
  :global(.etl-step[data-open]) .is-fixed {
    animation: cell-fix 0.9s ease both;
    animation-delay: var(--fix-delay, 0ms);
  }

  @keyframes cell-fix {
    0%,
    35% {
      color: var(--color-red-400);
    }
  }

  /* Visualização: as barras crescem ao abrir o card */
  :global(.etl-step[data-open]) .etl-bar {
    transform-origin: left;
    animation: bar-grow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--bar-delay, 0ms);
  }

  @keyframes bar-grow {
    from {
      transform: scaleX(0);
    }
  }
</style>

<script>
  const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  // A partir daqui as etapas ficam lado a lado e só uma fica aberta por vez
  const sideBySide = matchMedia('(min-width: 48rem)');
  const counting = new WeakMap<HTMLElement, number>();

  // Números do exemplo contam de 0 até o valor quando ele é aberto
  const countUp = (body: HTMLElement) => {
    if (reduceMotion()) return;
    body.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals ?? 0);
      const prefix = el.dataset.prefix ?? '';
      const format = (n: number) =>
        prefix + n.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      const start = performance.now();
      const frame = (now: number) => {
        const t = Math.min((now - start) / 900, 1);
        el.textContent = format(target * (1 - (1 - t) ** 3));
        if (t < 1) counting.set(el, requestAnimationFrame(frame));
      };
      cancelAnimationFrame(counting.get(el) ?? 0);
      counting.set(el, requestAnimationFrame(frame));
    });
  };

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-etl]').forEach((root) => {
      const steps = [...root.querySelectorAll<HTMLElement>('.etl-step')];
      const head = (step: HTMLElement) => step.querySelector<HTMLButtonElement>('.etl-head')!;
      const body = (step: HTMLElement) => step.querySelector<HTMLElement>('.etl-body')!;
      let clicked = false;

      const setOpen = (step: HTMLElement, open: boolean) => {
        if (open && !step.hasAttribute('data-open')) countUp(body(step));
        step.toggleAttribute('data-open', open);
        head(step).setAttribute('aria-expanded', String(open));
        body(step).inert = !open;
        // Código aberto num exemplo fechado deixaria a área alta e vazia
        if (!open) body(step).querySelectorAll('details').forEach((d) => (d.open = false));
      };

      // Lado a lado: abre só a escolhida. Celular: cada card abre e fecha sozinho
      const select = (step: HTMLElement) => steps.forEach((s) => setOpen(s, s === step));

      steps.forEach((step) =>
        head(step).addEventListener('click', () => {
          clicked = true;
          if (sideBySide.matches) select(step);
          else setOpen(step, !step.hasAttribute('data-open'));
        }),
      );

      // Ao virar lado a lado (girar o tablet, redimensionar), fica só uma etapa aberta
      sideBySide.addEventListener('change', (e) => {
        if (e.matches) select(steps.find((s) => s.hasAttribute('data-open')) ?? steps[0]);
      });

      if (reduceMotion()) return;

      // Lado a lado, na primeira vez que as abas aparecem, passa pelas etapas 2, 3 e 4 e volta à 1,
      // mostrando que são clicáveis. Um clique interrompe a passagem.
      const sweep = () =>
        [...steps.slice(1), steps[0]].forEach((step, i) =>
          setTimeout(() => !clicked && sideBySide.matches && select(step), (i + 1) * 1200),
        );

      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          // Espera o fade de entrada das abas terminar
          if (sideBySide.matches) setTimeout(() => !clicked && sweep(), 500);
        },
        { threshold: 0.6 },
      );
      io.observe(head(steps[0]));
    });
  });
</script>
