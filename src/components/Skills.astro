---
import SectionTitle from './SectionTitle.astro';
import BgWord from './BgWord.astro';
import Principles from './Principles.astro';

// O que estou estudando agora e para quê
const studying = [
  { name: 'SQL', why: 'Para consultar os dados e montar tabelas direto na fonte.' },
  { name: 'DAX no Power BI', why: 'Para aplicar as regras de negócio dentro do Power BI, começando pelo básico.' },
  { name: 'Data storytelling', why: 'Para contar uma história com comparações nos dashboards.' },
];
---

<section id="habilidades" class="on-paper render-later relative isolate mx-2 overflow-clip rounded-[2rem] bg-bg pb-16 sm:mx-4 sm:rounded-[3rem] [contain-intrinsic-size:auto_1500px] sm:pb-24 md:[contain-intrinsic-size:auto_1100px]">
  <BgWord word="MÉTODO" />
  <div class="mx-auto max-w-5xl px-6">
    <SectionTitle
      title="Como eu trabalho"
      subtitle="Meu ponto mais forte é entender o contexto e as regras de onde eu trabalho."
    />

    <!-- No dia a dia: os princípios que já aplico no estágio, cada um com uma demonstração feita com dados reais -->
    <div class="mt-12 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <p class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">( No dia a dia do estágio )</p>
      <p class="text-sm text-muted">Quatro princípios, com exemplos reais do controle de notebooks.</p>
    </div>
    <Principles />

    <!-- Onde pretendo chegar: o objetivo em destaque (serifa, como na capa e no Sobre) e o que estou estudando -->
    <div class="mt-20 grid gap-10 md:mt-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">( Onde pretendo chegar )</p>
        <p class="mt-5 font-serif text-[2.25rem] leading-[1.05] text-balance text-heading sm:text-5xl">
          Levar o dado da fonte <em class="text-accent">até a decisão.</em>
        </p>
        <p class="mt-6 max-w-xl leading-relaxed text-fg/85">
          Montar o ETL de ponta a ponta, aplicar as regras de negócio e entregar dashboards que ajudem quem não é
          técnico a decidir.
        </p>
      </div>

      <div>
        <p class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">( Agora estou estudando )</p>
        <ol class="mt-5 border-t border-line">
          {
            studying.map((s, i) => (
              <li data-reveal data-active class="study-row grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 border-b border-line py-5">
                <span class="pt-1.5 font-mono text-xs text-muted">( 0{i + 1} )</span>
                <div>
                  <p class="study-name font-display text-2xl leading-none font-black text-heading uppercase">{s.name}</p>
                  <p class="mt-2 text-sm leading-relaxed text-fg/75">{s.why}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-sm text-muted">O objetivo é que esse caminho vire parte da minha rotina.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .study-name {
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    transition: color 0.3s ease;
  }

  .study-row:hover .study-name,
  .study-row.is-active .study-name {
    color: var(--color-accent);
  }
</style>
