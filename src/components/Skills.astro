---
import SectionTitle from './SectionTitle.astro';
import Principles from './Principles.astro';
---

<!-- Sem palavra de fundo: a folha clara já separa a seção; o espaço acima do título vem do padding -->
<section id="habilidades" class="on-paper render-later relative isolate mx-2 overflow-clip rounded-[2rem] bg-bg pt-14 pb-16 sm:mx-4 sm:rounded-[3rem] sm:pt-20 [contain-intrinsic-size:auto_1100px] sm:pb-24 md:[contain-intrinsic-size:auto_800px] lg:pt-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionTitle
      title="Como eu trabalho"
      subtitle="O raciocínio de negócio que levo para qualquer análise."
    />

    <!-- Os princípios de negócio, cada um com uma demonstração do raciocínio (exemplos) e, quando há, onde já apliquei -->
    <!-- O projeto em si fica no card e no estudo de caso; aqui o foco é o jeito de pensar -->
    <Principles />
  </div>
</section>
