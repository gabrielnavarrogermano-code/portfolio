---
import SectionTitle from './SectionTitle.astro';

// Pipeline: onde cada ferramenta entra e o que faço em cada etapa
const pipeline = [
  { stage: 'Extração', tools: ['SQL', 'Python'], does: 'Buscar os dados onde eles estão: sistemas e planilhas' },
  { stage: 'Tratamento', tools: ['pandas', 'Excel'], does: 'Corrigir erros, remover repetições e padronizar' },
  { stage: 'Armazenamento', tools: ['PostgreSQL', 'MySQL'], does: 'Guardar os dados prontos em um banco, para o BI usar' },
  { stage: 'Visualização', tools: ['Power BI', 'DAX'], does: 'Transformar os dados em indicadores e gráficos' },
];

// Caso fictício: vendas de uma distribuidora passando pelas 4 etapas.
// A origem guarda os pedidos importados de planilhas com colunas em texto, por isso os formatos misturados.
const rawCols = ['Pedido', 'Data', 'Cliente', 'Produto', 'Qtd', 'Preço', 'UF'];
const raw = [
  { row: ['1001', '2026-09-02', 'Mercado Sol', 'Café 500g', '2', '18.90', 'SP'], bad: [] },
  { row: ['1002', '02/09/2026', 'mercado sol', 'Café 500g', '1', '18,90', 'sp'], bad: [1, 2, 5, 6] },
  { row: ['1003', '2026-09-03', 'Padaria Lua', 'Açúcar 1kg', '5', 'NULL', 'RJ'], bad: [5] },
  { row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG'], bad: [] },
  { row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG'], bad: [0, 1, 2, 3, 4, 5, 6] },
  { row: ['1005', '2026-09-05', 'Padaria Lua', 'Café 500g', '3', '18.90', 'RJ'], bad: [] },
];

// Problemas da base bruta e o que o tratamento faz com cada um, em linguagem de negócio
const problems = [
  'O mesmo cliente escrito de dois jeitos',
  'Datas e preços em formatos diferentes',
  'Um pedido sem preço',
  'Um pedido repetido',
];
const fixes = [
  'Pedido repetido removido',
  'Datas, nomes e estados padronizados',
  'Preço que faltava preenchido pela tabela de preços',
  'Faturamento de cada pedido calculado (quantidade × preço)',
];

// fixed: colunas corrigidas no tratamento (faturamento, índice 7, é sempre calculado)
const cleanCols = ['Pedido', 'Data', 'Cliente', 'Produto', 'Qtd', 'Preço', 'UF', 'Faturamento'];
const clean = [
  { row: ['1001', '2026-09-02', 'Mercado Sol', 'Café 500g', '2', '18.90', 'SP', '37.80'], fixed: [7] },
  { row: ['1002', '2026-09-02', 'Mercado Sol', 'Café 500g', '1', '18.90', 'SP', '18.90'], fixed: [1, 2, 5, 6, 7] },
  { row: ['1003', '2026-09-03', 'Padaria Lua', 'Açúcar 1kg', '5', '5.49', 'RJ', '27.45'], fixed: [5, 7] },
  { row: ['1004', '2026-09-04', 'Empório Vale', 'Leite 1L', '12', '4.79', 'MG', '57.48'], fixed: [7] },
  { row: ['1005', '2026-09-05', 'Padaria Lua', 'Café 500g', '3', '18.90', 'RJ', '56.70'], fixed: [7] },
];

const kpis = [
  { label: 'Faturamento', value: 'R$ 198,33' },
  { label: 'Pedidos', value: '5' },
  { label: 'Ticket médio', value: 'R$ 39,67' },
];
const byProduct = [
  { name: 'Café 500g', value: 113.4 },
  { name: 'Leite 1L', value: 57.48 },
  { name: 'Açúcar 1kg', value: 27.45 },
];
const maxProduct = Math.max(...byProduct.map((p) => p.value));
const brl = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2 });

const code = {
  extract: `df = pd.read_sql("""
    SELECT id, data, cliente, produto, qtd, valor_unit, uf
    FROM erp.pedidos_importados
""", conn)

precos = pd.read_sql("SELECT produto, preco FROM erp.produtos", conn)`,
  transform: `df = df.drop_duplicates()

# datas: 02/09/2026 -> 2026-09-02
df["data"] = pd.to_datetime(
    df["data"].str.replace(r"(\\d{2})/(\\d{2})/(\\d{4})", r"\\3-\\2-\\1", regex=True)
)
df["cliente"] = df["cliente"].str.title()
df["uf"] = df["uf"].str.upper()

# texto -> número ("18,90" -> 18.90, NULL continua vazio)
df["qtd"] = df["qtd"].astype(int)
df["valor_unit"] = pd.to_numeric(df["valor_unit"].str.replace(",", "."))

# regra de negócio: valor ausente assume o preço de tabela do produto
df["valor_unit"] = df["valor_unit"].fillna(
    df["produto"].map(precos.set_index("produto")["preco"])
)
df["faturamento"] = df["qtd"] * df["valor_unit"]`,
  load: `# grava a base tratada como a tabela "vendas" no PostgreSQL
df.to_sql("vendas", conn, if_exists="replace", index=False)

-- conferência da carga no banco
SELECT COUNT(*) AS linhas, SUM(faturamento) AS faturamento_total
FROM vendas;`,
  visualize: `Faturamento  = SUM ( vendas[faturamento] )
Pedidos      = DISTINCTCOUNT ( vendas[id] )
Ticket Médio = DIVIDE ( [Faturamento], [Pedidos] )`,
};
---

<section id="habilidades" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionTitle title="Como eu trabalho" />

    <div class="mt-12" data-etl>
      <p data-reveal class="text-sm text-muted">
        Meu trabalho consiste em responder perguntas de negócio realizando consultas em bancos de dados e planilhas, e tratando esses dados para que o BI seja alimentado corretamente. Além disso, realizo a visualização por meio de dashboards com KPIs e gráficos dinâmicos, que ajudam na compreensão do cenário atual e facilitam a tomada de decisão.
      </p>
      <div role="tablist" class="mt-6 grid border-y border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          pipeline.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`etl-tab-${i}`}
              aria-controls={`etl-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-reveal
              style={`--delay: ${i * 100}ms`}
              class="relative cursor-pointer border-line py-5 text-left transition-colors not-first:border-t hover:bg-white/5 aria-selected:bg-white/5 sm:px-5 sm:nth-2:border-t-0 lg:not-first:border-t-0 lg:not-first:border-l"
            >
              <p class="text-sm font-medium text-heading">
                <span class="mr-2 text-accent">{i + 1}</span>
                {p.stage}
              </p>
              <p class="mt-2 text-fg/85">{p.tools.join(', ')}</p>
              <p class="mt-2 text-sm text-muted">{p.does}</p>
              <span class="etl-progress" aria-hidden="true" />
            </button>
          ))
        }
      </div>

      <div class="etl-panels mt-8">
        <!-- 1. Extração -->
        <div role="tabpanel" id="etl-panel-0" aria-labelledby="etl-tab-0">
          <p class="text-fg">Busco os pedidos no sistema da empresa. Eles chegam assim, com erros que atrapalhariam qualquer análise:</p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm tabular-nums">
              <thead><tr>{rawCols.map((c) => <th class="border-b border-line px-3 py-2 text-left font-medium text-muted">{c}</th>)}</tr></thead>
              <tbody>
                {raw.map((r) => (
                  <tr>{r.row.map((v, ci) => <td class:list={['border-b border-line px-3 py-2 whitespace-nowrap', r.bad.includes(ci) ? 'text-red-400' : 'text-fg/85']}>{v}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="mt-4 grid gap-x-6 gap-y-1 text-sm text-muted sm:grid-cols-2">
            {problems.map((p) => <li><span class="mr-2 text-red-400">✕</span>{p}</li>)}
          </ul>
          <details class="mt-5">
            <summary class="w-fit cursor-pointer text-sm text-muted transition-colors hover:text-heading">Ver o código (Python + SQL)</summary>
            <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.extract}</pre>
          </details>
        </div>

        <!-- 2. Tratamento -->
        <div role="tabpanel" id="etl-panel-1" aria-labelledby="etl-tab-1" hidden>
          <p class="text-fg">Corrijo os problemas e calculo o faturamento de cada pedido. O resultado é uma base confiável:</p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm tabular-nums">
              <thead><tr>{cleanCols.map((c) => <th class="border-b border-line px-3 py-2 text-left font-medium text-muted">{c}</th>)}</tr></thead>
              <tbody>
                {clean.map((r) => (
                  <tr>{r.row.map((v, ci) => <td class:list={['border-b border-line px-3 py-2 whitespace-nowrap', r.fixed.includes(ci) ? 'text-emerald-400' : 'text-fg/85']}>{v}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="mt-4 grid gap-x-6 gap-y-1 text-sm text-muted sm:grid-cols-2">
            {fixes.map((f) => <li><span class="mr-2 text-emerald-400">✓</span>{f}</li>)}
          </ul>
          <details class="mt-5">
            <summary class="w-fit cursor-pointer text-sm text-muted transition-colors hover:text-heading">Ver o código (Python)</summary>
            <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.transform}</pre>
          </details>
        </div>

        <!-- 3. Armazenamento -->
        <div role="tabpanel" id="etl-panel-2" aria-labelledby="etl-tab-2" hidden>
          <p class="text-fg">Guardo a base tratada em um banco de dados, de onde o BI sempre lê a versão mais atual. Antes de liberar, confiro se nada se perdeu no caminho:</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div class="rounded border border-line px-4 py-3">
              <p class="text-sm text-muted">Pedidos gravados</p>
              <p class="mt-1 text-2xl font-semibold text-heading">{clean.length} <span class="text-sm font-normal text-emerald-400">✓ todos chegaram</span></p>
            </div>
            <div class="rounded border border-line px-4 py-3">
              <p class="text-sm text-muted">Faturamento total</p>
              <p class="mt-1 text-2xl font-semibold text-heading">R$ 198,33 <span class="text-sm font-normal text-emerald-400">✓ bate com o painel</span></p>
            </div>
          </div>
          <details class="mt-5">
            <summary class="w-fit cursor-pointer text-sm text-muted transition-colors hover:text-heading">Ver o código (Python + SQL)</summary>
            <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.load}</pre>
          </details>
        </div>

        <!-- 4. Visualização -->
        <div role="tabpanel" id="etl-panel-3" aria-labelledby="etl-tab-3" hidden>
          <p class="text-fg">No Power BI, os dados viram indicadores e gráficos que qualquer pessoa entende:</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {kpis.map((k) => (
              <div class="rounded border border-line px-4 py-3">
                <p class="text-sm text-muted">{k.label}</p>
                <p class="mt-1 text-2xl font-semibold text-heading">{k.value}</p>
              </div>
            ))}
          </div>
          <div class="mt-4 rounded border border-line px-4 py-4">
            <p class="text-sm text-muted">Faturamento por produto</p>
            <ul class="mt-3 space-y-2">
              {byProduct.map((p) => (
                <li class="grid grid-cols-[6.5rem_1fr_4.5rem] items-center gap-3 text-sm">
                  <span class="text-fg/85">{p.name}</span>
                  <span class="h-2 rounded bg-accent" style={`width: ${(p.value / maxProduct) * 100}%`} />
                  <span class="text-right font-mono text-fg/85">{brl(p.value)}</span>
                </li>
              ))}
            </ul>
          </div>
          <details class="mt-5">
            <summary class="w-fit cursor-pointer text-sm text-muted transition-colors hover:text-heading">Ver as fórmulas (DAX)</summary>
            <pre class="mt-3 overflow-x-auto rounded border border-line p-4 font-mono text-sm text-fg/85">{code.visualize}</pre>
          </details>
        </div>
      </div>

      <p data-reveal class="mt-6 text-sm text-muted">
        <span class="text-fg">Git</span> e <span class="text-fg">GitHub</span> versionando todas as etapas.
      </p>
    </div>
  </div>
</section>

<style>
  /* Linha embaixo do card ativo */
  .etl-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  [aria-selected='true'] .etl-progress {
    transform: scaleX(1);
  }

  /* Painéis empilhados no mesmo espaço: a área fica com a altura do maior e a página não pula ao trocar */
  .etl-panels {
    display: grid;
  }

  .etl-panels > [role='tabpanel'] {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .etl-panels > [role='tabpanel'][hidden] {
    display: block;
    visibility: hidden;
  }

  .etl-panels > [role='tabpanel']:not([hidden]) {
    animation: etl-fade 0.3s ease;
  }

  @keyframes etl-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  // Caso de ETL: troca o painel ao clicar em uma etapa
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-etl]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      let clicked = false;

      const select = (tab: HTMLButtonElement) =>
        tabs.forEach((t) => {
          const selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!;
          panel.hidden = !selected;
          // Painéis dividem o mesmo espaço: código aberto num painel escondido deixaria a área alta e vazia
          if (!selected) panel.querySelectorAll('details').forEach((d) => (d.open = false));
        });

      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          clicked = true;
          select(tab);
        }),
      );

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // Na primeira vez que os cards aparecem, passa pelas etapas 2, 3 e 4 e volta à 1,
      // mostrando que os cards são clicáveis. Um clique interrompe a passagem.
      const sweep = () =>
        [...tabs.slice(1), tabs[0]].forEach((tab, step) =>
          setTimeout(() => !clicked && select(tab), (step + 1) * 1200),
        );

      const tablist = root.querySelector('[role="tablist"]')!;
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          // Espera o fade de entrada dos cards terminar
          setTimeout(() => !clicked && sweep(), 500);
        },
        { threshold: 0.6 },
      );
      io.observe(tablist);
    });
  });
</script>
