---
import Secao from './Secao.astro';
import { idiomaDe, textos } from '../i18n';

// Como eu trabalho: 4 princípios de negócio, mostrados como um processo, um de cada vez, cada um com uma cena
// própria (um gráfico, não um texto): o pedido vago que vira pergunta, o número que ganha contexto, o termo técnico
// que vira uma frase de quem decide e a matriz que diz o que fazer primeiro.
// - Telas largas: a seção fica presa na tela enquanto a pessoa rola. O trilho em cima (o fio deitado) se enche com a
//   rolagem e, a cada ponto que ele alcança, o palco troca de cena. Os nomes no trilho também levam direto à cena.
// - Celular, movimento reduzido ou sem JS: as cenas ficam uma embaixo da outra; cada uma roda quando aparece.
// - Com movimento reduzido, as cenas já aparecem no estado final.
const idioma = idiomaDe(Astro.url);
const tx = textos[idioma].trabalho;
const principios = tx.principios;

// Contexto: o faturamento dos últimos 6 meses (em mil), com a meta. O mês atual (o último) caiu 8% e ficou em 92% da meta
const meses = [112, 118, 124, 126, 130, 120];
const meta = 130;
const teto = 140;

// O que cada cena mostra, em texto, para o leitor de tela (a cena em si é só visual)
const resumos = [
  `${tx.exemplo}: ${tx.d1.pedidoTag} ${tx.d1.pedido} ${tx.d1.perguntaTag}: ${tx.d1.perguntaAntes}${tx.d1.perguntaDestaque}${tx.d1.perguntaDepois} ${tx.d1.medidas.join(', ')}.`,
  `${tx.exemplo}: ${tx.d2.tag}, ${tx.d2.moeda} ${tx.d2.valor}. ▼ 8% ${tx.d2.vsMes.toLowerCase()}. ${tx.d2.atencao}: ${tx.d2.falta}.`,
  `${tx.exemplo}: ${tx.d3.tecnicoTag}: ${tx.d3.tecnico}. ${tx.d3.quemDecideTag}: ${tx.d3.destaque}${tx.d3.frase}`,
  `${tx.exemplo}: ${tx.d4.tag}. ${tx.d4.quadrantes.map((q) => `${q.task}: ${q.tag}`).join('. ')}.`,
];

// Prioridade: cada tarefa no seu quadrante (x = esforço, y = impacto, em % do plano; y cresce para baixo).
// A ordem é a dos dados: alto impacto e pouco esforço, alto impacto e muito esforço, pouco e pouco, pouco e muito
const posicoes = [
  { x: 23, y: 27 },
  { x: 72, y: 20 },
  { x: 27, y: 73 },
  { x: 74, y: 70 },
];
---

<div id="habilidades" data-processo>
  <Secao titulo={tx.titulo}>
    <div class="pc" data-fio-fim>
      <div class="pc-pista">
        <div class="pc-palco">
          <!-- O trilho: o fio deitado, que se enche com a rolagem; um ponto (e o nome) para cada princípio -->
          <nav class="pc-trilho" aria-label={tx.lista}>
            <span class="pc-linha" aria-hidden="true"><span class="pc-linha-cheia"></span></span>
            {
              principios.map((p, i) => (
                <button type="button" class="pc-no" data-ir={i} style={`--i: ${i}`}>
                  <span class="pc-ponto" aria-hidden="true" />
                  <span class="pc-nome">{p.short}</span>
                </button>
              ))
            }
          </nav>

          <ol class="pc-passos">
            {
              principios.map((p, i) => (
                <li class:list={['pc-passo', i === 0 && 'is-ativo']} data-passo>
                  <div class="pc-cab">
                    <p class="pc-curto">{p.short}</p>
                    <h3 class="pc-titulo">{p.title}</h3>
                    <p class="pc-texto">{p.text}</p>
                    <p class="sr-only">{resumos[i]}</p>
                  </div>

                  <div class="pc-cena" data-cena aria-hidden="true">
                    {i === 0 && (
                      <div class="c1">
                        <div>
                          <p class="c-tag">{tx.d1.pedidoTag}</p>
                          <p class="c1-pedido d-pop">
                            <span class="d-strike" style="--s: 0.9s">{tx.d1.pedido}</span>
                          </p>
                        </div>
                        <span class="c-seta d-risco" style="--d: 1.1s" />
                        <div>
                          <p class="c-tag d-pop" style="--d: 1.5s">{tx.d1.perguntaTag}</p>
                          <p class="c1-pergunta d-pop" style="--d: 1.5s">
                            {tx.d1.perguntaAntes}
                            <em class="d-destaque">{tx.d1.perguntaDestaque}</em>
                            {tx.d1.perguntaDepois}
                          </p>
                          <ul class="c-chips d-pop" style="--d: 1.5s">
                            {tx.d1.medidas.map((m, k) => (
                              <li>{m}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    )}

                    {i === 1 && (
                      <div class="c2">
                        <div>
                          <p class="c-tag">{tx.d2.tag}</p>
                          <p class="c2-valor">
                            <span>{tx.d2.moeda}</span> {tx.d2.valor}
                          </p>
                          <p class="c2-nota d-pop" style="--d: 1.7s">
                            <b>▼ 8%</b> {tx.d2.vsMes.toLowerCase()}
                          </p>
                          <p class="c2-nota d-pop" style="--d: 1.7s">
                            <span class="d-selo">{tx.d2.atencao}</span> {tx.d2.falta}
                          </p>
                        </div>
                        <div class="c2-grafico">
                          {meses.map((v, k) => (
                            <span
                              class:list={['c2-barra d-cresce', k === meses.length - 1 && 'c2-atual']}
                              style={`--h: ${(v / teto) * 100}%; --d: ${0.2 + k * 0.12}s`}
                            />
                          ))}
                          <span class="c2-meta d-risco" style={`--y: ${(meta / teto) * 100}%; --d: 1.1s`}>
                            <span class="c2-meta-rotulo">{tx.d2.meta}</span>
                          </span>
                        </div>
                      </div>
                    )}

                    {i === 2 && (
                      <div class="c3">
                        <div>
                          <p class="c-tag">{tx.d3.tecnicoTag}</p>
                          <p class="c3-codigo d-pop">
                            <span class="d-strike" style="--s: 0.9s">{tx.d3.tecnico}</span>
                          </p>
                          <p class="c-tag d-pop c3-tag2" style="--d: 1.4s">{tx.d3.quemDecideTag}</p>
                          <p class="c3-frase d-pop" style="--d: 1.4s">
                            <em class="d-destaque">{tx.d3.destaque}</em>
                            {tx.d3.frase}
                          </p>
                        </div>
                        <div class="c3-pontos">
                          {Array.from({ length: 24 }, (_, k) => (
                            <span class:list={[k === 23 && 'd-hit']} />
                          ))}
                        </div>
                      </div>
                    )}

                    {i === 3 && (
                      <div class="c4">
                        <div class="c4-plano">
                          <span class="c4-eixo c4-eixo-y">↑ {tx.d4.impacto}</span>
                          <span class="c4-eixo c4-eixo-x">{tx.d4.esforco} →</span>
                          {tx.d4.quadrantes.map((q, k) => (
                            <div
                              class:list={['c4-item d-pop', q.win && 'c4-vence']}
                              style={`--x: ${posicoes[k].x}%; --y: ${posicoes[k].y}%; --d: 0.3s`}
                            >
                              <span class="c4-ponto" />
                              <span class="c4-texto">
                                {q.task}
                                <small>{q.tag}</small>
                              </span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </Secao>
</div>

<style>
  /* ---------- Modo empilhado (celular, sem JS, movimento reduzido) ----------
     As cenas uma embaixo da outra, cada uma com o nome e o título em cima. O trilho não aparece. */
  .pc {
    margin-top: 2.6rem;
  }

  .pc-trilho {
    display: none;
  }

  .pc-passos {
    display: grid;
    gap: 3.5rem;
    padding: 0;
    list-style: none;
  }

  .pc-cab {
    max-width: 38rem;
  }

  .pc-curto {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 800;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pc-titulo {
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .pc-texto {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ---------- O palco: a cena, em azul-marinho, com a luz e o grão do papel ---------- */
  .pc-cena {
    --color-heading: var(--color-sunset);
    --color-fg: var(--color-sunset);
    --color-muted: #aab0c6;
    --linha: rgb(236 232 223 / 0.16);
    position: relative;
    margin-top: 1.4rem;
    padding: 1.6rem 1.4rem;
    overflow: hidden;
    border-radius: 1.25rem;
    background-image:
      radial-gradient(ellipse 70% 80% at 30% 0%, rgb(120 135 190 / 0.28), transparent 70%),
      var(--textura-grao),
      linear-gradient(160deg, #1b2147, #10142c);
    background-size: 100% 100%, 240px, 100% 100%;
    box-shadow: 0 30px 60px -30px rgb(16 20 44 / 0.55);
    color: var(--color-fg);
  }

  .c-tag {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* ---------- Telas largas: a seção presa na tela, uma cena por vez ----------
     A pista é alta (a rolagem que move o trilho); o palco fica preso no topo dela. Só com o script (.is-rolagem). */
  @media (min-width: 56rem) {
    .pc.is-rolagem .pc-pista {
      height: calc(100svh - 6rem + 210svh);
    }

    .pc.is-rolagem .pc-palco {
      position: sticky;
      top: 5.5rem;
      display: flex;
      flex-direction: column;
      height: calc(100svh - 6rem);
      min-height: 34rem;
      padding-top: 1rem;
    }

    .pc.is-rolagem .pc-trilho {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      flex: none;
    }

    /* a linha passa pelo centro dos pontos, de ponta a ponta; a parte cheia cresce da esquerda (--cheio, do script) */
    .pc-linha {
      position: absolute;
      top: 0.55rem;
      left: 0;
      right: 0;
      height: 1.5px;
      background: rgb(20 25 55 / 0.18);
    }

    .pc-linha-cheia {
      position: absolute;
      inset: 0;
      background: var(--color-fio);
      transform: scaleX(var(--cheio, 0.125));
      transform-origin: left;
    }

    .pc-no {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 0 0.5rem 0.4rem;
      cursor: pointer;
    }

    .pc-ponto {
      width: 1.1rem;
      height: 1.1rem;
      border: 1.5px solid var(--color-fio);
      border-radius: 9999px;
      background: var(--color-sunset);
      transition:
        background-color 0.35s ease,
        transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .pc-no.is-feito .pc-ponto {
      background: var(--color-latao);
    }

    .pc-no[aria-current] .pc-ponto {
      transform: scale(1.35);
    }

    .pc-nome {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 800;
      font-stretch: 75%;
      font-variation-settings: 'wdth' 75;
      line-height: 1;
      text-transform: uppercase;
      color: var(--color-astro);
      transition: color 0.3s ease;
    }

    .pc-no:hover .pc-nome,
    .pc-no[aria-current] .pc-nome {
      color: var(--color-heading);
    }

    .pc-no:focus-visible {
      outline-offset: 2px;
      border-radius: 0.5rem;
    }

    /* as cenas empilhadas no mesmo lugar: só a ativa aparece */
    .pc.is-rolagem .pc-passos {
      flex: 1;
      display: grid;
      gap: 0;
      min-height: 0;
      margin-top: 2.2rem;
    }

    .pc.is-rolagem .pc-passo {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      /* só some na tela: o leitor de tela continua lendo os quatro princípios, na ordem */
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px);
      transition:
        opacity 0.3s ease,
        transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .pc.is-rolagem .pc-passo.is-ativo {
      opacity: 1;
      pointer-events: auto;
      transform: none;
      transition:
        opacity 0.35s ease 0.2s,
        transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
    }

    /* o nome já está no trilho: na cena ficam só o título e a frase, centralizados */
    .pc.is-rolagem .pc-curto {
      display: none;
    }

    .pc.is-rolagem .pc-cab {
      margin-inline: auto;
      text-align: center;
    }

    /* o palco ocupa o espaço que sobra, até 30rem de altura, e as cenas crescem para preencher */
    .pc.is-rolagem .pc-cena {
      flex: 1;
      display: grid;
      align-items: center;
      min-height: 0;
      max-height: 30rem;
      margin-top: 1.6rem;
      margin-bottom: 1.5rem;
      padding: 2.5rem 4rem;
    }

    .pc-cena {
      padding: 2.2rem 2.6rem;
    }

    .pc.is-rolagem .c1-pedido {
      font-size: 1.6rem;
    }

    .pc.is-rolagem .c1-pergunta,
    .pc.is-rolagem .c3-frase {
      font-size: 2.15rem;
    }

    .pc.is-rolagem .c-chips li {
      font-size: 1rem;
    }

    .pc.is-rolagem .c2-valor {
      font-size: 3.6rem;
    }

    .pc.is-rolagem .c2-valor span {
      font-size: 1.6rem;
    }

    .pc.is-rolagem .c2-nota {
      font-size: 1rem;
    }

    .pc.is-rolagem .c2-grafico {
      height: min(15rem, 32svh);
      gap: 0.9rem;
    }

    .pc.is-rolagem .c3-codigo {
      font-size: 1.35rem;
    }

    .pc.is-rolagem .c3-pontos {
      max-width: 26rem;
      gap: 0.8rem;
    }

    .pc.is-rolagem .c4-plano {
      height: min(19rem, 38svh);
      margin-top: 0;
    }

    .pc.is-rolagem .c4-texto {
      font-size: 1rem;
    }

    .pc.is-rolagem .c4-texto small {
      font-size: 0.8125rem;
    }

    .pc.is-rolagem .c4-item {
      max-width: 14rem;
    }
  }

  /* ---------- As cenas ---------- */

  /* Problema: o pedido vago é riscado, uma seta leva à pergunta de negócio e ao que medir */
  .c1 {
    display: grid;
    gap: 1.2rem;
  }

  .c1-pedido {
    margin-top: 0.4rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    color: rgb(236 232 223 / 0.55);
  }

  .c1-pergunta {
    margin-top: 0.4rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .c-seta {
    position: relative;
    justify-self: start;
    width: 1.5px;
    height: 2.2rem;
    margin-left: 0.4rem;
    background: var(--color-latao);
    transform-origin: top;
  }

  .c-seta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: -4px;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid var(--color-latao);
    border-bottom: 1.5px solid var(--color-latao);
    transform: rotate(45deg);
  }

  .c-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
  }

  .c-chips li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: 9999px;
    font-size: 0.875rem;
  }

  /* Contexto: o valor sozinho, e o gráfico dos últimos meses com a meta mostra que ele caiu e não bateu */
  .c2 {
    display: grid;
    gap: 1.6rem;
  }

  .c2-valor {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .c2-valor span {
    font-size: 1.3rem;
  }

  .c2-nota {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .c2-nota b {
    color: var(--color-heading);
  }

  .c2-nota + .c2-nota {
    margin-top: 0.5rem;
  }

  .c2-grafico {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
    gap: 0.6rem;
    height: 10rem;
    border-bottom: 1px solid var(--linha);
  }

  .c2-barra {
    height: var(--h);
    border-radius: 0.3rem 0.3rem 0 0;
    background: rgb(236 232 223 / 0.4);
    transform-origin: bottom;
  }

  .c2-atual {
    background: var(--color-latao);
  }

  .c2-meta {
    position: absolute;
    left: -0.3rem;
    right: -0.3rem;
    bottom: var(--y);
    border-top: 1.5px dashed var(--color-sunset);
    transform-origin: left;
  }

  .c2-meta-rotulo {
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-sunset);
  }

  /* Linguagem: o termo técnico é riscado e vira uma frase; nos 24 clientes, um sai */
  .c3 {
    display: grid;
    gap: 1.6rem;
  }

  .c3-codigo {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: rgb(236 232 223 / 0.55);
  }

  .c3-tag2 {
    margin-top: 1.4rem;
  }

  .c3-frase {
    margin-top: 0.4rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .c3-pontos {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.6rem;
    max-width: 20rem;
  }

  .c3-pontos span {
    aspect-ratio: 1;
    border-radius: 9999px;
    background: rgb(236 232 223 / 0.4);
  }

  .c3-pontos .d-hit {
    background: var(--color-latao);
    box-shadow: 0 0 0 5px rgb(176 141 87 / 0.25);
  }

  /* Prioridade: cada tarefa é um ponto no plano impacto × esforço; a que vence acende em latão */
  .c4-plano {
    position: relative;
    height: 15rem;
    margin-block: 1.6rem 1.4rem;
    border-left: 1px solid var(--linha);
    border-bottom: 1px solid var(--linha);
    background:
      linear-gradient(var(--linha), var(--linha)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--linha), var(--linha)) 0 50% / 100% 1px no-repeat;
  }

  .c4-eixo {
    position: absolute;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .c4-eixo-y {
    top: -1.5rem;
    left: 0;
  }

  .c4-eixo-x {
    right: 0;
    bottom: -1.5rem;
  }

  .c4-item {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    max-width: 11rem;
    translate: -0.45rem -0.45rem;
  }

  .c4-ponto {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.2rem;
    border-radius: 9999px;
    background: rgb(236 232 223 / 0.4);
  }

  .c4-texto {
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-muted);
  }

  .c4-texto small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .c4-vence .c4-ponto {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.05rem;
    background: var(--color-latao);
    box-shadow: 0 0 0 6px rgb(176 141 87 / 0.25);
  }

  .c4-vence .c4-texto {
    font-weight: 700;
    color: var(--color-heading);
  }

  .c4-vence small {
    color: var(--color-latao);
    opacity: 1;
  }

  /* Telas a partir de tablet: as cenas em duas colunas (o antes à esquerda, o depois à direita) */
  @media (min-width: 40rem) {
    .c1 {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.35fr);
      align-items: center;
      gap: 2rem;
    }

    .c-seta {
      align-self: center;
      width: 3rem;
      height: 1.5px;
      margin: 0;
      transform-origin: left;
    }

    .c-seta::after {
      top: -4px;
      right: 0;
      bottom: auto;
      left: auto;
      border-bottom: 0;
      border-top: 1.5px solid var(--color-latao);
    }

    .c2,
    .c3 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 3rem;
    }
  }

  /* ---------- As animações das cenas ----------
     Sem a classe is-play, tudo fica no estado final (sem JS ou com movimento reduzido). Com is-play, cada peça roda a
     sua animação uma vez, com o atraso --d. */
  .d-destaque {
    font-style: normal;
    color: var(--color-latao);
  }

  .d-selo {
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-latao);
    color: var(--color-navy);
    font-weight: 600;
  }

  .is-play .d-pop {
    animation: d-pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes d-pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* o pedido vago e o termo técnico são riscados depois de aparecer (atraso --s) */
  .d-strike {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--color-latao);
  }

  .is-play .d-strike {
    animation: d-strike 0.5s ease var(--s, 0s) both;
  }

  @keyframes d-strike {
    from {
      color: var(--color-sunset);
      text-decoration-color: transparent;
    }
  }

  /* linhas que se desenham (a seta, a meta) */
  .is-play .d-risco {
    animation: d-risco 0.6s cubic-bezier(0.65, 0, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes d-risco {
    from {
      transform: scale(0);
      opacity: 0;
    }
  }

  /* barras que crescem de baixo */
  .is-play .d-cresce {
    animation: d-cresce 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes d-cresce {
    from {
      transform: scaleY(0);
    }
  }

  /* o cliente que saiu: acende e pulsa depois que a frase aparece */
  .is-play .d-hit {
    animation: d-hit 0.7s ease 1.9s both;
  }

  @keyframes d-hit {
    from {
      background-color: rgb(236 232 223 / 0.4);
      box-shadow: 0 0 0 0 rgb(176 141 87 / 0);
      transform: scale(1);
    }
    50% {
      transform: scale(1.4);
    }
  }

  /* a tarefa que vence: aparece como as outras e, por último, acende */
  .is-play .c4-vence .c4-ponto {
    animation: d-vence 0.7s ease 1.2s both;
  }

  @keyframes d-vence {
    from {
      background-color: rgb(236 232 223 / 0.4);
      box-shadow: 0 0 0 0 rgb(176 141 87 / 0);
    }
  }

  .is-play .c4-vence .c4-texto {
    animation: d-vence-texto 0.7s ease 1.2s both;
  }

  @keyframes d-vence-texto {
    from {
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-passo,
    .pc-ponto {
      transition: none !important;
    }
  }
</style>

<script>
  // Telas largas: a rolagem dentro da pista move o trilho e escolhe a cena. Senão, cada cena roda quando aparece.
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-processo]');
    const pc = root?.querySelector<HTMLElement>('.pc');
    const pista = root?.querySelector<HTMLElement>('.pc-pista');
    const palco = root?.querySelector<HTMLElement>('.pc-palco');
    const trilho = root?.querySelector<HTMLElement>('.pc-trilho');
    if (!root || !pc || !pista || !palco || !trilho) return;

    const passos = [...root.querySelectorAll<HTMLElement>('[data-passo]')];
    const cenas = passos.map((p) => p.querySelector<HTMLElement>('[data-cena]')!);
    const nos = [...root.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const largo = matchMedia('(min-width: 56rem)');
    const controller = new AbortController();
    const { signal } = controller;

    // Reinicia as animações da cena (tirar e pôr a classe faz elas rodarem de novo)
    const rodar = (el: HTMLElement) => {
      if (reduzido) return;
      el.classList.remove('is-play');
      void el.offsetWidth;
      el.classList.add('is-play');
    };

    // ----- Modo rolagem (telas largas) -----
    // t vai de 0 a 3 com a rolagem: a linha chega ao ponto i quando t = i, e é aí que a cena i entra
    const PASSO = 3.4; // um pouco mais que 3, para a última cena ficar um tempo na tela antes de a seção soltar
    let ativo = -1;
    let visto = false;
    let quadro = 0;

    const distancia = () => pista.offsetHeight - palco.offsetHeight;
    const topoPreso = () => parseFloat(getComputedStyle(palco).top) || 0;

    const ativar = (i: number) => {
      if (i === ativo) return;
      ativo = i;
      passos.forEach((p, k) => p.classList.toggle('is-ativo', k === i));
      nos.forEach((n, k) => {
        n.classList.toggle('is-feito', k <= i);
        if (k === i) n.setAttribute('aria-current', 'step');
        else n.removeAttribute('aria-current');
      });
      if (visto) rodar(cenas[i]);
    };

    const aplicar = () => {
      quadro = 0;
      const d = distancia();
      const p = d > 0 ? Math.min(1, Math.max(0, (topoPreso() - pista.getBoundingClientRect().top) / d)) : 0;
      const t = Math.min(3, p * PASSO);
      trilho.style.setProperty('--cheio', (0.125 + 0.25 * t).toFixed(4));
      ativar(Math.floor(t + 0.001));
    };
    const pedir = () => {
      if (!quadro) quadro = requestAnimationFrame(aplicar);
    };

    // Os nomes no trilho levam direto à cena: rola até o ponto em que a linha acabou de passar por ele
    nos.forEach((n, i) =>
      n.addEventListener(
        'click',
        () => {
          const alvo = pista.getBoundingClientRect().top + scrollY - topoPreso() + ((i + 0.3) / PASSO) * distancia();
          scrollTo({ top: alvo, behavior: reduzido ? 'auto' : 'smooth' });
        },
        { signal },
      ),
    );

    // A primeira cena só roda quando o palco aparece de verdade
    const ioPalco = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting || visto) return;
        visto = true;
        if (ativo >= 0) rodar(cenas[ativo]);
      },
      { threshold: 0.4 },
    );

    // ----- Modo empilhado: cada cena roda (uma vez) quando aparece -----
    const ioCenas = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          ioCenas.unobserve(e.target);
          rodar(e.target as HTMLElement);
        }
      },
      { threshold: 0.45 },
    );

    const modo = () => {
      const rolagem = largo.matches && !reduzido;
      pc.classList.toggle('is-rolagem', rolagem);
      ioPalco.disconnect();
      ioCenas.disconnect();
      if (rolagem) {
        ativo = -1; // recalcula a cena ativa do zero (vindo do modo empilhado, todas estavam ativas)
        ioPalco.observe(palco);
        aplicar();
      } else {
        passos.forEach((p) => p.classList.add('is-ativo'));
        cenas.forEach((c) => ioCenas.observe(c));
      }
    };

    modo();
    largo.addEventListener('change', modo, { signal });
    addEventListener('scroll', () => pc.classList.contains('is-rolagem') && pedir(), { passive: true, signal });
    addEventListener('resize', () => pc.classList.contains('is-rolagem') && pedir(), { signal });

    cleanup = () => {
      controller.abort();
      ioPalco.disconnect();
      ioCenas.disconnect();
      cancelAnimationFrame(quadro);
    };
  });
</script>
