---
import SectionTitle from './SectionTitle.astro';

// Competências: o que é feito com as ferramentas (as ferramentas ficam só no pipeline)
const groups = [
  { title: 'Análise de Dados', items: ['Aplicação de regras de negócio', 'Estatística descritiva'] },
  { title: 'Preparação de Dados para BI', items: ['ETL', 'Limpeza e tratamento'] },
];

// Pipeline: onde cada ferramenta entra no processo
const pipeline = [
  { stage: 'Extração', tools: ['SQL', 'Python'] },
  { stage: 'Tratamento', tools: ['pandas', 'Excel'] },
  { stage: 'Armazenamento', tools: ['PostgreSQL', 'MySQL'] },
  { stage: 'Visualização', tools: ['Power BI', 'DAX', 'Excel'] },
];
---

<section id="habilidades" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionTitle title="Ferramentas do dia a dia" />

    <div class="mt-12">
      <p data-reveal class="text-sm text-muted">Onde cada ferramenta entra</p>
      <ol class="mt-6 grid border-y border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          pipeline.map((p, i) => (
            <li
              data-reveal
              style={`--delay: ${i * 100}ms`}
              class="border-line py-5 not-first:border-t sm:even:pl-5 sm:nth-2:border-t-0 lg:pl-5 lg:first:pl-0 lg:not-first:border-t-0 lg:not-first:border-l"
            >
              <p class="text-sm font-medium text-heading">
                <span class="mr-2 text-accent">{i + 1}</span>
                {p.stage}
              </p>
              <p class="mt-2 text-fg/85">{p.tools.join(', ')}</p>
            </li>
          ))
        }
      </ol>
      <p data-reveal class="mt-4 text-sm text-muted">
        <span class="text-fg">Git</span> e <span class="text-fg">GitHub</span> versionando todas as etapas.
      </p>
    </div>

    <p data-reveal class="mt-16 text-sm text-muted">O que faço com elas</p>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      {
        groups.map((g, i) => (
          <div data-reveal style={`--delay: ${i * 100}ms`}>
            <p class="border-b border-line pb-3 font-semibold text-heading">{g.title}</p>
            <ul class="mt-4 space-y-2.5">
              {g.items.map((item) => (
                <li class="flex gap-2.5 text-fg/85">
                  <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-accent" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
