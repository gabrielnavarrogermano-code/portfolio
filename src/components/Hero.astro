---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel.png';
import { site } from '../data/site';

const words = ['extração e tratamento de dados', 'pipelines de ETL', 'dashboards e KPIs'];
---

<section id="inicio" class="hero-grid relative isolate flex min-h-svh flex-col pt-28 pb-8 sm:pt-32">
  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-6">
    <div class="flex flex-1 flex-col items-center justify-center text-center">
      <Image
        src={foto}
        alt="Foto de Gabriel Navarro Germano"
        widths={[160, 320]}
        sizes="(min-width: 640px) 160px, 128px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="h-32 w-32 rounded-full border border-line object-cover object-[50%_30%] ring-2 ring-accent/30 ring-offset-4 ring-offset-bg sm:h-40 sm:w-40"
      />

      <div class="mt-8">
        <h1 class="tracking-tight text-heading">
          <span class="block font-sans text-base font-medium tracking-normal text-muted sm:text-lg">
            Gabriel Navarro Germano
          </span>
          <span class="mt-3 block text-3xl leading-tight font-bold sm:text-4xl">Análise de Dados & BI</span>
        </h1>

        <p data-reveal style="--delay: 150ms" class="mt-5 min-h-10 font-mono text-sm text-accent sm:min-h-5">
          <span class="text-muted">foco:</span>{' '}
          <span id="typed" data-words={JSON.stringify(words)}>{words[0]}</span><span class="caret"></span>
        </p>

        <div data-reveal style="--delay: 250ms" class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#habilidades"
            class="group inline-flex items-center gap-2 rounded-full bg-heading px-6 py-3 font-medium text-bg transition hover:bg-heading/80"
          >
            Ver como trabalho
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a
            href="#contato"
            class="inline-flex items-center rounded-full border border-line bg-bg px-6 py-3 font-medium text-heading transition hover:border-heading/40 hover:bg-heading/5"
          >
            Entre em contato
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-heading/40 hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-heading/40 hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.02c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <a
      href="#apresentacao"
      aria-label="Rolar para a apresentação"
      class="mx-auto mt-8 inline-flex h-10 w-10 items-center justify-center rounded-full text-muted transition hover:text-heading motion-safe:animate-bounce"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
        <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<script>
  let timer: number | undefined;
  let observer: IntersectionObserver | undefined;

  function initHero() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Efeito de digitação
    const typed = document.getElementById('typed');
    if (!typed) return;
    const words: string[] = JSON.parse(typed.dataset.words ?? '[]');
    let w = 0;
    let i = words[0].length;
    let deleting = true;
    let visible = true;
    const tick = () => {
      if (!visible) return;
      const word = words[w];
      i += deleting ? -1 : 1;
      typed.textContent = word.slice(0, i);
      let delay = deleting ? 45 : 90;
      if (!deleting && i === word.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && i === 0) {
        deleting = false;
        w = (w + 1) % words.length;
        delay = 300;
      }
      timer = window.setTimeout(tick, delay);
    };

    // Fora da tela não digita: cada letra faz o navegador recalcular a página
    let started = false;
    observer?.disconnect();
    observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      clearTimeout(timer);
      if (visible) timer = window.setTimeout(tick, started ? 300 : 2000);
      started = true;
    });
    observer.observe(typed);
  }

  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', () => {
    clearTimeout(timer);
    observer?.disconnect();
  });
</script>
