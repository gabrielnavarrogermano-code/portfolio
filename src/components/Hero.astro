---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel.png';

const words = [
  'Análise e visualização de dados',
  'Soluções ETL',
  'Tomada de decisões através de insights',
];

const facts = [
  { label: 'Formação', value: 'Engenharia de Software · UniCesumar' },
  { label: 'Hoje', value: "Estagiário de TI · Hebe's Life Science" },
  { label: 'Buscando', value: 'Estágio ou vaga júnior em Dados' },
];
---

<section id="inicio" class="pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="max-w-3xl">
      <div data-reveal>
        <Image
          src={foto}
          alt="Foto de Gabriel Navarro Germano"
          width={256}
          height={256}
          format="webp"
          loading="eager"
          class="h-24 w-24 rounded-full border border-line object-cover object-[50%_30%] ring-2 ring-accent/30 ring-offset-2 ring-offset-bg sm:h-32 sm:w-32"
        />
      </div>

      <h1 data-reveal style="--delay: 100ms" class="mt-8 text-4xl font-bold tracking-tight text-heading sm:text-6xl">
        Gabriel Navarro Germano
      </h1>

      <p data-reveal style="--delay: 200ms" class="mt-4 min-h-14 text-lg text-accent sm:min-h-8 sm:text-xl">
        <span id="typed" data-words={JSON.stringify(words)}>{words[0]}</span><span class="caret"></span>
      </p>

      <div data-reveal style="--delay: 400ms" class="mt-8 flex flex-wrap gap-3">
        <a
          href="#habilidades"
          class="group inline-flex items-center gap-2 rounded-full bg-heading px-6 py-3 font-medium text-bg transition hover:bg-heading/80"
        >
          Ver habilidades
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="#contato"
          class="inline-flex items-center rounded-full border border-line px-6 py-3 font-medium text-heading transition hover:border-heading/40 hover:bg-heading/5"
        >
          Entre em contato
        </a>
      </div>
    </div>

    <dl data-reveal style="--delay: 500ms" class="mt-16 grid gap-6 border-t border-line pt-8 sm:grid-cols-3">
      {
        facts.map((f) => (
          <div>
            <dt class="text-sm text-muted">{f.label}</dt>
            <dd class="mt-1 text-heading">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  let timer: number | undefined;

  function initHero() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Efeito de digitação
    const typed = document.getElementById('typed');
    if (!typed) return;
    const words: string[] = JSON.parse(typed.dataset.words ?? '[]');
    let w = 0;
    let i = words[0].length;
    let deleting = true;
    const tick = () => {
      const word = words[w];
      i += deleting ? -1 : 1;
      typed.textContent = word.slice(0, i);
      let delay = deleting ? 45 : 90;
      if (!deleting && i === word.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && i === 0) {
        deleting = false;
        w = (w + 1) % words.length;
        delay = 300;
      }
      timer = window.setTimeout(tick, delay);
    };
    timer = window.setTimeout(tick, 2000);
  }

  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', () => clearTimeout(timer));
</script>
