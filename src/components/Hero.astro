---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel.png';
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';

const focus = ['Excel', 'Power BI', 'ETL'];

// Abertura, primeiro ato: números soltos espalhados pela tela (x, y em % da tela). O tamanho (s) dá a
// profundidade: 1 = pequeno e longe, 3 = grande e perto (perde mais o foco). Quando a frase entra em foco,
// eles desfocam e somem, como uma câmera mudando o foco do fundo para a frente.
// Depois, a lista de pessoas (fictícias) que a consulta filtra: fase 1 = WHERE área = 'Dados';
// fase 2 = AND foco = 'Power BI'. Sobra você.
const soltos = [
  { t: '3,2', x: 12, y: 18, s: 2 },
  { t: '47', x: 28, y: 9, s: 1 },
  { t: '0,8', x: 71, y: 13, s: 3 },
  { t: '112', x: 89, y: 27, s: 1 },
  { t: '28%', x: 9, y: 45, s: 3 },
  { t: '64', x: 92, y: 53, s: 2 },
  { t: '9', x: 19, y: 73, s: 1 },
  { t: '1.024', x: 79, y: 79, s: 3 },
  { t: '15', x: 47, y: 89, s: 2 },
  { t: '0,31', x: 63, y: 67, s: 1 },
  { t: '21', x: 36, y: 29, s: 1 },
  { t: '73%', x: 56, y: 22, s: 2 },
  { t: '6', x: 31, y: 64, s: 3 },
  { t: '2,5', x: 85, y: 93, s: 1 },
  { t: '340', x: 7, y: 88, s: 2 },
];
const acima = [
  { nome: 'Ana Souza', area: 'RH', fase: 1 },
  { nome: 'Lucas Prado', area: 'Dados', fase: 2 },
];
const abaixo = [
  { nome: 'Carla Dias', area: 'Dados', fase: 2 },
  { nome: 'Rafael Melo', area: 'Logística', fase: 1 },
  { nome: 'Thiago Rocha', area: 'Dados', fase: 2 },
];
---

<!-- Abertura: na primeira visita da sessão, antes de pintar a capa, liga a animação de abertura.
     Quem pediu menos movimento (ou já viu nesta sessão) vai direto para o site. -->
<script is:inline>
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('intro-seen')) return;
      sessionStorage.setItem('intro-seen', '1');
      var root = document.documentElement;
      root.classList.add('show-intro', 'intro-pending');
      // Trava de segurança: se algo falhar, em 7,5 s o site aparece e a rolagem volta
      setTimeout(function () {
        root.classList.remove('show-intro', 'intro-pending', 'name-flying', 'name-hold');
      }, 7500);
    } catch (e) {}
  })();
</script>

<!-- Abertura, automática (uns 5 segundos), no traço do site:
     1. "Números soltos não dizem nada": números espalhados flutuam pela tela; a frase entra em foco no
        centro enquanto eles desfocam e somem (como uma câmera mudando o foco);
     2. "Procurando alguém para cuidar dos seus dados?": com o filtro aplicado (a busca do recrutador), a lista risca as pessoas até sobrar
        o seu nome, selecionado;
     3. o fundo some e cada palavra do nome sai da lista e voa até o seu lugar na capa; a capa carrega
        como um dashboard (blocos enchendo como barras, o ano contando). Se a pessoa pular antes de a lista
        aparecer, a tela sobe como uma cortina.
     Qualquer clique, toque, rolagem ou tecla pula direto para a capa. -->
<div data-intro class="intro on-black fixed inset-0 z-[100] items-center justify-center overflow-hidden bg-bg" aria-hidden="true">
  <div class="intro-act1 absolute inset-0">
    {
      soltos.map((n, i) => (
        <span class={`il-num il-s${n.s}`} style={`left: ${n.x}%; top: ${n.y}%; --d: ${((i * 7) % 10) * 0.04}s; --dx: ${((i * 37) % 21) - 10}px; --dy: ${((i * 23) % 17) - 8}px`}>
          {n.t}
        </span>
      ))
    }
    <p class="intro-focus absolute inset-x-0 top-1/2 -translate-y-1/2 px-6 text-center font-serif text-[1.9rem] leading-tight text-balance text-heading sm:text-5xl">
      Números soltos não <em class="whitespace-nowrap">dizem nada.</em>
    </p>
  </div>

  <div class="intro-data absolute w-[min(92vw,32rem)]">
    <p class="intro-q intro-q2 mb-6 font-serif text-[1.6rem] leading-tight text-heading sm:text-4xl">
      Procurando alguém para <em class="text-accent">cuidar dos seus dados?</em>
    </p>
    <p class="font-mono text-[11px] leading-[1.7] text-fg/80 sm:text-xs">
      <b>Filtro</b> área = <i>'Dados'</i> <span aria-hidden="true">·</span> foco = <i>'Power BI'</i>
    </p>
    <ol class="mt-5 border-t border-line">
      {
        acima.map((r) => (
          <li class="ir-row" style={`--d: ${r.fase === 1 ? 3.25 : 3.6}s`}>
            <span class="ir-row-in"><span class="w-24 flex-none text-muted/70">{r.area}</span>{r.nome}</span>
          </li>
        ))
      }
      <li class="ir-me">
        <span class="w-24 flex-none self-start pt-1 font-mono text-[11px] text-accent">Dados</span>
        <!-- Cada palavra é medida no fim da abertura: é dali que o nome da capa sai voando -->
        <span class="ir-me-name font-display font-black uppercase"><span class="ir-w">Gabriel</span> <span class="ir-w">Navarro</span> <span class="ir-w">Germano</span></span>
      </li>
      {
        abaixo.map((r) => (
          <li class="ir-row" style={`--d: ${r.fase === 1 ? 3.3 : 3.65}s`}>
            <span class="ir-row-in"><span class="w-24 flex-none text-muted/70">{r.area}</span>{r.nome}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="intro-skip absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-[10px] tracking-[0.15em] whitespace-nowrap text-muted/70 uppercase">
    ( Toque ou role para pular )
  </p>
</div>

<section id="inicio" class="hero-ice relative isolate flex min-h-svh flex-col pt-20 sm:pt-28">
  <!-- Linha de rótulos no topo -->
  <div class="mx-auto w-full max-w-5xl px-6">
    <!-- A linha de cima é o eixo do "dashboard": se desenha da esquerda para a direita quando a capa carrega -->
    <div class="hero-axis relative flex items-center justify-between gap-4 pt-3 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
      <!-- O que procuro: a bolinha lima funciona como um status, "disponível" (pisca como um indicador ao vivo) -->
      <p class="hero-load flex items-center gap-2" style="--k: 0">
        <span class="hero-dot relative size-1.5 flex-none rounded-full bg-accent" aria-hidden="true"></span>
        Buscando oportunidades em Dados & BI
      </p>
      <p class="hero-load whitespace-nowrap" style="--k: 1"><span class="max-sm:hidden">Portfólio </span><span class="text-heading tabular-nums">( <span data-year>{site.anoEmDois}</span> )</span></p>
    </div>
  </div>

  <!-- Centro, em três colunas: os focos, uma frase de apresentação e os botões.
       Cada bloco (.hero-load) enche da esquerda para a direita, um depois do outro, na ordem de --k -->
  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-6 sm:py-10">
    <div class="grid gap-6 sm:gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)_auto] md:items-start md:gap-10">
      <!-- Frase em serifa (Instrument Serif): contrasta com a Tektur do nome; o destaque em lima vai em itálico -->
      <!-- Abaixo da frase, quem sou hoje em uma linha (o que procuro está no rótulo do topo) -->
      <div class="md:order-2">
        <p class="hero-load max-w-xl font-serif text-[1.8rem] leading-[1.08] text-balance text-heading sm:text-[2.6rem] lg:text-5xl" style="--k: 3">
          Transformo planilhas soltas em <em class="text-accent">dashboards que a equipe usa para decidir.</em>
        </p>
        <p style="--k: 4" class="hero-load mt-4 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:mt-5 sm:text-xs">
          Estagiário de TI <span aria-hidden="true">·</span> Engenharia de Software
        </p>
      </div>

      <!-- Foto em retrato (preto e branco, ganha cor no hover) e os focos logo abaixo; no celular, lado a lado -->
      <div class="flex items-end gap-5 md:order-1 md:flex-col md:items-start md:gap-5">
        <div data-active="view" class="hero-photo w-24 flex-none sm:w-32 md:w-full md:max-w-44">
          <Image
            src={foto}
            alt="Foto de Gabriel Navarro Germano"
            widths={[240, 480]}
            sizes="(min-width: 768px) 176px, 128px"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] size-full object-cover object-[50%_25%]"
          />
        </div>
        <div>
          <p class="hero-load font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs" style="--k: 2">( Foco )</p>
          <ul class="hero-load hero-focus-items text-heading mt-3 font-mono text-sm leading-relaxed sm:text-base" style="--k: 2.5">
            {focus.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>

      <div class="hero-load flex flex-wrap items-center gap-2 sm:gap-3 md:order-3 md:flex-col md:items-end" style="--k: 5">
        <a
          href="#contato"
          class="group inline-flex items-center gap-2 rounded-full bg-heading px-5 py-2 font-medium sm:px-6 sm:py-3 whitespace-nowrap text-bg transition hover:bg-link-strong hover:text-white"
        >
          Entre em contato
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          {
            temCurriculo && (
              <a
                href={site.curriculo}
                download={site.curriculoNome}
                class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-bg font-medium max-sm:size-10 sm:px-5 sm:py-3 text-heading transition hover:border-link hover:bg-link-strong/15"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                  <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="max-sm:sr-only">Currículo</span>
              </a>
            )
          }
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="inline-flex size-10 flex-none sm:size-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex size-10 flex-none sm:size-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.02c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Nome gigante: ocupa a largura da tela (uma linha no computador, três no celular). -->
  <h1 class="hero-name px-3 pb-3 sm:px-4 sm:pb-4">
    <span class="sr-only">{site.name}, Análise de Dados & BI</span>
    <span class="hero-name-text" aria-hidden="true">
      <span class="hero-name-line"><span class="hero-title hero-name-word">Gabriel</span></span>
      <span class="hero-name-line"><span class="hero-title hero-name-word" style="--delay: 0.08s">Navarro</span></span>
      <span class="hero-name-line"><span class="hero-title hero-name-word" style="--delay: 0.16s">Germano</span></span>
    </span>
  </h1>
</section>

<style>
  /* Tektur no peso máximo e na largura mais estreita: um nome alto, apertado, de borda a borda.
     O tamanho sai da largura do h1 (unidade cqi), sem script: medido na Tektur 900 estreita,
     GABRIEL = 3,45em, NAVARRO = 3,894em e GERMANO = 3,79em.
     - Computador, uma linha: 3,45 + 0,18 + 3,894 + 0,18 + 3,79 = 11,494em
     - Celular, três linhas: a mais larga é NAVARRO, 3,894em; de propósito fica em ~85% da largura
     Divisores um pouco maiores que a medida deixam uma folga para não encostar na borda. */
  .hero-name {
    container-type: inline-size;
  }

  .hero-name-text {
    display: flex;
    flex-direction: column;
    width: max-content;
    font-family: var(--font-display);
    color: var(--color-heading);
    font-size: calc(100cqi / 5.1); /* celular: ~77% da largura, para o nome caber na primeira tela junto com o resto da capa */
    font-weight: 900;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .hero-name-text {
      flex-direction: row;
      gap: 0.18em;
      font-size: calc(100cqi / 11.55);
    }
  }

  /* Foto em retrato: preto e branco, ganha cor e aproxima no hover; na abertura, sobe de baixo para cima */
  .hero-photo {
    overflow: hidden;
    border-radius: 1rem;
    clip-path: inset(0 0 0 0 round 1rem);
    transition: clip-path 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) 0.4s;
  }

  .hero-photo :global(img) {
    filter: grayscale(1) contrast(1.05);
    transform: scale(1.04);
    transition:
      filter 0.6s ease,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-photo:hover :global(img) {
    filter: grayscale(0);
    transform: scale(1.1);
  }

  /* No toque, sem hover: a foto ganha cor sozinha logo depois de aparecer (depois da abertura, se houver) */
  @media (hover: none) {
    :global(html:not(.intro-pending)) .hero-photo.is-active :global(img) {
      filter: grayscale(0);
      transform: scale(1.1);
      transition-delay: 0.9s;
    }
  }

  :global(html.intro-pending) .hero-photo {
    clip-path: inset(100% 0 0 0 round 1rem);
  }

  /* Cada palavra sobe de trás de uma linha invisível quando a abertura termina */
  .hero-name-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.02em;
  }

  .hero-name-word {
    display: block;
    transition: transform 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) var(--delay, 0s);
  }

  /* A capa carrega como um dashboard: cada bloco enche da esquerda para a direita, como uma barra,
     um depois do outro (--k). A folga de 1rem no recorte deixa passar o hover e o contorno de foco. */
  .hero-load {
    clip-path: inset(-1rem -1rem -1rem -1rem);
    transition:
      clip-path 0.75s cubic-bezier(0.65, 0, 0.2, 1) calc(0.25s + var(--k, 0) * 0.09s),
      opacity 0.3s ease calc(0.25s + var(--k, 0) * 0.09s);
  }

  /* O eixo: a linha de cima se desenha antes dos blocos */
  .hero-axis::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--color-line);
    transform-origin: left;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.2, 1);
  }

  /* O status "disponível" pisca duas vezes depois que a capa aparece, como um indicador ao vivo */
  .hero-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0;
  }

  :global(html:not(.intro-pending)) .hero-dot::after {
    animation: hero-ping 1.1s ease-out 1.2s 2;
  }

  @keyframes hero-ping {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.5);
    }
  }

  :global(html.intro-pending) .hero-name-word {
    transform: translateY(105%);
    animation: hero-failsafe 0s 6.5s forwards; /* se o script falhar, o nome aparece mesmo assim */
  }

  :global(html.intro-pending) .hero-load {
    clip-path: inset(-1rem 100% -1rem -1rem);
    opacity: 0;
    animation: hero-failsafe 0s 6.5s forwards;
  }

  :global(html.intro-pending) .hero-axis::before {
    transform: scaleX(0);
    animation: hero-failsafe 0s 6.5s forwards;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(-1rem -1rem -1rem -1rem);
    }
  }

  /* O nome voando da lista para a capa: sem o recorte da linha e sem a transição da subida
     (quem move as palavras é o script). Enquanto o fundo da abertura some, o nome da capa espera escondido. */
  :global(html.name-flying) .hero-name-line {
    overflow: visible;
  }

  :global(html.name-flying) .hero-name-word {
    transform: none;
    transition: none;
    animation: none;
  }

  :global(html.name-hold) .hero-name-word {
    visibility: hidden;
  }

  /* Abertura: só aparece com html.show-intro (o script inline liga na primeira visita da sessão) */
  .intro {
    display: none;
  }

  :global(html.show-intro) .intro {
    display: flex;
    animation: intro-failsafe 0s 7.5s forwards;
  }

  /* Ao sair pelo nome: o fundo e o resto da abertura somem, só o nome fica (e depois voa) */
  .intro.is-handoff {
    background-color: transparent;
    transition: background-color 0.3s ease;
  }

  .intro.is-handoff .intro-data > p,
  .intro.is-handoff .intro-skip,
  .intro.is-handoff .ir-me > :first-child {
    opacity: 0;
    animation: none;
    transition: opacity 0.2s ease;
  }

  .intro.is-handoff ol,
  .intro.is-handoff .ir-me {
    border-color: transparent;
    transition: border-color 0.2s ease;
  }

  .intro.is-handoff .ir-row,
  .intro.is-handoff .ir-me::before {
    visibility: hidden;
  }

  :global(html.show-intro) body {
    overflow: hidden;
  }

  /* Ao sair, sobe como uma cortina */
  .intro.is-leaving {
    transform: translateY(-100%);
    transition: transform 0.75s cubic-bezier(0.75, 0, 0.2, 1);
  }

  @keyframes intro-failsafe {
    to {
      visibility: hidden;
    }
  }

  /* Ritmo (~5 s): os números flutuam, a frase entra em foco até ~1,8 s e eles desfocam; o primeiro ato sai
     em ~2,8 s, a lista entra em ~3 s e filtra até sobrar o seu nome. */

  /* A frase da lista sobe e aparece */
  .intro-q {
    animation: intro-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 2.95s both;
  }

  .intro-skip {
    animation: intro-rise 0.7s ease 0.8s both;
  }

  @keyframes intro-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
    }
  }

  /* 1. Foco: o primeiro ato inteiro (números e frase) sai junto */
  .intro-act1 {
    animation: intro-out 0.35s ease 2.75s forwards;
  }

  /* Os números: aparecem, flutuam devagar (--dx, --dy) e, quando a frase ganha foco, perdem o foco e apagam.
     Os grandes (perto) já começam um pouco desfocados e desfocam mais; os pequenos (longe), menos. */
  .il-num {
    position: absolute;
    font-family: var(--font-mono);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-heading);
    translate: -50% -50%;
    animation:
      il-drift 3s linear both,
      il-blur 2.6s cubic-bezier(0.4, 0, 0.2, 1) var(--d) both;
  }

  .il-s1 {
    --o: 0.55;
    --b0: 0px;
    --b1: 6px;
    font-size: 13px;
  }

  .il-s2 {
    --o: 0.45;
    --b0: 1px;
    --b1: 10px;
    font-size: clamp(18px, 2.2vw, 26px);
  }

  .il-s3 {
    --o: 0.3;
    --b0: 3px;
    --b1: 16px;
    font-size: clamp(34px, 5vw, 64px);
  }

  @keyframes il-drift {
    from {
      transform: translate(calc(var(--dx) * -1), calc(var(--dy) * -1));
    }
    to {
      transform: translate(var(--dx), var(--dy));
    }
  }

  @keyframes il-blur {
    0% {
      opacity: 0;
      filter: blur(var(--b0));
    }
    15%,
    28% {
      opacity: var(--o);
      filter: blur(var(--b0));
    }
    72%,
    100% {
      opacity: 0.08;
      filter: blur(var(--b1));
    }
  }

  /* A frase: começa grande e fora de foco e assenta nítida; "dizem nada" acende em lima logo depois */
  .intro-focus {
    animation: il-sharp 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.55s both;
  }

  @keyframes il-sharp {
    from {
      opacity: 0;
      filter: blur(18px);
      scale: 1.06;
    }
  }

  .intro-focus em {
    color: var(--color-heading);
    animation: il-accent 0.6s ease 1.75s forwards;
  }

  @keyframes il-accent {
    to {
      color: var(--color-accent);
    }
  }

  /* 3. A lista filtrada */
  /* A segunda parte da abertura troca o lima pelo azul: lima (gráfico) → azul (lista) → lima (capa) */
  .intro-data {
    --color-accent: var(--color-link);
    animation: intro-data 0.45s ease 2.9s both;
  }

  @keyframes intro-data {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .intro-data :global(b) {
    font-weight: 500;
    color: var(--color-accent);
  }

  .intro-data :global(i) {
    font-style: normal;
    color: var(--color-heading);
  }

  /* Linhas dos outros: o filtro risca, apaga e recolhe */
  .ir-row {
    position: relative;
    display: grid;
    grid-template-rows: 1fr;
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in srgb, var(--color-fg) 60%, transparent);
    animation: ir-row-out 0.6s cubic-bezier(0.6, 0, 0.2, 1) var(--d) forwards;
  }

  .ir-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: ir-strike 0.25s ease var(--d) forwards;
  }

  .ir-row-in {
    display: flex;
    min-height: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.4rem;
  }

  @keyframes ir-strike {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes ir-row-out {
    0%,
    35% {
      opacity: 1;
      grid-template-rows: 1fr;
    }
    100% {
      opacity: 0;
      grid-template-rows: 0fr;
    }
  }

  /* A sua linha: o nome grande, que acende e fica selecionado quando sobra só ele */
  .ir-me {
    position: relative;
    display: flex;
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.6rem;
  }

  .ir-me::before {
    content: '';
    position: absolute;
    inset: -1px -0.5rem;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: intro-select 0.4s ease 4s forwards;
  }

  /* Mesma cor do nome da capa, para a troca no fim da abertura não aparecer */
  .ir-me-name {
    color: var(--color-ice);
    font-size: clamp(1.6rem, 6.5vw, 2.6rem);
    line-height: 0.9;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    opacity: 0.55;
    animation: intro-select 0.4s ease 4s forwards;
  }

  @keyframes intro-select {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Abertura: depois de uns 5 segundos (ou no primeiro clique, toque, rolagem ou tecla) a tela sobe,
  // revelando a capa, e o nome entra.
  let controller: AbortController | undefined;

  // A capa carrega: tira o intro-pending (os blocos enchem pelo CSS) e o ano conta até o atual, como um KPI
  const loadCover = (root: HTMLElement) => {
    root.classList.remove('intro-pending');
    const year = document.querySelector<HTMLElement>('[data-year]');
    if (!year) return;
    const final = year.textContent ?? '';
    const target = Number(final.replace(/\D/g, ''));
    if (!target) return;
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - t0 - 350) / 900, 1); // começa junto com o bloco do ano
      if (p < 1) {
        const v = String(Math.round(target * (1 - Math.pow(1 - Math.max(p, 0), 3)))).padStart(4, '0');
        year.textContent = `${v.slice(0, 2)} ${v.slice(2)}`;
        requestAnimationFrame(step);
      } else {
        year.textContent = final;
      }
    };
    requestAnimationFrame(step);
  };

  // Saída pelo nome: o fundo da abertura some deixando só o nome selecionado; depois cada palavra da capa
  // sai do lugar e do tamanho da palavra na lista (medidos aqui) e voa até a sua posição final.
  // Devolve false quando não dá para fazer a ponte (aí entra a cortina).
  const handoff = (intro: HTMLElement) => {
    const root = document.documentElement;
    const from = [...intro.querySelectorAll<HTMLElement>('.ir-w')];
    const to = [...document.querySelectorAll<HTMLElement>('#inicio .hero-name-word')];
    if (!from.length || from.length !== to.length) return false;

    // Posição final das palavras da capa: sem a subida e sem o recorte, mas ainda escondidas
    root.classList.add('name-flying', 'name-hold');
    const pairs = from.map((f, i) => [f.getBoundingClientRect(), to[i].getBoundingClientRect()] as const);
    if (pairs.some(([a, b]) => !a.width || !b.width)) {
      root.classList.remove('name-flying', 'name-hold');
      return false;
    }

    intro.classList.add('is-handoff');
    setTimeout(() => {
      // Troca invisível: a palavra da capa aparece exatamente onde estava a da lista, e a lista some
      intro.style.visibility = 'hidden';
      root.classList.remove('name-hold');
      to.forEach((el, i) => {
        const [a, b] = pairs[i];
        const dx = a.left + a.width / 2 - (b.left + b.width / 2);
        const dy = a.top + a.height / 2 - (b.top + b.height / 2);
        el.animate([{ transform: `translate(${dx}px, ${dy}px) scale(${a.width / b.width})` }, { transform: 'none' }], {
          duration: 950,
          delay: i * 70,
          easing: 'cubic-bezier(0.7, 0, 0.15, 1)',
          fill: 'backwards',
        });
      });
      // A capa começa a carregar enquanto o nome ainda está assentando
      setTimeout(() => loadCover(root), 600);
      setTimeout(() => {
        root.classList.remove('name-flying', 'show-intro');
        intro.style.visibility = '';
      }, 950 + 70 * (to.length - 1) + 50);
    }, 300);
    return true;
  };

  const runIntro = (signal: AbortSignal) => {
    const root = document.documentElement;
    if (!root.classList.contains('show-intro')) return;
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!intro) return root.classList.remove('show-intro', 'intro-pending');

    const skip = new AbortController();
    const startedAt = performance.now();
    let done = false;
    const leave = () => {
      if (done) return;
      done = true;
      skip.abort();
      clearTimeout(timer);
      // O nome só faz a ponte se a lista já está na tela (~3,3 s); antes disso, a cortina de sempre
      if (performance.now() - startedAt > 3300 && handoff(intro)) return;
      intro.classList.add('is-leaving');
      setTimeout(() => loadCover(root), 350);
      setTimeout(() => root.classList.remove('show-intro'), 800); // fim da subida (0,75 s)
    };
    const timer = setTimeout(leave, 5000);
    signal.addEventListener('abort', leave);
    for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
      window.addEventListener(type, leave, { passive: true, signal: skip.signal });
    }
  };

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const hero = document.getElementById('inicio');
    if (!hero) return;

    runIntro(signal);
  });
</script>
