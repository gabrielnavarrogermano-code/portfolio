---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel-recorte.png';
import Letras from './Letras.astro';
import { idiomaDe, textos } from '../i18n';

const tx = textos[idiomaDe(Astro.url)].capa;
---

<!-- Antes de pintar: esconde os blocos da capa para eles entrarem (capa-carregando) e, em telas largas, já monta o
     palco (palco-ativo), para a capa não aparecer em bloco e depois pular de lugar. "na-capa" esconde o Contato da
     barra de cima enquanto a capa está na tela (ela já tem o seu botão).
     Quem pediu menos movimento vê a capa pronta, sem palco. -->
<script is:inline>
  (function () {
    try {
      document.documentElement.classList.add('na-capa');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('capa-carregando');
      if (matchMedia('(min-width: 56rem)').matches) document.documentElement.classList.add('palco-ativo');
    } catch (e) {}
  })();
</script>

<!-- A capa: você no centro, em preto e branco, num fundo cinza de estúdio. O nome emoldura você e passa NA FRENTE
     da foto, mudando de cor onde cruza a camisa; atrás de tudo, "Portfólio" gigante em tom sobre tom.
     Em telas largas, com movimento, ela fica presa na tela enquanto a rolagem passa pelo trilho: os textos saem, a
     foto se desfaz em pó e o pó vira o fio que liga o resto do site (lib/po.ts e lib/fio.ts).
     No celular, com movimento reduzido ou sem JS, é um bloco normal, com a foto parada. -->
<section id="inicio" data-capa class="trilho relative isolate">
  <div data-palco class="palco">
    <div class="capa-conteudo">
      <div class="cena">
        <!-- tom sobre tom, atrás de tudo -->
        <p data-capa-some class="fantasma" aria-hidden="true">{tx.fantasma}</p>

        <!-- O nome: entra letra por letra e passa na frente da foto -->
        <h1 data-capa-some class="capa-nome">
          <span class="sr-only">{tx.nomeSr}</span>
          <span class="nome-1 hero-name-line" aria-hidden="true"><Letras texto="Gabriel" atraso={0.35} /></span>
          <span class="nome-2 hero-name-line" aria-hidden="true"><Letras texto="Germano" atraso={0.5} /></span>
        </h1>

        <!-- Você, recortado, em preto e branco, saindo da borda de baixo -->
        <div data-retrato data-po-pb class="retrato">
          <figure class="retrato-moldura">
            <Image
              src={foto}
              alt={tx.foto}
              widths={[480, 928]}
              sizes="(min-width: 56rem) 40rem, 22rem"
              format="webp"
              quality={92}
              loading="eager"
              fetchpriority="high"
              class="retrato-foto"
            />
            <!-- A cópia da foto que o pó apaga (lib/po.ts): só aparece quando a foto começa a se desfazer -->
            <canvas data-po-foto class="retrato-foto retrato-copia" aria-hidden="true"></canvas>
          </figure>
        </div>
      </div>

      <!-- Só o essencial: o que eu faço e onde, e o contato (o resto fica na seção Contato) -->
      <div data-capa-some class="capa-info">
        <p class="capa-funcao hero-load" style="--k: 1">{tx.funcao}</p>
        <a href="#contato" class="capa-cta hero-load" style="--k: 2">{tx.contato}</a>
      </div>
    </div>

    <!-- O pó (por cima da capa) e o fio que ele forma no centro, que continua nas seções -->
    <canvas data-po class="po" aria-hidden="true"></canvas>
    <span data-fio-capa class="fio-capa" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* ---------- A capa ---------- */
  /* Cabe sempre na altura da tela. O fundo é pintado aqui (e não só na página) porque o nome inverte de cor
     sobre ele e sobre a foto (mix-blend-mode precisa do fundo dentro do mesmo grupo, o isolation). */
  .capa-conteudo {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    padding-top: 5.5rem; /* a barra de cima */
    background: var(--color-bg);
  }

  /* A capa é lisa; o papel do resto do site (grão e linho, global.css) só aparece no pé dela, aos poucos,
     para ela não terminar numa faixa reta. Fica atrás da foto e do nome. */
  .capa-conteudo::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--textura-grao), var(--textura-linho-h), var(--textura-linho-v);
    background-size: 240px, 300px, 300px;
    mask-image: linear-gradient(to bottom, transparent 55%, #000);
    pointer-events: none;
  }

  /* uma luz de estúdio suave atrás de você, como um fundo infinito iluminado */
  .capa-conteudo::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    background: radial-gradient(ellipse 38% 60% at 50% 55%, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0) 70%);
    pointer-events: none;
  }

  .cena {
    position: relative;
    min-height: 0;
  }

  /* "Portfólio": gigante, num cinza só um pouco mais escuro que o fundo. No celular fica atrás dos ombros,
     abaixo do nome; no computador, no alto, atrás da cabeça. */
  .fantasma {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 40%;
    translate: -50% 0;
    margin: 0;
    font-family: var(--font-serif);
    font-size: min(30vw, 34svh);
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--color-fantasma);
    pointer-events: none;
    user-select: none;
  }

  /* O nome fica NA FRENTE da foto e inverte de cor: azul-marinho sobre o fundo, creme claro sobre a camisa preta.
     Com "difference", a cor final é |fundo − cor|; --color-nome-inverso é o fundo menos o azul-marinho (global.css),
     então sobre o cinza sai exatamente o azul-marinho do site. */
  .capa-nome {
    position: absolute;
    z-index: 3;
    inset: 0;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: min(24vw, 13svh);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--color-nome-inverso);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* celular: as duas palavras empilhadas no alto, "Germano" alinhado à direita */
  .nome-1,
  .nome-2 {
    position: absolute;
    white-space: nowrap;
  }

  .nome-1 {
    left: 1.5rem;
    top: 0;
  }

  .nome-2 {
    right: 1.5rem;
    top: 0.85em;
  }

  /* a linha esconde as letras enquanto elas sobem (componente Letras) */
  .hero-name-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.02em;
  }

  /* Você: o recorte inteiro, sem moldura, saindo da borda de baixo da cena. No celular a cabeça começa logo
     abaixo de "Germano". */
  .retrato {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    height: 72%;
    max-width: 92%;
    aspect-ratio: 928 / 1140; /* a proporção da foto recortada */
  }

  .retrato-moldura {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .retrato-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    /* o preto e branco vem daqui; a cópia que o pó apaga (canvas) usa o mesmo filtro */
    filter: grayscale(1) contrast(1.06);
  }

  /* A cópia da foto troca com a <img> só quando a foto começa a se desfazer */
  .retrato-copia {
    opacity: 0;
  }

  .retrato:global(.po-ativo) .retrato-copia {
    opacity: 1;
  }

  .retrato:global(.po-ativo) img.retrato-foto {
    opacity: 0;
  }

  /* Embaixo: a função e o botão */
  .capa-info {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1.25rem 1.5rem 1.75rem;
  }

  .capa-funcao {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  /* reto, sem arredondar, no espírito editorial da capa */
  .capa-cta {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    background: var(--color-navy);
    color: #fff;
    font-weight: 700;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .capa-cta:hover {
    background: var(--color-latao);
    color: var(--color-navy);
  }

  /* Computador: "Gabriel" e "Germano" na altura dos ombros, chegando perto do centro e cruzando os seus ombros
     (sem passar pelo rosto); você no meio, ocupando a altura toda; função e botão numa linha, embaixo. */
  @media (min-width: 56rem) {
    .capa-conteudo {
      grid-template-rows: 1fr;
    }

    .fantasma {
      top: 0;
    }

    .capa-nome {
      font-size: min(8.5vw, 17svh);
    }

    .nome-1,
    .nome-2 {
      top: 38%;
    }

    .nome-1 {
      left: auto;
      right: calc(50% + 0.85em);
    }

    .nome-2 {
      right: auto;
      left: calc(50% + 0.85em);
    }

    .retrato {
      height: 100%;
      max-width: 60%;
    }

    .capa-info {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-width: 80rem;
      margin-inline: auto;
      padding: 0 2rem clamp(1.5rem, 6svh, 4rem);
      background: none;
      pointer-events: none;
    }

    .capa-info > * {
      pointer-events: auto;
    }
  }

  /* O pó e o fio da capa: só no palco */
  .po,
  .fio-capa {
    display: none;
  }

  /* ---------- O palco (telas largas, com movimento) ---------- */
  :global(html.palco-ativo) .trilho {
    height: 190svh;
  }

  :global(html.palco-ativo) .palco {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
  }

  :global(html.palco-ativo) .po {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
  }

  :global(html.palco-ativo) .fio-capa {
    display: block;
    position: absolute;
    left: 50%;
    top: 58%;
    bottom: 0;
    width: 1.5px;
    margin-left: -0.75px;
    background: var(--color-fio);
    transform: scaleY(0);
    transform-origin: top;
    z-index: 4;
  }

  [data-capa-some] {
    will-change: opacity, transform;
  }

  /* ---------- A capa carrega ---------- */
  /* A função e o botão enchem da esquerda para a direita, um depois do outro (--k).
     A folga de 1rem no recorte deixa passar o hover e o contorno de foco. */
  .hero-load {
    clip-path: inset(-1rem -1rem -1rem -1rem);
    transition:
      clip-path 0.75s cubic-bezier(0.65, 0, 0.2, 1) calc(0.6s + var(--k, 0) * 0.12s),
      opacity 0.4s ease calc(0.6s + var(--k, 0) * 0.12s);
  }

  /* Estado antes de carregar (as letras ficam no global.css). Se o script falhar, tudo aparece sozinho em 2,5 s */
  :global(html.capa-carregando) .hero-load {
    clip-path: inset(-1rem 100% -1rem -1rem);
    opacity: 0;
    animation: hero-failsafe 0s 2.5s forwards;
  }

  /* a foto e o "Portfólio" aparecem devagar */
  .retrato,
  .fantasma {
    transition: opacity 1.2s ease 0.1s;
  }

  :global(html.capa-carregando) .retrato,
  :global(html.capa-carregando) .fantasma {
    opacity: 0;
    animation: hero-failsafe 0s 2.5s forwards;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(-1rem -1rem -1rem -1rem);
    }
  }
</style>

<script>
  import { iniciarPo } from '../lib/po';

  let controller: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const root = document.documentElement;

    const capa = document.querySelector<HTMLElement>('[data-capa]');
    if (!capa) {
      root.classList.remove('na-capa');
      return;
    }

    iniciarPo(capa, controller.signal); // a foto que vira pó, e o pó que vira o fio

    // O Contato da barra de cima volta quando os textos da capa saem (ela já tem o seu botão)
    const naCapa = () => root.classList.toggle('na-capa', scrollY < innerHeight * 0.12);
    naCapa();
    addEventListener('scroll', naCapa, { passive: true, signal: controller.signal });
    controller.signal.addEventListener('abort', () => root.classList.remove('na-capa'));

    if (root.classList.contains('capa-carregando')) {
      // Dois quadros: garante que o estado escondido foi pintado antes de soltar as transições
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          root.classList.remove('capa-carregando');
        }),
      );
    }
  });
</script>
