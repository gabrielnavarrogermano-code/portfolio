---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel.png';
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';

const focus = ['Excel', 'Power BI', 'ETL'];
---

<section id="inicio" class="hero-ice relative isolate flex min-h-svh flex-col pt-28 pb-8 sm:pt-32">
  <!-- Céu de estrelas atrás da capa: as estrelas reagem ao mouse em camadas -->
  <canvas data-stars aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full" style="z-index: -1"></canvas>
  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-6">
    <div class="flex flex-1 flex-col items-center justify-center text-center">
      <Image
        src={foto}
        alt="Foto de Gabriel Navarro Germano"
        widths={[160, 320]}
        sizes="(min-width: 640px) 160px, 128px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="h-32 w-32 rounded-full border border-line object-cover object-[50%_30%] ring-2 ring-accent/30 ring-offset-4 ring-offset-bg sm:h-40 sm:w-40"
      />

      <div class="mt-8">
        <h1 class="tracking-tight text-heading">
          <span class="block font-sans text-base font-medium tracking-normal text-muted sm:text-lg">
            Gabriel Navarro Germano
          </span>
          <span data-fill class="hero-title mt-4 inline-block text-4xl leading-[1.05] font-bold text-balance sm:text-5xl">Análise de Dados & BI</span>
        </h1>

        <p class="mt-5 font-mono text-sm">
          <span class="text-muted">foco:</span> <span data-fill class="hero-focus-items">{focus.join(' · ')}</span>
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#contato"
            class="group inline-flex items-center gap-2 rounded-full bg-heading px-6 py-3 font-medium text-bg transition hover:bg-link-strong hover:text-white"
          >
            Entre em contato
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          {
            temCurriculo && (
              <a
                href={site.curriculo}
                download="Curriculo-Gabriel-Navarro-Germano.pdf"
                class="inline-flex items-center gap-2 rounded-full border border-line bg-bg px-6 py-3 font-medium text-heading transition hover:border-link hover:bg-link-strong/15"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                  <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Currículo
              </a>
            )
          }
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.02c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <a
      href="#apresentacao"
      aria-label="Rolar para a apresentação"
      class="mx-auto mt-8 inline-flex h-10 w-10 items-center justify-center rounded-full text-heading transition hover:bg-heading/10"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
        <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<script>
  // Título e focos: só a região debaixo do mouse muda de cor (lanterna).
  // Estrelas: pequenas e esparsas, espalhadas por igual na capa inteira; algumas cintilam devagar. Ficam em
  // 3 camadas que deslizam ao contrário do mouse (as mais próximas mais), dando profundidade.
  // Para quando a capa sai da tela; quem pediu menos movimento vê as estrelas paradas.
  type Star = { x: number; y: number; r: number; a: number; depth: number; tw: number; phase: number; c: string };
  // Cor das estrelas: quase todas brancas; cerca de 1 em 20 lima e 1 em 30 azul, para amarrar a capa à paleta
  const STAR_COLOR = '240, 240, 236';
  const STAR_LIME = '200, 255, 58';
  const STAR_BLUE = '74, 116, 240';
  const PARALLAX = 18; // deslocamento máximo (px) da camada mais próxima

  let controller: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const hero = document.getElementById('inicio');
    if (!hero) return;

    hero.querySelectorAll<HTMLElement>('[data-fill]').forEach((el) => {
      el.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--fx', `${e.clientX - r.left}px`);
          el.style.setProperty('--fy', `${e.clientY - r.top}px`);
          el.classList.add('is-lit');
        },
        { signal },
      );
      el.addEventListener('pointerleave', () => el.classList.remove('is-lit'), { signal });
    });

    const canvas = hero.querySelector<HTMLCanvasElement>('canvas[data-stars]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let w = 0;
    let h = 0;
    let stars: Star[] = [];

    // Estrelas espalhadas por igual na capa inteira (com uma folga nas bordas para o deslize das camadas)
    const makeStars = () => {
      const list: Star[] = [];
      const count = Math.round((w * h) / 3600);
      for (let i = 0; i < count; i++) {
        const y = Math.random() * (h + PARALLAX) - PARALLAX / 2;
        const depth = [0.3, 0.6, 1][Math.floor(Math.random() * 3)];
        list.push({
          x: Math.random() * (w + PARALLAX * 2) - PARALLAX,
          y,
          r: 0.4 + depth * 0.6 + Math.random() * 0.4,
          a: 0.25 + Math.random() * 0.6,
          depth,
          tw: Math.random() < 0.15 ? 0.6 + Math.random() * 0.8 : 0,
          c: ((r) => (r < 0.05 ? STAR_LIME : r < 0.083 ? STAR_BLUE : STAR_COLOR))(Math.random()),
          phase: Math.random() * Math.PI * 2,
        });
      }
      stars = list;
    };

    const draw = (now: number, ox: number, oy: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        const twinkle = s.tw ? 0.55 + 0.45 * Math.sin((now / 1000) * s.tw + s.phase) : 1;
        ctx.fillStyle = `rgba(${s.c}, ${(s.a * twinkle).toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(s.x + ox * s.depth, s.y + oy * s.depth, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      makeStars();
      if (still) draw(0, 0, 0);
    };
    const ro = new ResizeObserver(resize);
    ro.observe(hero);
    signal.addEventListener('abort', () => ro.disconnect());

    if (still) return;

    let mouseX = hero.clientWidth / 2;
    let mouseY = hero.clientHeight / 2;
    let lastMove = -Infinity;
    let px = 0; // deslocamento suavizado das estrelas
    let py = 0;
    let raf = 0;
    let visible = true;

    const frame = (now: number) => {
      raf = 0;
      const active = now - lastMove < 3000;

      const tx = active ? -((mouseX / w) * 2 - 1) * PARALLAX : 0;
      const ty = active ? -((mouseY / h) * 2 - 1) * PARALLAX * 0.5 : 0;
      px += (tx - px) * 0.05;
      py += (ty - py) * 0.05;
      draw(now, px, py);

      if (visible) raf = requestAnimationFrame(frame);
    };

    hero.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = hero.getBoundingClientRect();
        mouseX = e.clientX - r.left;
        mouseY = e.clientY - r.top;
        lastMove = performance.now();
      },
      { signal },
    );

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !raf) raf = requestAnimationFrame(frame);
    });
    io.observe(hero);

    signal.addEventListener('abort', () => {
      io.disconnect();
      cancelAnimationFrame(raf);
    });
  });
</script>
