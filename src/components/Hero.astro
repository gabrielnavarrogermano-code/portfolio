---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel.png';
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';

const focus = ['Excel', 'Power BI', 'ETL'];

// Abertura: números soltos que viram um gráfico de pessoas por área. Cada barra tem seu número, que aparece
// primeiro solto em (x, y) e depois voa para o topo dela; a barra Dados (alvo) é onde a imagem mergulha
// (drill-down). Os `soltos` são números que não viram nada e somem.
// Depois, a lista de pessoas (fictícias) que a consulta filtra: fase 1 = WHERE área = 'Dados';
// fase 2 = AND foco = 'Power BI'. Sobra você.
const barras = [
  { area: 'RH', valor: 8, x: 22, y: 30 },
  { area: 'TI', valor: 12, x: 250, y: 62 },
  { area: 'Vendas', valor: 15, x: 70, y: 140 },
  { area: 'Dados', valor: 21, x: 272, y: 150, alvo: true },
  { area: 'Finanças', valor: 6, x: 150, y: 18 },
];
const soltos = [
  { t: '3,2', x: 118, y: 92 },
  { t: '47', x: 36, y: 96 },
  { t: '0,8', x: 212, y: 24 },
  { t: '112', x: 198, y: 112 },
  { t: '28%', x: 100, y: 52 },
  { t: '64', x: 288, y: 104 },
  { t: '9', x: 160, y: 160 },
];
const acima = [
  { nome: 'Ana Souza', area: 'RH', fase: 1 },
  { nome: 'Lucas Prado', area: 'Dados', fase: 2 },
  { nome: 'Marina Alves', area: 'Vendas', fase: 1 },
  { nome: 'Bruno Lima', area: 'TI', fase: 1 },
];
const abaixo = [
  { nome: 'Carla Dias', area: 'Dados', fase: 2 },
  { nome: 'Rafael Melo', area: 'Logística', fase: 1 },
  { nome: 'Júlia Nunes', area: 'Finanças', fase: 1 },
  { nome: 'Thiago Rocha', area: 'Dados', fase: 2 },
];
---

<!-- Abertura: na primeira visita da sessão, antes de pintar a capa, liga a animação de abertura.
     Quem pediu menos movimento (ou já viu nesta sessão) vai direto para o site. -->
<script is:inline>
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('intro-seen')) return;
      sessionStorage.setItem('intro-seen', '1');
      var root = document.documentElement;
      root.classList.add('show-intro', 'intro-pending');
      // Trava de segurança: se algo falhar, em 7 s o site aparece e a rolagem volta
      setTimeout(function () {
        root.classList.remove('show-intro', 'intro-pending');
      }, 7000);
    } catch (e) {}
  })();
</script>

<!-- Abertura, automática (uns 4,5 segundos), no traço do site:
     1. "Números soltos não dizem nada": números aparecem espalhados e voam para o topo de barras que
        crescem, formando um gráfico de pessoas por área;
     2. um cursor clica na barra Dados: ela acende e as outras apagam (filtro cruzado, como no Power BI);
     3. "Procurando alguém para cuidar dos seus dados?": com o filtro aplicado (a busca do recrutador), a lista risca as pessoas até sobrar
        o seu nome, selecionado;
     4. a tela sobe como uma cortina e o nome entra na capa.
     Qualquer clique, toque, rolagem ou tecla pula direto para a capa. -->
<div data-intro class="intro on-black fixed inset-0 z-[100] items-center justify-center overflow-hidden bg-bg" aria-hidden="true">
  <div class="intro-rack flex flex-col items-center">
    <p class="intro-q intro-q1 mb-6 px-6 text-center font-serif text-[1.6rem] leading-tight text-heading sm:mb-8 sm:text-4xl">
      Números soltos não <em class="text-accent">dizem nada.</em>
    </p>
    <svg viewBox="0 0 300 200" class="intro-svg overflow-visible">
      <g>
        <path class="ic-grid" d="M14 128h278M14 86h278M14 44h278"></path>
        <path class="ic-axis" d="M14 170h278" pathLength="1"></path>
        {
          barras.map((b, i) => {
            const x = 28 + i * 52;
            const h = b.valor * 6;
            return (
              <g class:list={['ic-bar', b.alvo && 'ic-target']} style={`--i: ${i}`}>
                <rect class="ic-rect" x={x} y={170 - h} width="36" height={h}></rect>
                {b.alvo && <rect class="ic-hl" x={x} y={170 - h} width="36" height={h}></rect>}
                <text class="ic-area" x={x + 18} y="184" text-anchor="middle">{b.area}</text>
              </g>
            );
          })
        }
        {
          barras.map((b, i) => {
            const fx = 28 + i * 52 + 18;
            const fy = 170 - b.valor * 6 - 6;
            return (
              <text
                class:list={['ic-num', b.alvo && 'ic-num-target']}
                x={fx}
                y={fy}
                text-anchor="middle"
                style={`--i: ${i}; --o: ${(i * 5) % 12}; --sx: ${b.x - fx}px; --sy: ${b.y - fy}px`}
              >
                {b.valor}
              </text>
            );
          })
        }
        {
          soltos.map((n, i) => (
            <text class="ic-num ic-loose" x={n.x} y={n.y} text-anchor="middle" style={`--o: ${((i + 5) * 5) % 12}`}>
              {n.t}
            </text>
          ))
        }
        <!-- O clique na barra Dados (filtro cruzado, como no Power BI): o cursor entra pela direita,
             clica no meio da barra e solta uma onda; as outras barras apagam -->
        <circle class="ic-click" cx="202" cy="107" r="9"></circle>
        <g transform="translate(202 107)">
          <path class="ic-cursor" d="M0 0V15l4-3.6 3 6.8 2.8-1.2-3-6.6h5.3z"></path>
        </g>
      </g>
    </svg>
    <p class="intro-cap mt-6 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
      ( Pessoas por área )
    </p>
  </div>

  <div class="intro-data absolute w-[min(92vw,32rem)]">
    <p class="intro-q intro-q2 mb-6 font-serif text-[1.6rem] leading-tight text-heading sm:text-4xl">
      Procurando alguém para <em class="text-accent">cuidar dos seus dados?</em>
    </p>
    <p class="font-mono text-[11px] leading-[1.7] text-fg/80 sm:text-xs">
      <b>Filtro</b> área = <i>'Dados'</i> <span aria-hidden="true">·</span> foco = <i>'Power BI'</i>
    </p>
    <ol class="mt-5 border-t border-line">
      {
        acima.map((r) => (
          <li class="ir-row" style={`--d: ${r.fase === 1 ? 3.25 : 3.6}s`}>
            <span class="ir-row-in"><span class="w-24 flex-none text-muted/70">{r.area}</span>{r.nome}</span>
          </li>
        ))
      }
      <li class="ir-me">
        <span class="w-24 flex-none self-start pt-1 font-mono text-[11px] text-accent">Dados</span>
        <span class="ir-me-name font-display font-black text-heading uppercase">Gabriel Navarro Germano</span>
      </li>
      {
        abaixo.map((r) => (
          <li class="ir-row" style={`--d: ${r.fase === 1 ? 3.3 : 3.65}s`}>
            <span class="ir-row-in"><span class="w-24 flex-none text-muted/70">{r.area}</span>{r.nome}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="intro-skip absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-[10px] tracking-[0.15em] whitespace-nowrap text-muted/70 uppercase">
    ( Toque ou role para pular )
  </p>
</div>

<section id="inicio" class="hero-ice relative isolate flex min-h-svh flex-col pt-20 sm:pt-28">
  <!-- Linha de rótulos no topo -->
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="hero-fade flex items-center justify-between gap-4 border-t border-line pt-3 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">
      <!-- O que procuro: a bolinha lima funciona como um status, "disponível" -->
      <p class="flex items-center gap-2">
        <span class="size-1.5 flex-none rounded-full bg-accent" aria-hidden="true"></span>
        Buscando oportunidades em Dados & BI
      </p>
      <p class="whitespace-nowrap"><span class="max-sm:hidden">Portfólio </span><span class="text-heading">( {site.anoEmDois} )</span></p>
    </div>
  </div>

  <!-- Centro, em três colunas: os focos, uma frase de apresentação e os botões -->
  <div class="hero-fade mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-6 sm:py-10">
    <div class="grid gap-6 sm:gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)_auto] md:items-start md:gap-10">
      <!-- Frase em serifa (Instrument Serif): contrasta com a Tektur do nome; o destaque em lima vai em itálico -->
      <!-- Abaixo da frase, quem sou hoje em uma linha (o que procuro está no rótulo do topo) -->
      <div class="md:order-2">
        <p class="max-w-xl font-serif text-[1.8rem] leading-[1.08] text-balance text-heading sm:text-[2.6rem] lg:text-5xl">
          Transformo planilhas soltas em <em class="text-accent">dashboards que a equipe usa para decidir.</em>
        </p>
        <p class="mt-4 font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:mt-5 sm:text-xs">
          Estagiário de TI <span aria-hidden="true">·</span> Engenharia de Software
        </p>
      </div>

      <!-- Foto em retrato (preto e branco, ganha cor no hover) e os focos logo abaixo; no celular, lado a lado -->
      <div class="flex items-end gap-5 md:order-1 md:flex-col md:items-start md:gap-5">
        <div data-active="view" class="hero-photo w-24 flex-none sm:w-32 md:w-full md:max-w-44">
          <Image
            src={foto}
            alt="Foto de Gabriel Navarro Germano"
            widths={[240, 480]}
            sizes="(min-width: 768px) 176px, 128px"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] size-full object-cover object-[50%_25%]"
          />
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase sm:text-xs">( Foco )</p>
          <ul data-fill class="hero-focus-items mt-3 font-mono text-sm leading-relaxed sm:text-base">
            {focus.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3 md:order-3 md:flex-col md:items-end">
        <a
          href="#contato"
          class="group inline-flex items-center gap-2 rounded-full bg-heading px-5 py-2 font-medium sm:px-6 sm:py-3 whitespace-nowrap text-bg transition hover:bg-link-strong hover:text-white"
        >
          <span data-flip>Entre em contato</span>
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          {
            temCurriculo && (
              <a
                href={site.curriculo}
                download={site.curriculoNome}
                class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-bg font-medium max-sm:size-10 sm:px-5 sm:py-3 text-heading transition hover:border-link hover:bg-link-strong/15"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                  <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span data-flip class="max-sm:sr-only">Currículo</span>
              </a>
            )
          }
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="inline-flex size-10 flex-none sm:size-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex size-10 flex-none sm:size-12 items-center justify-center rounded-full border border-line bg-bg text-muted transition hover:border-link hover:text-heading"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.02c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Nome gigante: ocupa a largura da tela (uma linha no computador, três no celular).
       As palavras acendem em lima debaixo do mouse. -->
  <h1 class="hero-name px-3 pb-3 sm:px-4 sm:pb-4">
    <span class="sr-only">{site.name}, Análise de Dados & BI</span>
    <span class="hero-name-text" aria-hidden="true">
      <span class="hero-name-line"><span data-fill class="hero-title hero-name-word">Gabriel</span></span>
      <span class="hero-name-line"><span data-fill class="hero-title hero-name-word" style="--delay: 0.08s">Navarro</span></span>
      <span class="hero-name-line"><span data-fill class="hero-title hero-name-word" style="--delay: 0.16s">Germano</span></span>
    </span>
  </h1>
</section>

<style>
  /* Tektur no peso máximo e na largura mais estreita: um nome alto, apertado, de borda a borda.
     O tamanho sai da largura do h1 (unidade cqi), sem script: medido na Tektur 900 estreita,
     GABRIEL = 3,45em, NAVARRO = 3,894em e GERMANO = 3,79em.
     - Computador, uma linha: 3,45 + 0,18 + 3,894 + 0,18 + 3,79 = 11,494em
     - Celular, três linhas: a mais larga é NAVARRO, 3,894em; de propósito fica em ~85% da largura
     Divisores um pouco maiores que a medida deixam uma folga para não encostar na borda. */
  .hero-name {
    container-type: inline-size;
  }

  .hero-name-text {
    display: flex;
    flex-direction: column;
    width: max-content;
    font-family: var(--font-display);
    font-size: calc(100cqi / 5.1); /* celular: ~77% da largura, para o nome caber na primeira tela junto com o resto da capa */
    font-weight: 900;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .hero-name-text {
      flex-direction: row;
      gap: 0.18em;
      font-size: calc(100cqi / 11.55);
    }
  }

  /* Foto em retrato: preto e branco, ganha cor e aproxima no hover; na abertura, sobe de baixo para cima */
  .hero-photo {
    overflow: hidden;
    border-radius: 1rem;
    clip-path: inset(0 0 0 0 round 1rem);
    transition: clip-path 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) 0.4s;
  }

  .hero-photo :global(img) {
    filter: grayscale(1) contrast(1.05);
    transform: scale(1.04);
    transition:
      filter 0.6s ease,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-photo:hover :global(img) {
    filter: grayscale(0);
    transform: scale(1.1);
  }

  /* No toque, sem hover: a foto ganha cor sozinha logo depois de aparecer (depois da abertura, se houver) */
  @media (hover: none) {
    :global(html:not(.intro-pending)) .hero-photo.is-active :global(img) {
      filter: grayscale(0);
      transform: scale(1.1);
      transition-delay: 0.9s;
    }
  }

  :global(html.intro-pending) .hero-photo {
    clip-path: inset(100% 0 0 0 round 1rem);
  }

  /* Cada palavra sobe de trás de uma linha invisível quando a abertura termina */
  .hero-name-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.02em;
  }

  .hero-name-word {
    display: block;
    transition: transform 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) var(--delay, 0s);
  }

  .hero-fade {
    transition: opacity 0.8s ease 0.35s, transform 0.8s ease 0.35s;
  }

  :global(html.intro-pending) .hero-name-word {
    transform: translateY(105%);
    animation: hero-failsafe 0s 5s forwards; /* se o script falhar, o nome aparece mesmo assim */
  }

  :global(html.intro-pending) .hero-fade {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-failsafe 0s 5s forwards;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Abertura: só aparece com html.show-intro (o script inline liga na primeira visita da sessão) */
  .intro {
    display: none;
  }

  :global(html.show-intro) .intro {
    display: flex;
    animation: intro-failsafe 0s 7s forwards;
  }

  :global(html.show-intro) body {
    overflow: hidden;
  }

  /* Ao sair, sobe como uma cortina */
  .intro.is-leaving {
    transform: translateY(-100%);
    transition: transform 0.75s cubic-bezier(0.75, 0, 0.2, 1);
  }

  @keyframes intro-failsafe {
    to {
      visibility: hidden;
    }
  }

  /* Ritmo (~4,5 s): o gráfico se forma até ~2 s, o cursor clica na barra Dados em ~2,3 s (as outras
     apagam, como no filtro cruzado do Power BI), a lista entra em ~3 s e filtra até sobrar o seu nome. */

  /* As frases: sobem e aparecem */
  .intro-q {
    animation: intro-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
  }

  .intro-q2 {
    animation-delay: 2.95s;
  }

  .intro-cap {
    animation: intro-rise 0.7s ease 0.5s both;
  }

  .intro-skip {
    animation: intro-rise 0.7s ease 0.8s both;
  }

  @keyframes intro-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
    }
  }

  /* 1. Números soltos que viram um gráfico (o primeiro ato inteiro some junto, pelo .intro-rack) */
  .intro-svg {
    width: min(86vw, 30rem);
    height: auto;
  }

  .intro-rack {
    animation: intro-out 0.35s ease 2.75s forwards;
  }

  /* Cada número aparece no seu canto (--sx, --sy) e depois voa para o topo da sua barra */
  .ic-num {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--color-heading);
    animation:
      ic-appear 0.4s ease calc(0.25s + var(--o) * 0.05s) both,
      ic-move 0.7s cubic-bezier(0.6, 0, 0.2, 1) calc(1s + var(--i) * 0.07s) both;
  }

  .ic-num-target {
    fill: var(--color-accent);
  }

  /* Os que não viram barra ficam apagados e somem quando o gráfico se forma */
  .ic-loose {
    fill: var(--color-muted);
    animation:
      ic-appear 0.4s ease calc(0.25s + var(--o) * 0.05s) both,
      intro-out 0.35s ease 0.95s forwards;
  }

  @keyframes ic-appear {
    from {
      opacity: 0;
    }
  }

  @keyframes ic-move {
    from {
      transform: translate(var(--sx), var(--sy));
    }
    to {
      transform: none;
    }
  }

  .ic-axis {
    fill: none;
    stroke: color-mix(in srgb, var(--color-heading) 45%, transparent);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ir-draw 0.5s cubic-bezier(0.6, 0, 0.2, 1) 0.85s forwards;
  }

  .ic-grid {
    fill: none;
    stroke: color-mix(in srgb, var(--color-heading) 10%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
    animation: ic-appear 0.5s ease 0.95s both;
  }

  @keyframes ir-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* As barras crescem de baixo para cima, uma depois da outra */
  .ic-rect,
  .ic-hl {
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }

  .ic-rect {
    fill: color-mix(in srgb, var(--color-heading) 7%, transparent);
    stroke: color-mix(in srgb, var(--color-heading) 30%, transparent);
    transform-box: fill-box;
    transform-origin: bottom;
    animation: ic-grow 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) calc(1.05s + var(--i) * 0.07s) both;
  }

  @keyframes ic-grow {
    from {
      transform: scaleY(0);
    }
  }

  .ic-area {
    font-family: var(--font-mono);
    font-size: 7px;
    fill: var(--color-muted);
    animation: ic-appear 0.4s ease calc(1.15s + var(--i) * 0.07s) both;
  }

  /* 2. O clique: as barras que não são Dados (com número e rótulo) apagam, como no filtro cruzado */
  .ic-bar:not(.ic-target) {
    animation: ic-dim 0.3s ease 2.3s forwards;
  }

  .ic-num:not(.ic-num-target, .ic-loose) {
    animation:
      ic-appear 0.4s ease calc(0.25s + var(--o) * 0.05s) both,
      ic-move 0.7s cubic-bezier(0.6, 0, 0.2, 1) calc(1s + var(--i) * 0.07s) both,
      ic-dim 0.3s ease 2.3s forwards;
  }

  @keyframes ic-dim {
    to {
      opacity: 0.2;
    }
  }

  /* A barra Dados acende no clique: uma moldura lima por cima, que aparece */
  .ic-hl {
    fill: color-mix(in srgb, var(--color-accent) 16%, transparent);
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
    animation: intro-select 0.3s ease 2.3s forwards;
  }

  .ic-target .ic-area {
    fill: var(--color-accent);
  }

  /* O cursor entra pela direita e embaixo, chega ao meio da barra, aperta e solta */
  .ic-cursor {
    fill: var(--color-heading);
    stroke: var(--color-bg);
    stroke-width: 1;
    stroke-linejoin: round;
    transform-box: fill-box;
    transform-origin: 0 0;
    animation:
      ic-appear 0.25s ease 1.7s both,
      ic-cursor-in 0.5s cubic-bezier(0.3, 0, 0.2, 1) 1.7s both,
      ic-press 0.18s ease 2.22s;
  }

  @keyframes ic-cursor-in {
    from {
      transform: translate(70px, 55px);
    }
  }

  @keyframes ic-press {
    50% {
      transform: scale(0.82);
    }
  }

  /* A onda do clique: um anel lima que abre e some */
  .ic-click {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: ic-ripple 0.55s ease-out 2.3s;
  }

  @keyframes ic-ripple {
    from {
      opacity: 1;
      transform: scale(0.3);
    }
    to {
      opacity: 0;
      transform: scale(2);
    }
  }

  /* 3. A lista filtrada */
  /* A segunda parte da abertura troca o lima pelo azul: lima (gráfico) → azul (lista) → lima (capa) */
  .intro-data {
    --color-accent: var(--color-link);
    animation: intro-data 0.45s ease 2.9s both;
  }

  @keyframes intro-data {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .intro-data :global(b) {
    font-weight: 500;
    color: var(--color-accent);
  }

  .intro-data :global(i) {
    font-style: normal;
    color: var(--color-heading);
  }

  /* Linhas dos outros: o filtro risca, apaga e recolhe */
  .ir-row {
    position: relative;
    display: grid;
    grid-template-rows: 1fr;
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in srgb, var(--color-fg) 60%, transparent);
    animation: ir-row-out 0.6s cubic-bezier(0.6, 0, 0.2, 1) var(--d) forwards;
  }

  .ir-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: ir-strike 0.25s ease var(--d) forwards;
  }

  .ir-row-in {
    display: flex;
    min-height: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.4rem;
  }

  @keyframes ir-strike {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes ir-row-out {
    0%,
    35% {
      opacity: 1;
      grid-template-rows: 1fr;
    }
    100% {
      opacity: 0;
      grid-template-rows: 0fr;
    }
  }

  /* A sua linha: o nome grande, que acende e fica selecionado quando sobra só ele */
  .ir-me {
    position: relative;
    display: flex;
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.6rem;
  }

  .ir-me::before {
    content: '';
    position: absolute;
    inset: -1px -0.5rem;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: intro-select 0.4s ease 4s forwards;
  }

  .ir-me-name {
    font-size: clamp(1.6rem, 6.5vw, 2.6rem);
    line-height: 0.9;
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    opacity: 0.55;
    animation: intro-select 0.4s ease 4s forwards;
  }

  @keyframes intro-select {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Abertura: depois de uns 4,5 segundos (ou no primeiro clique, toque, rolagem ou tecla) a tela sobe,
  // revelando a capa, e o nome entra. Lanterna: só a região debaixo do mouse muda de cor.
  let controller: AbortController | undefined;

  const runIntro = (signal: AbortSignal) => {
    const root = document.documentElement;
    if (!root.classList.contains('show-intro')) return;
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!intro) return root.classList.remove('show-intro', 'intro-pending');

    const skip = new AbortController();
    let done = false;
    const leave = () => {
      if (done) return;
      done = true;
      skip.abort();
      clearTimeout(timer);
      intro.classList.add('is-leaving');
      setTimeout(() => root.classList.remove('intro-pending'), 350);
      setTimeout(() => root.classList.remove('show-intro'), 800); // fim da subida (0,75 s)
    };
    const timer = setTimeout(leave, 4500);
    signal.addEventListener('abort', leave);
    for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
      window.addEventListener(type, leave, { passive: true, signal: skip.signal });
    }
  };

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const hero = document.getElementById('inicio');
    if (!hero) return;

    runIntro(signal);

    hero.querySelectorAll<HTMLElement>('[data-fill]').forEach((el) => {
      el.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--fx', `${e.clientX - r.left}px`);
          el.style.setProperty('--fy', `${e.clientY - r.top}px`);
          el.classList.add('is-lit');
        },
        { signal },
      );
      el.addEventListener('pointerleave', () => el.classList.remove('is-lit'), { signal });
    });
  });
</script>
