---
import { Image } from 'astro:assets';
import foto from '../assets/gabriel-recorte.png';
import Letras from './Letras.astro';
import { idiomaDe, textos } from '../i18n';

const tx = textos[idiomaDe(Astro.url)].capa;
---

<!-- Antes de pintar: esconde os blocos da capa para eles entrarem (capa-carregando) e liga o movimento da rolagem
     (capa-movimento). "na-capa" esconde o Contato da barra de cima enquanto a capa está na tela (ela já tem o seu
     botão). Quem pediu menos movimento vê a capa pronta e parada. -->
<script is:inline>
  (function () {
    try {
      document.documentElement.classList.add('na-capa');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('capa-carregando', 'capa-movimento');
    } catch (e) {}
  })();
</script>

<!-- A capa: você no centro, em preto e branco, num fundo cinza de estúdio. O nome completo, em negrito e em escada
     (Gabriel / Navarro / Germano), emoldura você e passa NA FRENTE da foto, mudando de cor onde cruza a camisa.
     Ao rolar, cada camada anda numa velocidade (parallax): o nome sobe mais rápido e esmaece, você acompanha a
     página; o fio nasce no centro e a seção seguinte entra esmaecida e ganha nitidez.
     Com movimento reduzido ou sem JS, é um bloco normal, parado. -->
<section id="inicio" data-capa class="relative isolate">
  <div class="capa-conteudo">
    <div class="cena">
      <!-- O nome: entra letra por letra e passa na frente da foto, em escada (Gabriel à esquerda, Navarro à
           direita, Germano à esquerda), igual no computador e no celular.
           data-vel: a velocidade na rolagem (positiva = sobe mais rápido que a página) -->
      <h1 class="capa-nome" data-vel="0.45" style="--vel: 0.45" data-some>
        <span class="sr-only">{tx.nomeSr}</span>
        <span class="nome-escada" aria-hidden="true">
          <span class="nome-1 hero-name-line"><Letras texto="Gabriel" atraso={0.35} /></span>
          <span class="nome-2 hero-name-line"><Letras texto="Navarro" atraso={0.5} /></span>
          <span class="nome-3 hero-name-line"><Letras texto="Germano" atraso={0.65} /></span>
        </span>
      </h1>

      <!-- Você, recortado, em preto e branco, saindo da borda de baixo. Anda junto com a página (sem data-vel):
           mais devagar, a base da foto seria cortada quando a capa termina -->
      <div class="retrato">
        <figure class="retrato-moldura">
          <Image
            src={foto}
            alt={tx.foto}
            widths={[480, 928]}
            sizes="(min-width: 56rem) 40rem, 22rem"
            format="webp"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="retrato-foto"
          />
        </figure>
      </div>
    </div>

    <!-- Só o essencial: o que eu faço e onde, e o contato (o resto fica na seção Contato) -->
    <div class="capa-info" data-vel="0.3" style="--vel: 0.3" data-some data-so-largo>
      <p class="capa-funcao hero-load" style="--k: 1">{tx.funcao}</p>
      <a href="#contato" class="capa-cta hero-load" style="--k: 2">{tx.contato}</a>
    </div>

    <!-- O fio: nasce no centro enquanto a capa sai e continua nas seções (lib/fio.ts) -->
    <span data-fio-capa class="fio-capa" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* ---------- A capa ---------- */
  /* Cabe sempre na altura da tela. O fundo é pintado aqui (e não só na página) porque o nome inverte de cor
     sobre ele e sobre a foto (mix-blend-mode precisa do fundo dentro do mesmo grupo, o isolation). */
  .capa-conteudo {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    padding-top: 5.5rem; /* a barra de cima */
    background: var(--color-bg);
  }

  /* O estúdio, só com degradês, igual no computador e no celular (nada de imagem, para não pesar):
     1) a softbox: uma luz forte atrás da cabeça e dos ombros, caindo para as bordas;
     2) os cantos um pouco mais escuros, como numa foto de estúdio;
     3) o fundo infinito: a parede clara se curva e vira o chão, alguns tons mais escuro, na altura dos joelhos.
        Embaixo, sob a função e o botão, volta ao cinza do site, para a capa não terminar numa faixa reta. */
  .capa-conteudo::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 72% 40% at 50% 38%, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0) 72%),
      radial-gradient(ellipse 85% 70% at 50% 42%, rgb(20 25 55 / 0) 50%, rgb(20 25 55 / 0.17) 100%),
      linear-gradient(
        to bottom,
        rgb(20 25 55 / 0.08) 0%,
        rgb(20 25 55 / 0) 30%,
        rgb(20 25 55 / 0) 56%,
        rgb(20 25 55 / 0.08) 65%,
        rgb(20 25 55 / 0.18) 76%,
        rgb(20 25 55 / 0.15) 86%,
        rgb(20 25 55 / 0) 100%
      );
    /* tudo se dissolve no cinza do site no pé da capa: sem emenda com a seção seguinte */
    mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
  }

  .cena {
    position: relative;
    min-height: 0;
  }

  /* O nome: sem serifa, em negrito e minúsculas, com as letras apertadas. Fica NA FRENTE da foto e inverte de cor:
     azul-marinho sobre o fundo, creme claro sobre a camisa preta. Com "difference", a cor final é |fundo − cor|;
     --color-nome-inverso é o fundo menos o azul-marinho (global.css), então sobre o cinza sai o azul-marinho do site. */
  .capa-nome {
    position: absolute;
    z-index: 3;
    inset: 0;
    margin: 0;
    font-family: var(--font-grotesk);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--color-nome-inverso);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* A escada: cada linha começa um degrau (--degrau, em em) à direita da de cima, e o bloco inteiro fica
     centralizado no eixo da foto. Como o bloco tem a largura do próprio texto e o degrau é medido na letra, a
     escada é a mesma no computador e no celular; só a escala muda. --topo (a altura) fica nas regras de cada tela. */
  .nome-escada {
    --degrau: 1.25em;
    position: absolute;
    top: var(--topo);
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nome-1,
  .nome-2,
  .nome-3 {
    white-space: nowrap;
  }

  /* as linhas descem 0.9em: a folga de cima e de baixo do .hero-name-line (0.16em) volta com a margem negativa */
  .nome-escada .nome-2 {
    margin-top: -0.16em;
    margin-left: calc(var(--degrau) - 0.1em);
  }

  .nome-escada .nome-3 {
    margin-top: -0.16em;
    margin-left: calc(var(--degrau) * 2 - 0.1em);
  }

  /* a linha esconde as letras enquanto elas sobem (componente Letras). Folgas: embaixo para a perna do "g", e
     dos lados porque, com as letras apertadas, a curva do "o" passa um pouco da caixa e seria cortada */
  .hero-name-line {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.1em 0.12em;
    margin-inline: -0.1em;
  }

  /* Você: o recorte inteiro, sem moldura, saindo da borda de baixo da cena */
  .retrato {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    aspect-ratio: 928 / 1140; /* a proporção da foto recortada */
  }

  /* a base da foto se dissolve no fundo: quando a capa sai, ela não termina num corte reto */
  .retrato-moldura {
    position: absolute;
    inset: 0;
    margin: 0;
    mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  }

  .retrato-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    filter: grayscale(1) contrast(1.06);
  }

  /* Embaixo: a função e o botão */
  .capa-info {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .capa-funcao {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  /* reto, sem arredondar, no espírito editorial da capa */
  .capa-cta {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    background: var(--color-navy);
    color: #fff;
    font-weight: 700;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .capa-cta:hover {
    background: var(--color-latao);
    color: var(--color-navy);
  }

  /* O fio da capa: só com movimento. Nasce do meio da tela para baixo enquanto a capa sai (script abaixo) */
  .fio-capa {
    display: none;
  }

  :global(html.capa-movimento) .fio-capa {
    display: block;
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 58%;
    bottom: 0;
    width: 1.5px;
    margin-left: -0.75px;
    background: var(--color-fio);
    transform: scaleY(0);
    transform-origin: top;
  }

  /* no celular o fio da capa não aparece: as seções não têm o fio no centro, e ele passaria pelo nome */
  @media (max-width: 55.99rem) {
    :global(html.capa-movimento) .fio-capa {
      display: none;
    }
  }

  /* ---------- Celular ----------
     Você inteiro, centralizado, sobre o chão de estúdio, com "Gabriel / Navarro / Germano" em escada na frente do
     peito (mudando de cor sobre a camisa).
     --p: a altura da foto (no máximo a da cena). O nome se mede a partir do topo da foto, para acompanhá-la. */
  @media (max-width: 55.99rem) {
    .capa-conteudo {
      grid-template-rows: minmax(0, 1fr) auto;
      padding-top: 5.25rem;
    }

    .cena {
      --p: min(100%, 124vw);
    }

    /* o nome na frente da foto, sobre o peito, mudando de cor sobre a camisa (como no computador), em escada.
       Medido a partir do topo da foto (100% - --p). */
    /* a escada inteira mede 6.52em de largura (medido no navegador): a letra é a maior que cabe entre as margens
       de 1.25rem. Se o degrau ou o nome mudarem, meça de novo. */
    .capa-nome {
      --topo: calc(100% - var(--p) * 0.68);
      font-size: min(calc((100vw - 2.5rem) / 6.52), 8.5svh);
    }

    /* multiply (só no celular): o branco e o halo claro da borda do recorte assumem o cinza do fundo, e a foto
       passa a ter a mesma luz da página. No computador a foto fica como está. */
    .retrato {
      bottom: -2px; /* entra um pouco atrás do tampo, para não sobrar fresta */
      height: var(--p);
      mix-blend-mode: multiply;
    }

    .retrato-foto {
      filter: grayscale(1) contrast(1.02) brightness(1.04);
    }

    /* sem esfumado: a foto vai nítida até o tampo da bancada, onde ela termina */
    .retrato-moldura {
      mask-image: none;
    }

    /* A bancada de estúdio, na frente de você: o tampo fica na linha onde a foto termina (as mãos apoiadas nele) e
       a frente dela é o fundo da função e do botão. A frente clareia até o cinza do site, sem emenda com a seção
       seguinte. */
    .capa-info {
      position: relative;
      z-index: 3;
      flex-direction: column;
      align-items: stretch;
      gap: 0.875rem;
      padding: 1.5rem 1.25rem max(1.25rem, env(safe-area-inset-bottom));
      background: linear-gradient(to bottom, #d3d3d0, #dcdcd9 45%, var(--color-bg) 100%);
      /* a bancada anda junto com a foto (sem o parallax do computador): se subisse mais rápido, deixaria o corte
         da foto à mostra */
      transform: none !important;
      opacity: 1 !important;
      will-change: auto !important; /* vence o [data-vel] de mais abaixo: no celular ela não precisa de camada própria */
      animation: none !important;
    }

    /* o tampo: uma faixa clara (a luz batendo na borda), com a sombra que você faz sobre ele */
    .capa-info::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 0.75rem;
      background:
        radial-gradient(ellipse 34% 140% at 50% 0%, rgb(20 25 55 / 0.28), rgb(20 25 55 / 0) 70%),
        linear-gradient(to bottom, #f4f4f2, #e2e2df 55%, #cbcbc8);
      box-shadow: 0 1px 0 rgb(20 25 55 / 0.12);
    }

    .capa-funcao {
      font-size: 1rem;
    }

    .capa-cta {
      justify-content: center;
      min-height: 3.25rem;
    }
  }

  /* Computador: a escada começa abaixo do queixo e desce em diagonal pela camisa (sem passar pelo rosto); você no
     meio, ocupando a altura toda; função e botão numa linha, embaixo. */
  @media (min-width: 56rem) {
    .capa-conteudo {
      grid-template-rows: 1fr;
    }

    /* no computador há espaço dos lados: o nome cresce e a escada abre (degraus mais largos) */
    .capa-nome {
      --topo: 30%;
      font-size: min(9vw, 16svh);
    }

    .nome-escada {
      --degrau: 1.9em;
    }

    .retrato {
      height: 100%;
      max-width: 60%;
    }

    .capa-info {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-width: 80rem;
      margin-inline: auto;
      padding: 0 2rem clamp(1.5rem, 6svh, 4rem);
      pointer-events: none;
    }

    .capa-info > * {
      pointer-events: auto;
    }
  }

  /* cada camada que se move vira uma camada própria na placa de vídeo */
  [data-vel] {
    will-change: transform, opacity;
  }

  /* O parallax preso à rolagem pelo próprio navegador (animation-timeline): roda no mesmo lugar da rolagem, sem
     passar pelo JavaScript. Com JS, no celular, a camada chegava sempre um quadro atrasada em relação à página e o
     nome "tremia" ao rolar. Navegadores sem suporte seguem com o script abaixo.
     A capa mede max(100svh, 34rem); a camada anda --vel vezes isso enquanto a capa sai, e [data-some] some em 62,5%
     do caminho (o mesmo 1 - p * 1,6 do script). */
  @supports (animation-timeline: scroll()) {
    /* Só propriedades separadas, sem o atalho `animation`: no build, o minificador fundia o atalho com o
       animation-timeline num `animation: ... scroll(root)`, que o navegador recusa inteiro, e o parallax
       sumia no site no ar (no dev, sem minificar, funcionava). */
    :global(html.capa-movimento) [data-vel] {
      animation-name: capa-parallax;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 max(100svh, 34rem);
    }

    :global(html.capa-movimento) [data-some] {
      animation-name: capa-parallax, capa-some;
    }

    :global(html.capa-movimento) .fio-capa {
      animation-name: capa-fio;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 max(100svh, 34rem);
    }
  }

  @keyframes capa-parallax {
    to {
      transform: translate3d(0, calc(var(--vel) * -1 * max(100svh, 34rem)), 0);
    }
  }

  @keyframes capa-some {
    0% {
      opacity: 1;
    }
    62.5%,
    100% {
      opacity: 0;
    }
  }

  @keyframes capa-fio {
    0%,
    20% {
      transform: scaleY(0);
    }
    90%,
    100% {
      transform: scaleY(1);
    }
  }

  /* ---------- A capa carrega ---------- */
  /* A função e o botão enchem da esquerda para a direita, um depois do outro (--k).
     A folga de 1rem no recorte deixa passar o hover e o contorno de foco. */
  .hero-load {
    clip-path: inset(-1rem -1rem -1rem -1rem);
    transition:
      clip-path 0.75s cubic-bezier(0.65, 0, 0.2, 1) calc(0.6s + var(--k, 0) * 0.12s),
      opacity 0.4s ease calc(0.6s + var(--k, 0) * 0.12s);
  }

  /* Estado antes de carregar (as letras ficam no global.css). Se o script falhar, tudo aparece sozinho em 2,5 s */
  :global(html.capa-carregando) .hero-load {
    clip-path: inset(-1rem 100% -1rem -1rem);
    opacity: 0;
    animation: hero-failsafe 0s 2.5s forwards;
  }

  /* a foto aparece devagar */
  .retrato-moldura {
    transition: opacity 1.2s ease 0.1s;
  }

  :global(html.capa-carregando) .retrato-moldura {
    opacity: 0;
    animation: hero-failsafe 0s 2.5s forwards;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
      clip-path: inset(-1rem -1rem -1rem -1rem);
    }
  }
</style>

<script>
  // Parallax da capa: cada camada [data-vel] anda numa velocidade na rolagem (positiva = sobe mais rápido que a
  // página, negativa = mais devagar) e [data-some] esmaece enquanto a capa sai. O fio da capa nasce no centro, e a
  // primeira seção entra esmaecida e ganha nitidez.
  // Leve de propósito:
  // - só transform e opacity, que a placa de vídeo faz sem redesenhar a página (nada de blur a cada quadro: desfocar
  //   uma seção inteira travava a rolagem, principalmente no celular);
  // - nenhuma medida durante a rolagem: as posições são lidas uma vez (e de novo só quando o tamanho muda), para o
  //   navegador nunca ter que recalcular a página no meio de um quadro;
  // - um quadro por rolagem, só escreve o que mudou, e nada roda com a página parada.
  let controller: AbortController | undefined;

  const faixa = (v: number, a: number, b: number) => Math.min(1, Math.max(0, (v - a) / (b - a)));

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const root = document.documentElement;

    const capa = document.querySelector<HTMLElement>('[data-capa]');
    if (!capa) {
      root.classList.remove('na-capa');
      return;
    }
    // o "na-capa" passa do <html> para o próprio botão: trocar uma classe no <html> recalcula o estilo do site todo
    const navContato = document.querySelector<HTMLElement>('.nav-contato');
    signal.addEventListener('abort', () => navContato?.classList.remove('na-capa'));

    if (root.classList.contains('capa-carregando')) {
      // Dois quadros: garante que o estado escondido foi pintado antes de soltar as transições
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('capa-carregando')));
    }

    const movimento = root.classList.contains('capa-movimento');
    // com animation-timeline, o CSS move as camadas e o fio; o script só cuida do resto
    const peloCss = CSS.supports('animation-timeline: scroll()');
    const camadas = movimento && !peloCss
      ? [...capa.querySelectorAll<HTMLElement>('[data-vel]')].map((el) => ({
          el,
          vel: Number(el.dataset.vel),
          some: el.hasAttribute('data-some'),
          soLargo: el.hasAttribute('data-so-largo'),
        }))
      : [];
    // no celular a função e o botão ficam parados (o CSS anula o movimento): nem escreve neles a cada quadro
    const largo = matchMedia('(min-width: 56rem)');
    const fio = movimento && !peloCss ? capa.querySelector<HTMLElement>('[data-fio-capa]') : null;
    const entrada = movimento ? document.querySelector<HTMLElement>('main [data-secao] .secao-largura') : null;

    // as medidas: só aqui, nunca durante a rolagem
    let vh = innerHeight;
    let altura = capa.offsetHeight;
    let topoEntrada = 0;
    const medir = () => {
      vh = innerHeight;
      altura = capa.offsetHeight;
      if (entrada) topoEntrada = entrada.getBoundingClientRect().top + scrollY;
      ultimoP = ultimoK = -1;
      pedir();
    };

    let quadro = 0;
    let ultimoP = -1;
    let ultimoK = -1;
    let naCapa: boolean | undefined;

    const pintar = () => {
      quadro = 0;
      const y = Math.max(0, scrollY);

      // o Contato da barra de cima volta quando os textos da capa saem (ela já tem o seu botão)
      const agora = y < vh * 0.12;
      if (agora !== naCapa) {
        navContato?.classList.toggle('na-capa', (naCapa = agora));
        root.classList.remove('na-capa');
      }

      if (!movimento) return;

      const p = Math.min(1, y / altura);
      if (p !== ultimoP && (p < 1 || ultimoP < 1)) {
        ultimoP = p;
        for (const c of camadas) {
          if (c.soLargo && !largo.matches) continue;
          c.el.style.transform = p ? `translate3d(0, ${(-c.vel * Math.min(y, altura)).toFixed(1)}px, 0)` : '';
          if (c.some) c.el.style.opacity = p ? String(Math.max(0, 1 - p * 1.6)) : '';
        }
        if (fio) fio.style.transform = `scaleY(${faixa(p, 0.2, 0.9).toFixed(3)})`;
      }

      // a seção seguinte: esmaecida ao entrar, nítida quando chega na metade da tela (sem deslocar: o fio mede a
      // posição dela para saber onde terminar)
      if (entrada) {
        const k = 1 - faixa(topoEntrada - y, vh * 0.5, vh * 0.95);
        if (k !== ultimoK) {
          ultimoK = k;
          entrada.style.opacity = k < 1 ? (0.25 + 0.75 * k).toFixed(3) : '';
        }
      }
    };

    const pedir = () => {
      if (!quadro) quadro = requestAnimationFrame(pintar);
    };

    addEventListener('scroll', pedir, { passive: true, signal });
    // só a altura mudou (a barra de endereço do celular sumindo/voltando ao rolar): nada de medir a página no meio
    // da rolagem, a capa usa svh e não muda de tamanho; mudanças reais chegam pelo ResizeObserver
    let largura = innerWidth;
    addEventListener(
      'resize',
      () => {
        if (innerWidth === largura) {
          vh = innerHeight;
          ultimoK = -1;
          pedir();
          return;
        }
        largura = innerWidth;
        medir();
      },
      { signal },
    );
    // a altura da página muda quando as fontes e as imagens chegam: mede de novo
    const ro = new ResizeObserver(medir);
    ro.observe(document.body);
    medir();

    signal.addEventListener('abort', () => {
      ro.disconnect();
      cancelAnimationFrame(quadro);
      for (const c of camadas) c.el.style.transform = c.el.style.opacity = '';
      if (entrada) entrada.style.opacity = '';
    });
  });
</script>
