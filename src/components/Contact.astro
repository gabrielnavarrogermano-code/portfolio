---
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';
import Secao from './Secao.astro';
import { idiomaDe, textos } from '../i18n';

// Contato: o fim do fio. O fio desce até o e-mail, grande e centralizado, e a linha embaixo dele se desenha
// quando o fio chega; clicar copia o e-mail. Embaixo, os outros canais numa linha simples.
const tx = textos[idiomaDe(Astro.url)].contato;
const [usuario, dominio] = site.email.split('@');
const canais = [
  { label: 'LinkedIn', href: site.linkedin, external: true },
  { label: 'GitHub', href: site.github, external: true },
  ...(temCurriculo ? [{ label: tx.curriculo, href: site.curriculo, download: true }] : []),
];
---

<Secao id="contato" titulo={tx.titulo} sub={tx.frase} escura>
  <div class="ct-corpo">
    <button
      type="button"
      class="ct-email"
      data-copy={site.email}
      data-txt-copiado={tx.copiado}
      data-txt-erro={tx.erro}
      data-abre
      data-fio-fim
      aria-label={`${tx.copiarRotulo}: ${site.email}`}
    >
      {usuario}@<wbr />{dominio}
    </button>
    <span class="ct-aviso" aria-live="polite" data-copy-status></span>
    <ul class="ct-canais">
      {
        canais.map((c) => (
          <li>
            <a
              href={c.href}
              class="btn btn-linha"
              {...('external' in c && c.external ? { target: '_blank', rel: 'noopener' } : {})}
              {...('download' in c && c.download ? { download: site.curriculoNome } : {})}
            >
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>

<style>
  .ct-corpo {
    position: relative;
    z-index: 2;
    margin-top: 3rem;
    text-align: center;
  }

  /* O e-mail grande; a linha embaixo é o fim do fio e se desenha do começo ao fim quando ele chega */
  .ct-email {
    position: relative;
    display: inline-block;
    max-width: 100%;
    padding-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    color: var(--color-heading);
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .ct-email::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-fio);
    transform-origin: left;
    transition:
      transform 1s cubic-bezier(0.65, 0, 0.2, 1),
      background-color 0.25s ease;
  }

  :global(html.fio-js) .ct-email:not(:global(.aberto))::after {
    transform: scaleX(0);
  }

  /* O e-mail aparece com a linha, sem subir */
  :global(html.fio-js) .ct-email:not(:global(.aberto)) {
    transform: none;
  }

  .ct-email:hover {
    color: var(--color-accent);
  }

  .ct-email:hover::after {
    background: var(--color-accent);
  }

  .ct-aviso {
    display: block;
    min-height: 1.6rem;
    margin-top: 0.8rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .ct-canais {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }
</style>

<script>
  // Copiar o e-mail: o aviso aparece embaixo por 2 segundos
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!btn || !status) return;
    const controller = new AbortController();
    let timer = 0;

    btn.addEventListener(
      'click',
      async () => {
        clearTimeout(timer);
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          status.textContent = btn.dataset.txtCopiado ?? '';
        } catch {
          status.textContent = btn.dataset.txtErro ?? '';
        }
        timer = window.setTimeout(() => {
          status.textContent = '';
        }, 2000);
      },
      { signal: controller.signal },
    );

    cleanup = () => {
      controller.abort();
      clearTimeout(timer);
    };
  });
</script>
