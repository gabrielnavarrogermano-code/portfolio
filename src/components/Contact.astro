---
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';
import Secao from './Secao.astro';

// ( 0N ) Contato: à esquerda, o convite e o botão que copia o e-mail; no painel, os canais como linhas de uma tabela.
interface Props {
  num: string;
}
const { num } = Astro.props;

const canais = [
  { k: 'E-mail', v: site.email, href: `mailto:${site.email}`, icon: '→' },
  { k: 'LinkedIn', v: site.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com/, '').replace(/\/$/, ''), href: site.linkedin, icon: '↗', external: true },
  { k: 'GitHub', v: site.github.replace(/^https?:\/\/(www\.)?github\.com\//, ''), href: site.github, icon: '↗', external: true },
  ...(temCurriculo ? [{ k: 'Currículo', v: 'PDF', href: site.curriculo, icon: '↓', download: true }] : []),
];
---

<Secao id="contato" num={num} rotulo="Contato" rotuloDir="Disponível" titulo="Vamos conversar?">
  <Fragment slot="negocio">
    <p class="serif-grande">
      Se você tem <b>planilhas soltas</b> e decisões esperando por elas, me conta o
      problema. <em>A gente começa pela pergunta.</em>
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
      <button type="button" data-copy={site.email} class="btn btn-cheio cursor-pointer" aria-describedby="ct-status">
        <span data-copy-label>Copiar e-mail</span> <span class="seta" aria-hidden="true">→</span>
      </button>
      <p id="ct-status" class="font-mono text-[11px] tracking-[0.15em] text-muted uppercase" aria-live="polite" data-copy-status></p>
    </div>
  </Fragment>

  <ul slot="dados" class="ct-canais">
    {
      canais.map((c) => (
        <li>
          <a
            href={c.href}
            {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
            {...(c.download ? { download: site.curriculoNome } : {})}
          >
            <span class="ct-k">{c.k}</span>
            <span class="ct-v">{c.v.includes('@') ? <>{c.v.split('@')[0]}@<wbr />{c.v.split('@')[1]}</> : c.v}</span>
            <span class="ct-s" aria-hidden="true">{c.icon}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Secao>

<style>
  .ct-canais {
    list-style: none;
    padding: 0;
  }

  .ct-canais li + li {
    border-top: 1px solid var(--color-line);
  }

  .ct-canais a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0.25rem;
    border-radius: 0.6rem;
    transition:
      background-color 0.25s ease,
      padding 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ct-canais a:hover,
  .ct-canais a:focus-visible {
    background: rgb(20 25 55 / 0.05);
    padding-left: 0.75rem;
  }

  .ct-k {
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ct-v {
    overflow-wrap: break-word;
    color: var(--color-heading);
  }

  .ct-s {
    color: var(--color-astro);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .ct-canais a:hover .ct-s {
    transform: translateX(3px);
    color: var(--color-heading);
  }

  @media (max-width: 30rem) {
    .ct-canais a {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .ct-k {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Copiar o e-mail: o botão avisa por 2 segundos e volta
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
    const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!btn || !label || !status) return;
    const controller = new AbortController();
    let timer = 0;

    btn.addEventListener(
      'click',
      async () => {
        clearTimeout(timer);
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          label.textContent = 'Copiado ✓';
          status.textContent = '';
        } catch {
          status.textContent = 'Não deu para copiar: use o e-mail ao lado';
        }
        timer = window.setTimeout(() => {
          label.textContent = 'Copiar e-mail';
          status.textContent = '';
        }, 2000);
      },
      { signal: controller.signal },
    );

    cleanup = () => {
      controller.abort();
      clearTimeout(timer);
    };
  });
</script>
