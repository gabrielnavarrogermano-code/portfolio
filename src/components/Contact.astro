---
import { site } from '../data/site';
import { temCurriculo } from '../lib/curriculo';
---

<section id="contato" class="render-later mx-auto max-w-5xl px-6 pb-16 [contain-intrinsic-size:auto_550px] sm:pb-24">
  <div
    data-reveal
    class="on-light relative overflow-hidden rounded-3xl bg-bg px-6 py-16 text-center sm:px-16"
  >
    <div class="relative">
      <h2 class="mx-auto max-w-xl text-3xl font-semibold tracking-tight text-heading sm:text-5xl">
        Vamos construir algo juntos?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-lg text-muted">
        Estou procurando um estágio ou uma vaga júnior em dados. Se você tem uma oportunidade ou só quer trocar uma
        ideia, me chama.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="group inline-flex items-center gap-2 rounded-full bg-heading px-6 py-3 font-medium text-bg transition hover:bg-heading/80"
        >
          Enviar e-mail
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <button
          id="copy-email"
          data-email={site.email}
          class="inline-flex cursor-pointer items-center rounded-full border border-line px-6 py-3 text-sm text-fg transition hover:border-heading/40 hover:text-heading"
        >
          {site.email}
        </button>
        {
          temCurriculo && (
            <a
              href={site.curriculo}
              download="Curriculo-Gabriel-Navarro-Germano.pdf"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm text-fg transition hover:border-heading/40 hover:text-heading"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Baixar currículo
            </a>
          )
        }
      </div>

      <div class="mt-5 flex justify-center gap-6 text-sm">
        <a href={site.linkedin} target="_blank" rel="noopener" class="py-3 text-muted transition hover:text-heading">
          LinkedIn ↗
        </a>
        <a href={site.github} target="_blank" rel="noopener" class="py-3 text-muted transition hover:text-heading">
          GitHub ↗
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('copy-email');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        btn.textContent = 'E-mail copiado ✓';
      } catch {
        btn.textContent = email;
      }
      setTimeout(() => (btn.textContent = email), 2000);
    });
  });
</script>
